      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20554764.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"W tym czasie czytał już książki.\"\n",
