      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20554763.wav\",\n",
      "    \"duration\": 2.664,\n",
      "    \"text\": \"Zaczerwienili się.\"\n",
