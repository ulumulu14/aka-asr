   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24005493.wav\",\n",
      "    \"duration\": 6.84,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605240.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Gdzież tu powód do wyrzutów?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605185.wav\",\n",
      "    \"duration\": 7.584,\n",
      "    \"text\": \"Lubię go.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633386.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"— To mi nie pomaga.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24105374.wav\",\n",
      "    \"duration\": 8.028,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603604.wav\",\n",
      "    \"duration\": 7.536,\n",
      "    \"text\": \"Wciąż ludzie wysiadają przed zamkiem, z miasta, z Pragi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774047.wav\",\n",
      "    \"duration\": 4.08,\n",
      "    \"text\": \"Ale on wcale inaczej nie myślał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39880035.wav\",\n",
      "    \"duration\": 9.72,\n",
      "    \"text\": \"Kiedy studiowałem prawo europejskie, zakres uprawnień w zakresie współdecydowania był zupełnie inny niż dziś\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603955.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"A ten przyrząd do czego służy?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28085422.wav\",\n",
      "    \"duration\": 6.3,\n",
      "    \"text\": \"Niemniej jednak wymiana handlowa z Chinami istnieje, a nawet się rozwija\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603513.wav\",\n",
      "    \"duration\": 8.496,\n",
      "    \"text\": \"Na jutrzejszym kolokwium będzie pięć pytań otwartych i test wielokrotnego wyboru.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606017.wav\",\n",
      "    \"duration\": 5.208,\n",
      "    \"text\": \"Polata, jak one, na skrzydłach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23856601.wav\",\n",
      "    \"duration\": 10.344,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23828927.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605486.wav\",\n",
      "    \"duration\": 2.424,\n",
      "    \"text\": \"— Co to za człowiek?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41104540.wav\",\n",
      "    \"duration\": 9.756,\n",
      "    \"text\": \"Jednak na mocy przepisów europejskich podawanie tych cennych informacji na oznakowaniach jest zabronione\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606536.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Zycie przechodzi nam ponad głowami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603751.wav\",\n",
      "    \"duration\": 8.4,\n",
      "    \"text\": \"Miała ona lat dziewięćdziesiąt jeden, to znaczy trzynaście razy po siedem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41651589.wav\",\n",
      "    \"duration\": 7.668,\n",
      "    \"text\": \"Inne kraje mają ustawodawstwo, ale nie zostało ono wdrożone, lub nie jest przestrzegane\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622503.wav\",\n",
      "    \"duration\": 3.72,\n",
      "    \"text\": \"— Klęknę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605914.wav\",\n",
      "    \"duration\": 6.744,\n",
      "    \"text\": \"Niestety stosunki meksykańskie utrudniają bardzo dostanie prawdziwego preparatu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41570312.wav\",\n",
      "    \"duration\": 8.1,\n",
      "    \"text\": \"Niech-że mnie Bóg pokarze, jeśli ja was starego i chorego tu opuszczę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615742.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"— Chcę stąd iść — powiedziała Ewa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22947677.wav\",\n",
      "    \"duration\": 6.384,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605372.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Wyglądał jak zawsze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23840821.wav\",\n",
      "    \"duration\": 7.944,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40797367.wav\",\n",
      "    \"duration\": 7.668,\n",
      "    \"text\": \"Jeden kryzys nie powinien przesłaniać innego\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24865959.wav\",\n",
      "    \"duration\": 5.22,\n",
      "    \"text\": \"Czy dobrze słyszę?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23694146.wav\",\n",
      "    \"duration\": 8.424,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605612.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"— Chodź — zawołał do Ewy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605990.wav\",\n",
      "    \"duration\": 8.64,\n",
      "    \"text\": \"Zgadzam się na to, że jesteśmy pokraczni — rzekł tymczasem zatrwożony nieco Podlasiak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23976940.wav\",\n",
      "    \"duration\": 6.432,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23785926.wav\",\n",
      "    \"duration\": 4.848,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604060.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Lekarz zasępił się!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605972.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Wtedy właśnie zaprzyjaźniła się z kuzynką Joanną, starszą o siedem lat.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605275.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Chyba poszli grać w piłkę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608959.wav\",\n",
      "    \"duration\": 8.376,\n",
      "    \"text\": \"Duszno! — pochwyciła pośpiesznie dziwożona.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603976.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Czy naprawdę jestem nieśmiertelna?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605913.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Ale w głębi ducha postanowiłem zrezygnować z tego zaszczytu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605927.wav\",\n",
      "    \"duration\": 5.352,\n",
      "    \"text\": \"Kasia stała przy mamie, a mama ją czesała.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603514.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Wysiedliśmy i przekroczywszy bramę opactwa oo. Franciszkanów, weszliśmy w krużganek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24085740.wav\",\n",
      "    \"duration\": 7.488,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604043.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Dziwożona łasa jest na miód i pszczołom go stale wyjada.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603522.wav\",\n",
      "    \"duration\": 9.456,\n",
      "    \"text\": \"Wszystkie inne maszynki, które wypróbowałem, są wobec niego niczym.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626235.wav\",\n",
      "    \"duration\": 4.848,\n",
      "    \"text\": \"Nie kupuj kota w worku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603527.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Obrażała się dziesięć razy na dzień.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20667391.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"Zawahali się chwilę i potem poszli dalej, zostawiając głębokie ślady.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605281.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"To jest na miarę lat siedemdziesiątych.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23854198.wav\",\n",
      "    \"duration\": 6.072,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603628.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Po prostu to nie było ważne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20806604.wav\",\n",
      "    \"duration\": 8.664,\n",
      "    \"text\": \"Do Marysi: — Profesora chyba nie ma w Sylwestra.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22628276.wav\",\n",
      "    \"duration\": 2.978,\n",
      "    \"text\": \"osiem\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603987.wav\",\n",
      "    \"duration\": 6.384,\n",
      "    \"text\": \"Ty to rozumiesz, przyjacielu „Mostowy”, i zrobisz, jak ja proszę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23677778.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625652.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Lepiej sprawdź to w słowniku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24005274.wav\",\n",
      "    \"duration\": 7.236,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605456.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Ona, która go zrozumiała zbyt wąsko: — Ooo, tak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605237.wav\",\n",
      "    \"duration\": 6.744,\n",
      "    \"text\": \"Podlasiak nie zaprzeczył.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605910.wav\",\n",
      "    \"duration\": 6.984,\n",
      "    \"text\": \"Jednoręki przybiegł pośpiesznie, jakby się bał karygodnego w danym razie opóźnienia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23756053.wav\",\n",
      "    \"duration\": 4.571,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604512.wav\",\n",
      "    \"duration\": 8.544,\n",
      "    \"text\": \"Wyciągnięta odruchem ręka chciała wstrzymać wroga, lecz spętana opadła z powrotem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608886.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"Odmy w prawym płucu doc.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38708051.wav\",\n",
      "    \"duration\": 8.676,\n",
      "    \"text\": \"Głosowałam za przyjęciem programu przewidującego przyznawanie pomocy finansowej na projekty w dziedzinie energetyki\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23995516.wav\",\n",
      "    \"duration\": 6.452,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23816321.wav\",\n",
      "    \"duration\": 6.648,\n",
      "    \"text\": \"nie wziąłem biletów... Może pan ma notatnik z ołówkiem, panie Wokulski?...\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610966.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Przeszło, minęło — myślmy o chwili obecnej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41068904.wav\",\n",
      "    \"duration\": 4.14,\n",
      "    \"text\": \"Zatem możemy to zrobić, oczywiście, że możemy to zrobić\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603737.wav\",\n",
      "    \"duration\": 2.376,\n",
      "    \"text\": \"Nie poruszył się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27240243.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"Pytanie jest takie, czy Grecja z tego wyjdzie, czy też nie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603769.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Zaczynał odczuwać znużenie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20735976.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Miał zamknięte oczy, widziała długie, drgające rzęsy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28230997.wav\",\n",
      "    \"duration\": 2.592,\n",
      "    \"text\": \"W przypadku przyjęcia tego rozwiązania, udałoby się także obejść rozbieżności zdań pomiędzy głównymi graczami\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20629920.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"— Czy można tą ścierką, to wytrę?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603968.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"— Tak by wyglądało, lecz to sprawy nie wyjaśnia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23776658.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774191.wav\",\n",
      "    \"duration\": 7.536,\n",
      "    \"text\": \"Oświadczam: Ja — się — na tym — nie — znam.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605324.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Wtem w krzakach, tuż obok, niesamowity pisk.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605617.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"To samo tutaj.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605954.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Usiedli przodem do wnętrza koła, na złość.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603742.wav\",\n",
      "    \"duration\": 8.736,\n",
      "    \"text\": \"Wtedy z uczuciem niewypowiedzianej trwogi i zdumienia „poznałem” moją narzeczoną.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23667015.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603745.wav\",\n",
      "    \"duration\": 7.536,\n",
      "    \"text\": \"Uznałem, iż stanowisko to właśnie mi odpowiada.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603515.wav\",\n",
      "    \"duration\": 9.744,\n",
      "    \"text\": \"Po zamknięciu pogadanki zbliżył się do mnie pierwszy i przedstawił się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603717.wav\",\n",
      "    \"duration\": 8.304,\n",
      "    \"text\": \"Zakończywszy zwycięsko czwartą z rzędu partię, pożegnałem się i wyszedłem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604024.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Damian zauważył, że biegnie sam.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23850162.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603652.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"— Czy myśli tu nas trzymać cały rok.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22965634.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603497.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Zdawało się, że rzeczywistości nie ma.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605243.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"— Lecz co to było?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20634403.wav\",\n",
      "    \"duration\": 7.248,\n",
      "    \"text\": \"Słyszę, jak czas przepływa za plecami, jak gdybym leżał nad brzegiem rzeki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23840820.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603566.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Tak niespodzianie, tak znienacka, jak bywa nieraz ze szczęściem lub śmiercią.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606495.wav\",\n",
      "    \"duration\": 8.304,\n",
      "    \"text\": \"Oni tu będą za chwilę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603951.wav\",\n",
      "    \"duration\": 7.944,\n",
      "    \"text\": \"- Hoooo. Jak gwiazdy - uśmiechnął się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603762.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Kocham cię dlatego najprawdopodobniej, bo cierpię z powodu utraconego narcyzmu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604122.wav\",\n",
      "    \"duration\": 6.624,\n",
      "    \"text\": \"Siedząc o zmroku nad stawem i słuchając, jak powiew wiatru wzdycha żałośnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28608268.wav\",\n",
      "    \"duration\": 4.5,\n",
      "    \"text\": \"Głosuję na \\\"nie\\\"\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616535.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"Dni rozłąki jakże gorzkie, jakie złe są!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24062356.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605321.wav\",\n",
      "    \"duration\": 9.024,\n",
      "    \"text\": \"Otworzył drzwi, szedł wolno w piżamie wzdłuż korytarza, wykładanego zielonym linoleum.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605264.wav\",\n",
      "    \"duration\": 8.016,\n",
      "    \"text\": \"Staliśmy oboje na tym maleńkim skrawku ziemi, a wokół nas, wszystko pokryła woda.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31705756.wav\",\n",
      "    \"duration\": 5.868,\n",
      "    \"text\": \"Niepokojąca jest trudność oceny rzeczywistej sytuacji w tych krajach\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20770506.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Przychodzę tu jak człowiek do człowieka w chwili wyjątkowej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605428.wav\",\n",
      "    \"duration\": 5.64,\n",
      "    \"text\": \"Oto urywki tego, co jej odpowiadano z pląsających łodzi rybackich.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603575.wav\",\n",
      "    \"duration\": 3.648,\n",
      "    \"text\": \"— Ale z nim sypiasz, co?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23683801.wav\",\n",
      "    \"duration\": 6.504,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28544809.wav\",\n",
      "    \"duration\": 8.82,\n",
      "    \"text\": \"Umożliwi mu to sprawowanie ściślejszego nadzoru nad działaniami agencji ratingowych w całej Unii\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605724.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"I to jest to wspaniałe dzieło o którym mówiłaś?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603691.wav\",\n",
      "    \"duration\": 8.424,\n",
      "    \"text\": \"Jeśli zaczną dokazywać, nie poniosę wspólnej odpowiedzialności.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20627510.wav\",\n",
      "    \"duration\": 4.032,\n",
      "    \"text\": \"— Ale zapłaciliśmy za to drogo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41826276.wav\",\n",
      "    \"duration\": 7.74,\n",
      "    \"text\": \"Każda z tych metod pozwala na uzyskanie innej perspektywy na organizację i jej otoczenie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614645.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Gdy wziął pocisk do ręki, wydał mu się on strasznie ciężki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623217.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"To była jedyna rzecz, oprócz Ewy, na którą zwrócił uwagę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22782761.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"Dlatego rozkazałem ci, abyś nie brał ze sobą pistoletów.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603772.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"— Odprowadzę cię.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603741.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Macie tupet, żeby się tu pojawiać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23757940.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30691917.wav\",\n",
      "    \"duration\": 7.236,\n",
      "    \"text\": \"Sprawy te są często poruszane w naszych kontaktach z tymi państwami\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603680.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Właściwie nie było mu źle — ale ciasno.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605266.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"— Tak i inne graty!…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23856932.wav\",\n",
      "    \"duration\": 7.224,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23785242.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605516.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"I tak nic nie czuję.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606456.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"Poza saniami biegło trzydziestu ludzi otulonych w filtra.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604260.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"To komiczne, że mama miała siedemnaście lat.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603671.wav\",\n",
      "    \"duration\": 6.84,\n",
      "    \"text\": \"Podlasiaków dwóch znałem, a Żegnajty ani jednego — przypomniał sobie nagle jednoręki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639223.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Postanowiła, że się od niego nie odczepi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23753195.wav\",\n",
      "    \"duration\": 7.445,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630185.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Pan Bóg łaskaw — sypiam jak suseł.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605231.wav\",\n",
      "    \"duration\": 6.6,\n",
      "    \"text\": \"W tym miejscu całuje mnie już ósmy chłopak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603494.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"To był szybki, ale na pewno przemyślany i rozsądny wybór.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24104561.wav\",\n",
      "    \"duration\": 6.156,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606445.wav\",\n",
      "    \"duration\": 6.216,\n",
      "    \"text\": \"Był to w prostej linii dziad Seweryna Baryki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606166.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"— Ot, co wymyślił.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604568.wav\",\n",
      "    \"duration\": 4.728,\n",
      "    \"text\": \"Przyczyna leży zdaje się w wyczerpaniu nerwowym.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603694.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"W nocy miał sen.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603613.wav\",\n",
      "    \"duration\": 6.816,\n",
      "    \"text\": \"— Hm… — chrząknąłem — mieliście się zejść na moście Św. Floriana.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605241.wav\",\n",
      "    \"duration\": 6.048,\n",
      "    \"text\": \"Słyszę! — zawołał Krzysiek zarumieniony z radości.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638465.wav\",\n",
      "    \"duration\": 9.576,\n",
      "    \"text\": \"Dziecka nie wolno przyjmować do pracy zarobkowej przed osiągnięciem odpowiedniego, minimalnego wieku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23749549.wav\",\n",
      "    \"duration\": 8.136,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37353781.wav\",\n",
      "    \"duration\": 8.028,\n",
      "    \"text\": \"Powinna też zachęcać Libijczyków do podjęcia przekształceń w kierunku demokracji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605494.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"A teraz najlepiej zrobisz, jak pójdziesz do łóżka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604370.wav\",\n",
      "    \"duration\": 7.296,\n",
      "    \"text\": \"— Weź, Felku, ten pierścień.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618767.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Jak kamień w wodę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603638.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"— Ojciec nic o tym nie wie jeszcze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603985.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"— No, to idźże jeszcze raz i dobrze poszukaj!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24093737.wav\",\n",
      "    \"duration\": 8.388,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_33498414.wav\",\n",
      "    \"duration\": 5.76,\n",
      "    \"text\": \"Dziedzictwo kulturalne krajów europejskich jest wartością samą w sobie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26609171.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Chciałbym uzyskać wyjaśnienia w tej kwestii\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23764465.wav\",\n",
      "    \"duration\": 6.217,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27502845.wav\",\n",
      "    \"duration\": 5.868,\n",
      "    \"text\": \"Prawa pracowników do informacji i konsultacji to istotne składniki społecznej gospodarki rynkowej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35134213.wav\",\n",
      "    \"duration\": 4.248,\n",
      "    \"text\": \"Musimy wybrać między rynkiem a polityką społeczną\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23757202.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27348911.wav\",\n",
      "    \"duration\": 7.236,\n",
      "    \"text\": \"Jego reakcja była bardziej zdecydowana niż poprzedniego prezydenta, ale to nadal tylko słowa\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24224913.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"jęknął Rzecki, zrywając się z łóżka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23853748.wav\",\n",
      "    \"duration\": 4.776,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32077476.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"Rząd w Hanoi jednostronnie dysponuje mieniem kościoła wbrew wcześniejszym umowom\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605286.wav\",\n",
      "    \"duration\": 7.896,\n",
      "    \"text\": \"Dziecka nie wolno w żadnym razie zmuszać ani upoważniać do wykonywania jakiegokolwiek zawodu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603842.wav\",\n",
      "    \"duration\": 6.384,\n",
      "    \"text\": \"— No tak, teraz pójdę, minęła już dziesiąta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605238.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Chcę tylko powiedzieć, że przeżyliśmy wiele okrutnych dni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24058914.wav\",\n",
      "    \"duration\": 7.992,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603733.wav\",\n",
      "    \"duration\": 6.912,\n",
      "    \"text\": \"Czekam, aż obrazy podniosą się przede mną, jak przed zaklinaczem wężę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23852179.wav\",\n",
      "    \"duration\": 5.146,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603677.wav\",\n",
      "    \"duration\": 5.592,\n",
      "    \"text\": \"Cezary już nic nie widział.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605597.wav\",\n",
      "    \"duration\": 10.416,\n",
      "    \"text\": \"Zaszedł tedy do starego sklepikarza na Starym mieście.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23579454.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Mnie to interesuje.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22979459.wav\",\n",
      "    \"duration\": 6.072,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28403714.wav\",\n",
      "    \"duration\": 5.868,\n",
      "    \"text\": \"Przyjęcie dokumentu przez aklamację ma specjalny wydźwięk\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24753493.wav\",\n",
      "    \"duration\": 7.164,\n",
      "    \"text\": \"Blanka zaś była przy krosnach i pracowała nad krzyżową robotą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23999996.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22955794.wav\",\n",
      "    \"duration\": 9.288,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23672530.wav\",\n",
      "    \"duration\": 5.88,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604025.wav\",\n",
      "    \"duration\": 5.16,\n",
      "    \"text\": \"— To ty pomóż mnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23681908.wav\",\n",
      "    \"duration\": 9.624,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637774.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Zależało jej na tym, aby była czysto ubrana.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23759661.wav\",\n",
      "    \"duration\": 5.878,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605936.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"— Mnie się wydaje, że ona wyjechała.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603593.wav\",\n",
      "    \"duration\": 5.328,\n",
      "    \"text\": \"Skłoniła głowę na znak zgody.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626243.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Łaska pańska na pstrym koniu jeździ.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603720.wav\",\n",
      "    \"duration\": 8.736,\n",
      "    \"text\": \"Kocham cię dlatego najprawdopodobniej, bo cierpię z powodu utraconego narcyzmu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603846.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Szło im trudno.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603817.wav\",\n",
      "    \"duration\": 7.464,\n",
      "    \"text\": \"Będziesz ze mną teraz rozmawiał czy też wolisz rozmyślać za kratami?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23913589.wav\",\n",
      "    \"duration\": 4.284,\n",
      "    \"text\": \"nie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30174868.wav\",\n",
      "    \"duration\": 8.028,\n",
      "    \"text\": \"Zasada ta, podobnie jak inne zasady, stoi na straży należytego zarządzania finansami Unii\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23747240.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24010783.wav\",\n",
      "    \"duration\": 5.436,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22968539.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603502.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Słowo daję, przynajmniej dobrze, żem ciebie spotkał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606014.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"Nie sprawiało to jednak żadnego uszczerbku w moim zapale.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605288.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Nie mówiąc już o rozkoszy, którą mi to daje.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603724.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"Przez te dwa lata mnie tu w tych stronach nie było…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603710.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Wielki Pisarz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41655577.wav\",\n",
      "    \"duration\": 7.452,\n",
      "    \"text\": \"W procesie selekcji nie zastosowano żadnych kryteriów dotyczących wiedzy specjalistycznej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621608.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"To nie tylko wartości naszej firmy, ale i nasze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614953.wav\",\n",
      "    \"duration\": 2.712,\n",
      "    \"text\": \"Głupio się stało!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23684266.wav\",\n",
      "    \"duration\": 7.992,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23757850.wav\",\n",
      "    \"duration\": 7.176,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612277.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"— Łżesz jak pies.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612281.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"— Naturalnie, że zapłaci — odpowiedział tymczasem ojciec nie znoszącym wątpliwości tonem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639083.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Więc nie wiadomo, czym jest naprawdę: parą, wodą czy lodem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639084.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Usiedli przodem do wnętrza koła, na złość.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20735855.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Zdumiewało go jej wyrafinowanie erotyczne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20735856.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Jedne człowieczki mówią tak, drugie inaczej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20644896.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Tego spotkania, po którym nie mogła już od niego odejść.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20644922.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Potem listy, listy, listy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35068198.wav\",\n",
      "    \"duration\": 9.072,\n",
      "    \"text\": \"Dlatego też głosowałam przeciwko przyjęciu sprawozdania\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35068199.wav\",\n",
      "    \"duration\": 5.436,\n",
      "    \"text\": \"Trudno zmienić mentalność\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28316822.wav\",\n",
      "    \"duration\": 8.352,\n",
      "    \"text\": \"Nie wiemy, co zrobić z odpadami nuklearnymi w ramach tego przedsięwzięcia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28316825.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Katastrofa statku New Flame i jej skutki dla Zatoki Algeciras\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603695.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Nie pomyślą, że człowiekowi przykro i boi się, że panią rozgniewają.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605216.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Lubię spać przy otwartym oknie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20879130.wav\",\n",
      "    \"duration\": 4.68,\n",
      "    \"text\": \"Przecież nie będą was szukali nad brzegiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20879143.wav\",\n",
      "    \"duration\": 4.512,\n",
      "    \"text\": \"Więc nareszcie Warszawa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604236.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"I właśnie tego cudu zaniedbało się obejrzeć!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604238.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"— Ja także — nalegał dalej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616530.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Nie myśl, że zgubię się w innych.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616560.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"Bona biła go za to bardzo, ale to nie pomagało.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603649.wav\",\n",
      "    \"duration\": 5.28,\n",
      "    \"text\": \"Żeby chciała wziąć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604549.wav\",\n",
      "    \"duration\": 3.912,\n",
      "    \"text\": \"Miała piętnaście lat.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605891.wav\",\n",
      "    \"duration\": 4.392,\n",
      "    \"text\": \"U mnie będzie pan całkowicie bezpieczny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605902.wav\",\n",
      "    \"duration\": 4.608,\n",
      "    \"text\": \"Nieważne, na ja kim.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603499.wav\",\n",
      "    \"duration\": 6.84,\n",
      "    \"text\": \"Matka robi mu okłady i ciepłą kąpiel.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603536.wav\",\n",
      "    \"duration\": 5.352,\n",
      "    \"text\": \"I tulił głowę do jej kolan w pokorze uwielbienia…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603509.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"— Więc baron miał poniekąd rację, przychodząc do ciebie ze słowem przebaczenia?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603714.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"Uciekł tylko jeden żołnierz, dwóch leżało z przestrzelonymi głowami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605463.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Bo cóż się właściwie z nami stało?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605478.wav\",\n",
      "    \"duration\": 3.0,\n",
      "    \"text\": \"Było to lekkomyślne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614229.wav\",\n",
      "    \"duration\": 4.992,\n",
      "    \"text\": \"Księżyc wchodził pomału, jak aktor na scenę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614235.wav\",\n",
      "    \"duration\": 4.968,\n",
      "    \"text\": \"Tańczyli, wprawdzie na palcach, po cichutku, lecz do upadłego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618686.wav\",\n",
      "    \"duration\": 6.864,\n",
      "    \"text\": \"Więc łatwo się domyślić, dlaczego właśnie jego wybrano, żeby odprowadził Maciusia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618691.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Podniosła głowę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23740258.wav\",\n",
      "    \"duration\": 5.747,\n",
      "    \"text\": \"Najprzód wyrwał cztery gwoździe, które pozostały i utrzymywały blachę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23740264.wav\",\n",
      "    \"duration\": 6.348,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623332.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Kilka osób rzuciło się nawet w pogoń za zbiegłą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623335.wav\",\n",
      "    \"duration\": 4.872,\n",
      "    \"text\": \"Ze zdziwieniem zauważyła, że w jej domu mieszka dwóch starszych chłopców.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610252.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Muszę zawiązać listy w ceratę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610257.wav\",\n",
      "    \"duration\": 6.216,\n",
      "    \"text\": \"— Rozpusta umysłowa jest potrzebna, aby wyładować irracjonalne części naszego intelektu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605747.wav\",\n",
      "    \"duration\": 4.68,\n",
      "    \"text\": \"— I cóż o tym myślicie, panie kolego?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605922.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Wszedłem na ścieżkę ogrodową.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20658740.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Ona, która go zrozumiała zbyt wąsko: — Ooo, tak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20658741.wav\",\n",
      "    \"duration\": 5.04,\n",
      "    \"text\": \"Po prostu nie miałam z kim pojechać kajakiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35346226.wav\",\n",
      "    \"duration\": 6.156,\n",
      "    \"text\": \"Musimy pamiętać, że pomoc dla niekonkurencyjnych kopalń węgla przeczy tym celom\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35346229.wav\",\n",
      "    \"duration\": 1.08,\n",
      "    \"text\": \"Ona mnie pojmie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_36981481.wav\",\n",
      "    \"duration\": 5.04,\n",
      "    \"text\": \"Mam nadzieję, że zajmie się pan tą sprawą\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_36981482.wav\",\n",
      "    \"duration\": 5.508,\n",
      "    \"text\": \"Jeśli chodzi o kwestię \\\"krótkiej prezentacji\\\", to zgadzam się\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20658764.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Po czym szli zgodnie i umownie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20658765.wav\",\n",
      "    \"duration\": 4.776,\n",
      "    \"text\": \"Ale będzie wiedzieć i myślę, że osiągnie to.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23732793.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23732794.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Najprzód wyrwał cztery gwoździe, które pozostały i utrzymywały blachę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623073.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"Na trzeci dzień Noel zaczął kichać i kaszleć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623080.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"Bliżej ona drapała.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620484.wav\",\n",
      "    \"duration\": 6.288,\n",
      "    \"text\": \"O walce myśleć nawet nie było można.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620485.wav\",\n",
      "    \"duration\": 8.352,\n",
      "    \"text\": \"Dziecko powinno zawsze mieć pierwszeństwo do ochrony i pomocy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20634123.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"Było już zupełnie ciemno, gdy zbliżaliśmy się do budynków stacji.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20634127.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Uparł się i nie chce się przywitać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41694903.wav\",\n",
      "    \"duration\": 5.076,\n",
      "    \"text\": \"Zapewniam, że niektóre państwa członkowskie doznają tu przykrego przebudzenia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41694910.wav\",\n",
      "    \"duration\": 7.524,\n",
      "    \"text\": \"Europejska inicjatywa obywatelska będzie potężnym narzędziem kształtowania polityki Unii Europejskiej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22446265.wav\",\n",
      "    \"duration\": 1.944,\n",
      "    \"text\": \"trzy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22446266.wav\",\n",
      "    \"duration\": 1.704,\n",
      "    \"text\": \"jeden\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613487.wav\",\n",
      "    \"duration\": 2.064,\n",
      "    \"text\": \"Ma to być kara.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613490.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"— Czytałem to przez całą noc!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605789.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"— Zły jestem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605917.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Teraz tatko coś dołożył i kupili rower.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23647315.wav\",\n",
      "    \"duration\": 5.832,\n",
      "    \"text\": \"Pośpieszył do okna i z za firanki śledził ulicę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23647316.wav\",\n",
      "    \"duration\": 8.208,\n",
      "    \"text\": \"Włożyłem kapelusz i przeszedłszy korytarz, zszedłem po schodach na dół.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40815531.wav\",\n",
      "    \"duration\": 9.468,\n",
      "    \"text\": \"Kolejna kwestia dotyczy tego, że są to w pewnym sensie ramy nieobowiązkowe\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40815534.wav\",\n",
      "    \"duration\": 7.596,\n",
      "    \"text\": \"W związku z tym nie ma alternatywy dla dialogu i wzajemnego szacunku\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26547885.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Stanowiska wiążące Komisję przyjmuje wyłącznie kolegium komisarzy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26547886.wav\",\n",
      "    \"duration\": 6.768,\n",
      "    \"text\": \"To dobre wieści zarówno dla Komisji, jak i Parlamentu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606486.wav\",\n",
      "    \"duration\": 3.912,\n",
      "    \"text\": \"— Serce ani drgnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606498.wav\",\n",
      "    \"duration\": 3.792,\n",
      "    \"text\": \"Zapytaliśmy o redaktora.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620374.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"To trudno: nie jestem tak delikatny jak ty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620378.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Do południa — powtórzył — do południa!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603487.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"Mieli czerwone uszy i byli nie bardzo przytomni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603492.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Milcząc, pobiegli we wskazanym kierunku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605212.wav\",\n",
      "    \"duration\": 6.312,\n",
      "    \"text\": \"Ostatecznie zdecydowali się na ślub cywilny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605273.wav\",\n",
      "    \"duration\": 5.088,\n",
      "    \"text\": \"Nie powinno ono być przedmiotem handlu w żadnej formie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21490969.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"Musisz przyjąć za pewnik, że słyszę wszystko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21490970.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Spojrzał na strażników z miną warczącego psa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626611.wav\",\n",
      "    \"duration\": 7.344,\n",
      "    \"text\": \"— Z góry obiecuję spełnić wszystko co do joty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626650.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Wreszcie zobaczyłem jak na dłoni cały klasztor.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20821176.wav\",\n",
      "    \"duration\": 7.104,\n",
      "    \"text\": \"Biały Kieł znał to miejsce, tak jak znały je wszystkie pokolenia dzikich łowców\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20821177.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Otóż wczoraj, gdy mu przyniesiono jadło, dał znak, że spowiednika żąda.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20634710.wav\",\n",
      "    \"duration\": 7.776,\n",
      "    \"text\": \"Właśnie wtedy pociąg, zwolniwszy biegu, wjechał w las.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20634711.wav\",\n",
      "    \"duration\": 7.944,\n",
      "    \"text\": \"To było powiedziane takim tonem, że powinno jej się było wielu rzeczy odechcieć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39581437.wav\",\n",
      "    \"duration\": 3.924,\n",
      "    \"text\": \"Zapoznam państwa z opiniami sprawozdawcy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39581440.wav\",\n",
      "    \"duration\": 3.888,\n",
      "    \"text\": \"Trzęsienie ziemi w regionie Abruzji we Włoszech\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22723315.wav\",\n",
      "    \"duration\": 6.12,\n",
      "    \"text\": \"Pójdziemy do parku, popuszczamy sobie bańki i będzie fajnie!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22723318.wav\",\n",
      "    \"duration\": 3.048,\n",
      "    \"text\": \"Spadaj.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626226.wav\",\n",
      "    \"duration\": 2.544,\n",
      "    \"text\": \"Nieważne, na ja kim.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626229.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"Zamiast „Harcerze podnieśli nosze”, napisane: „Harcerze podnieśli nos”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40855756.wav\",\n",
      "    \"duration\": 3.276,\n",
      "    \"text\": \"Czy nie możemy po prostu głosować?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40855759.wav\",\n",
      "    \"duration\": 4.356,\n",
      "    \"text\": \"Nie mogę udać się stąd prosto do Brukseli\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774151.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Może być woda z kranu?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774152.wav\",\n",
      "    \"duration\": 8.232,\n",
      "    \"text\": \"Nikt nie ma dość rozumu na to, by rzecz właściwą zrobić w odpowiednim czasie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643309.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Mały usiadł.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643310.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Morze i niebo w oddali spajały się z sobą bez śladu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616386.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Nagle odwróciła się i skierowała kroki ku drzwiom.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616389.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Wasze cmentarze muszą mieć wygląd zupełnie odmienny?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20661854.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Chłopak był tak zdziwiony, że zapomniał ją sprać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20661855.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Spojrzała poprzez podwórze ku piekarni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20772378.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Sekund kilka — jak wiek długich.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20772380.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Wyszła w towarzystwie koleżanek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35646751.wav\",\n",
      "    \"duration\": 9.0,\n",
      "    \"text\": \"Oznacza ono zatem jedną z najpoważniejszych barier światowych dla równości płci w społeczeństwie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35646755.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Rada oczekuje, że zajmiemy się tą delikatną i drażliwą kwestią\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27100225.wav\",\n",
      "    \"duration\": 3.276,\n",
      "    \"text\": \"Brakuje nam czasu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27100226.wav\",\n",
      "    \"duration\": 6.156,\n",
      "    \"text\": \"Nie ma wątpliwości, że klimat się zmienia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603500.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"No — gospodarz, właściciel tej zagrody.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603523.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"Zaczął się wielki, żywiołowy strajk krawiecki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20635795.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Już drugi raz uderzyłem małym palcem o framugę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20635797.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"— To tylko fason jej bucików.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41036940.wav\",\n",
      "    \"duration\": 5.076,\n",
      "    \"text\": \"Europa musi także uporać się z przeszłością komunistyczną\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41036946.wav\",\n",
      "    \"duration\": 5.22,\n",
      "    \"text\": \"Pozwólcie, że wyrażę się jasno\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41650487.wav\",\n",
      "    \"duration\": 3.996,\n",
      "    \"text\": \"Jest jeszcze jedna mała zmiana\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41650489.wav\",\n",
      "    \"duration\": 4.212,\n",
      "    \"text\": \"Od lat Somalia jest terenem brutalnych walk\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603784.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Niektórzy zaczęli przeskakiwać przez płot.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603795.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Chodziła namiętnie do kina i nazajutrz miewała takie stany.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23732789.wav\",\n",
      "    \"duration\": 7.176,\n",
      "    \"text\": \"Najprzód wyrwał cztery gwoździe, które pozostały i utrzymywały blachę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23732790.wav\",\n",
      "    \"duration\": 6.384,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623060.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Nie wiem dlaczego tak cię to bawi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623064.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Niech sobie przechodzi jeden dzień po drugim.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40701597.wav\",\n",
      "    \"duration\": 7.452,\n",
      "    \"text\": \"Stanowisko to będzie wyrazem wagi, jaką przywiązuję do badań i innowacji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40701599.wav\",\n",
      "    \"duration\": 7.488,\n",
      "    \"text\": \"Niektóre państwa uciekają się do praktyk protekcjonistycznych, inne zaś starają się liberalizować handel\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27421666.wav\",\n",
      "    \"duration\": 4.212,\n",
      "    \"text\": \"Komunikat Przewodniczącego\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27421669.wav\",\n",
      "    \"duration\": 6.444,\n",
      "    \"text\": \"Z zawodu jestem lekarzem i wiem, jak trudno jest ratować życie ludzkie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606453.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"Co jest?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606481.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Muszę sobie wyrobić nowy paszport.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614780.wav\",\n",
      "    \"duration\": 4.536,\n",
      "    \"text\": \"Kobieta rozejrzała się nerwowo i zmrużyła oczy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614781.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Szczęśliwy człowiek pracuje sprawniej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619756.wav\",\n",
      "    \"duration\": 4.536,\n",
      "    \"text\": \"Ostatnio dużo myślałem nad własnym stanem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619764.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"Zapytaliśmy o redaktora.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41653551.wav\",\n",
      "    \"duration\": 5.472,\n",
      "    \"text\": \"Chciałbym poruszyć jeden bardzo krótki punkt w porządku dziennym\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41653553.wav\",\n",
      "    \"duration\": 5.724,\n",
      "    \"text\": \"Gdybyśmy ich słuchali, Irlandia nie byłaby członkiem Unii Europejskiej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605327.wav\",\n",
      "    \"duration\": 7.104,\n",
      "    \"text\": \"Rzadka ta zupa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605341.wav\",\n",
      "    \"duration\": 8.304,\n",
      "    \"text\": \"Bałam się zawsze, że przyjdą na mnie takie ciężkie chwile…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24738692.wav\",\n",
      "    \"duration\": 2.448,\n",
      "    \"text\": \"Ale nie narzekał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24738694.wav\",\n",
      "    \"duration\": 2.736,\n",
      "    \"text\": \"Sekretarz Czerwonego Krzyża“.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775547.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Dałam się pomacać trochę fotografowi z przeciwka i zdjęcia już są.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775548.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"Żeby iść tak… żeby iść tak… i wciąż iść.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23732797.wav\",\n",
      "    \"duration\": 6.864,\n",
      "    \"text\": \"Najprzód wyrwał cztery gwoździe, które pozostały i utrzymywały blachę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23732798.wav\",\n",
      "    \"duration\": 6.216,\n",
      "    \"text\": \"Ostatnie słowa wymówił syczącym szeptem i ze złośliwym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775715.wav\",\n",
      "    \"duration\": 6.12,\n",
      "    \"text\": \"A jak nie, to on jeden.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775728.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Lepiej nie myśleć o tak błahym zdarzeniu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20624504.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Nie mam nic przeciwko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20624511.wav\",\n",
      "    \"duration\": 2.496,\n",
      "    \"text\": \"Pobaw się z nami!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27228694.wav\",\n",
      "    \"duration\": 4.68,\n",
      "    \"text\": \"Proces negocjacji musi być podtrzymywany\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27228703.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"skąd mamy uzyskać dochód, który pozwoli nam wyjść z kryzysu?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20683148.wav\",\n",
      "    \"duration\": 2.856,\n",
      "    \"text\": \"Jest bardzo słaby.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20683149.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"Nic takiego nie mówiłem!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21873862.wav\",\n",
      "    \"duration\": 4.488,\n",
      "    \"text\": \"Ropucha i gołąbek, oto co mi zawsze przypominają.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21873864.wav\",\n",
      "    \"duration\": 4.968,\n",
      "    \"text\": \"Postacie z głębi obrazu odciągnęły człowieka, czołgającego się po ziemi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648459.wav\",\n",
      "    \"duration\": 4.512,\n",
      "    \"text\": \"Zwłaszcza w warunkach tak dla jej zdrowia nieodpowiednich.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648460.wav\",\n",
      "    \"duration\": 4.992,\n",
      "    \"text\": \"Lecz Damian nie był ani nieśmiały, ani zawstydzony.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603959.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Podobała mu się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603966.wav\",\n",
      "    \"duration\": 2.664,\n",
      "    \"text\": \"Była druga w nocy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605471.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Ewa wyjdzie ze szkoły.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605482.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Skąd się tu wzięły skały pierwotne?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622476.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Podchodzi do niego właśnie ten rysownik.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622477.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"— A kiedy ją będę widział? — Za kilka dni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603627.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"Emil płynie powoli po własnych zdaniach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603651.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Obciąć mu ręce i nogi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616540.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Co go wstrzymało?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616545.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"A potem ryk, a potem nic.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617877.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"— Dziękuję i przepraszam za przerwanie toku rozmyślań.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617878.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"Stary jest uroczy i komiczny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618083.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"- Dziś są moje urodziny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618089.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Musiała czuć dotyk rączki wiolonczeli na policzku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613227.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Tak się cieszą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613229.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Maciuś spojrzał smutnemu królowi prosto w oczy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605550.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Czemu tak trzaskasz drzwiami?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605563.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"I zaciągnąwszy się parę razy dymem z papierosa, wrócił do Stachy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606993.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Nikt nie odpowiedział.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607100.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"I wyprowadziłem go przez ogród na ulicę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20703091.wav\",\n",
      "    \"duration\": 2.952,\n",
      "    \"text\": \"— Dobrze ci tutaj?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20703094.wav\",\n",
      "    \"duration\": 6.072,\n",
      "    \"text\": \"Podobno róże miłości najchętniej przyjmują się na grobach…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20629273.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"— Więc czy ja mogę się o coś zapytać? — Możesz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20629275.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Od sprawy Małkowskiego wieża olsztyńskiego ratusza budzi mieszane skojarzenia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605746.wav\",\n",
      "    \"duration\": 2.304,\n",
      "    \"text\": \"Kropka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605757.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"— Czego mamy zazdrościć?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21373327.wav\",\n",
      "    \"duration\": 2.856,\n",
      "    \"text\": \"Czy pan tam był?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21373330.wav\",\n",
      "    \"duration\": 4.848,\n",
      "    \"text\": \"Po powrocie przywitamy was serdecznie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603532.wav\",\n",
      "    \"duration\": 8.136,\n",
      "    \"text\": \"Żebym miał pieniądze, tobym mu mleka kupił.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603759.wav\",\n",
      "    \"duration\": 5.712,\n",
      "    \"text\": \"Kama leżała wciąż w głębokim uśpieniu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623072.wav\",\n",
      "    \"duration\": 2.832,\n",
      "    \"text\": \"Dziwna rzecz, ta Ewa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623083.wav\",\n",
      "    \"duration\": 4.632,\n",
      "    \"text\": \"— On cię bardzo polubił z mojego opowiadania.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_29450894.wav\",\n",
      "    \"duration\": 8.64,\n",
      "    \"text\": \"Pierwsza dotyczy finansów publicznych, a druga konkurencyjności\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_29450897.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Rok ten był również rokiem wejścia w życie traktatu z Lizbony\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23939982.wav\",\n",
      "    \"duration\": 5.4,\n",
      "    \"text\": \"Czyż nie tu stał dom, w którym mieszkałem?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23939984.wav\",\n",
      "    \"duration\": 2.664,\n",
      "    \"text\": \"„Tak jest, pan.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20776834.wav\",\n",
      "    \"duration\": 7.2,\n",
      "    \"text\": \"Stanął pod drzewem, przed oczami miał oświet lony prostokąt: brama.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20776835.wav\",\n",
      "    \"duration\": 6.48,\n",
      "    \"text\": \"Noc przeminęła, burza ukoiła się, woda odpłynęła powoli.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615448.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"My pragniemy pieniędzy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615451.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"— Chcę cię mieć wyłącznie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621157.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"Nie wyobrażam sobie tego inaczej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621159.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Sekretarz wyjął notatnik i ołówek z kieszeni surduta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607503.wav\",\n",
      "    \"duration\": 2.952,\n",
      "    \"text\": \"Ewa odskoczyła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607504.wav\",\n",
      "    \"duration\": 3.0,\n",
      "    \"text\": \"Niby nic się nie zmieniło.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27183951.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Były dwa odrębne głosowania\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27183954.wav\",\n",
      "    \"duration\": 7.02,\n",
      "    \"text\": \"sprawozdawca komisji opiniodawczej Komisji Zatrudnienia i Spraw Socjalnych\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603528.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Przecie przyjemnie się wypróbować albo pokazać, że się nie boję.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603559.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"Był nagi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603588.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Najpierw zauważyłem kolbę karabinu, ukrytego na łóżku pod stosem poduszek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20655874.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"W kącie stało składane łóżko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20655877.wav\",\n",
      "    \"duration\": 2.976,\n",
      "    \"text\": \"Nikt chyba nie zaprzeczy!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20655878.wav\",\n",
      "    \"duration\": 4.776,\n",
      "    \"text\": \"Lecz nie żałuję trudu; wyniki przeszły moje oczekiwania.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626196.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Znowu pochody egipskie i asyryjskie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626198.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Potem zachowywał się całkiem zwyczajnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626203.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"Było też dużo rzeczy do jedzenia, jakbyśmy mieli przez tydzień nie wychodzić z pokoju.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613442.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Były nastawione ku północnemu zachodowi, gdzie jeszcze niebo jaśniało dość pogodnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613443.wav\",\n",
      "    \"duration\": 2.976,\n",
      "    \"text\": \"Ciebie już nie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613445.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Twierdzenie, że w Polsce rządzi burżuazja, nie jest prawdą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630799.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"— Rzeczywiście — odpowiedziała — spotkaliśmy ją oboje niedawno na ulicy w porze wieczornej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630801.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Włączyłem dziesięć przedmiotów.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630805.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"— Serce ani drgnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606126.wav\",\n",
      "    \"duration\": 6.048,\n",
      "    \"text\": \"Było ich dwóch: prawy — kulawiec, a lewy — jednoręki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606128.wav\",\n",
      "    \"duration\": 6.36,\n",
      "    \"text\": \"Wolę zadać standardowe pytania, a potem po prostu słuchać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606135.wav\",\n",
      "    \"duration\": 6.312,\n",
      "    \"text\": \"Widzę wielki gmach z czerwonej cegły, zwrócony do mnie kantem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20663104.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Wreszcie zobaczyłem jak na dłoni cały klasztor.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20663105.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"— Nie szkodzi, zaraz je uspokoję.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20663106.wav\",\n",
      "    \"duration\": 3.888,\n",
      "    \"text\": \"Teraz z tym wszystkim koniec!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41650482.wav\",\n",
      "    \"duration\": 8.604,\n",
      "    \"text\": \"Jest to prawdopodobnie skutek mało zdecydowanej polityki i nadmiernej biurokracji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41650483.wav\",\n",
      "    \"duration\": 7.2,\n",
      "    \"text\": \"W sumie przyznajemy, że turystyka jest jedną z najbardziej obiecujących branży w Europie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41650484.wav\",\n",
      "    \"duration\": 5.796,\n",
      "    \"text\": \"Pod względem ilościowym jest to nowy etap w rozwoju integracji europejskiej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775479.wav\",\n",
      "    \"duration\": 4.776,\n",
      "    \"text\": \"Lepiej nie myśleć o tak błahym zdarzeniu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775483.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"Manna po niemiecku, a Manna tak swobodnie, jak Emil po polsku S.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775486.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Nie ma dymu bez ognia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24280141.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Pochwalony Jezus Chrystus.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24280142.wav\",\n",
      "    \"duration\": 3.168,\n",
      "    \"text\": \"Odbierz ten telefon!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24280143.wav\",\n",
      "    \"duration\": 2.376,\n",
      "    \"text\": \"co za chłód!...\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614899.wav\",\n",
      "    \"duration\": 8.04,\n",
      "    \"text\": \"Nieznajomy ocknął się z zamyślenia i spojrzał nań przytomnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614903.wav\",\n",
      "    \"duration\": 5.52,\n",
      "    \"text\": \"A teraz — ty sam zginiesz, a ja razem z tobą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614912.wav\",\n",
      "    \"duration\": 4.992,\n",
      "    \"text\": \"Do strumienia! — pochwycił jednoręki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604885.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Lecz sługa nie dała zbić się z tropu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604888.wav\",\n",
      "    \"duration\": 6.384,\n",
      "    \"text\": \"Ostatnie minuty przed wschodem słońca to najzimniejszy moment w ciągu doby.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604891.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"— Przecież powiedziałeś, że nie chcesz tam iść.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20660376.wav\",\n",
      "    \"duration\": 5.52,\n",
      "    \"text\": \"— Patrz pan! — przerwała mi, wskazując na prawo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20660381.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Już strasznie znudzili mi się ci mężczyźni z forsą i szykiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20660383.wav\",\n",
      "    \"duration\": 6.192,\n",
      "    \"text\": \"Więc nie wiadomo, czym jest naprawdę: parą, wodą czy lodem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606462.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Dwadzieścia, no, powiedzmy trzydzieści tysięcy!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606472.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Lecz powrócę jeszcze kiedyś w chwały dzień.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606488.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Ładny indyk, nie ma co mówić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613370.wav\",\n",
      "    \"duration\": 3.288,\n",
      "    \"text\": \"Anna ma dwadzieścia cztery.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613373.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Byłby może zasnął, gdyby nie powtórne zjawienie się starego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613374.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Z pomocą swej busoli Filip kontrolował przez godzinę kierunek ich jazdy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686554.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Nie ucieknie! — pocieszał siebie samego jednoręki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686555.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Andrzej uścisnął mi rękę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686574.wav\",\n",
      "    \"duration\": 2.544,\n",
      "    \"text\": \"Ale dla niego nie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621300.wav\",\n",
      "    \"duration\": 4.632,\n",
      "    \"text\": \"Dziewczyna pyta z niedowierzaniem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621302.wav\",\n",
      "    \"duration\": 2.808,\n",
      "    \"text\": \"Gdzie trzymacie mopa?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621305.wav\",\n",
      "    \"duration\": 3.144,\n",
      "    \"text\": \"— Popatrz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20830871.wav\",\n",
      "    \"duration\": 3.768,\n",
      "    \"text\": \"I zadanie źle wypadło.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20830873.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"Ale chłopiec ręką machnął.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20830874.wav\",\n",
      "    \"duration\": 5.328,\n",
      "    \"text\": \"— Ee — mruknął — właściwie nie ma się z czego śmiać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603614.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Nikt nie wie i o to chodzi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603620.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Wczoraj lat sześćdziesiąt — jutro dwadzieścia, nie!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603633.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Nie broniła, milcząc.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39567400.wav\",\n",
      "    \"duration\": 4.32,\n",
      "    \"text\": \"To było naprawdę imponujące wydarzenie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39567402.wav\",\n",
      "    \"duration\": 5.148,\n",
      "    \"text\": \"Konieczne jest forsowanie otwartych i przejrzystych rynków w tym regionie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39567403.wav\",\n",
      "    \"duration\": 3.636,\n",
      "    \"text\": \"W ciepłej izbie wróci.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603986.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Dzieci powitały go radośnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604068.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Publicznie spotykamy się ponownie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604081.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"- Hoooo. Jak gwiazdy - uśmiechnął się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616089.wav\",\n",
      "    \"duration\": 4.392,\n",
      "    \"text\": \"Może to przy innej ulicy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616090.wav\",\n",
      "    \"duration\": 6.072,\n",
      "    \"text\": \"Powiem coś, co mam do powiedzenia — obiecała tajemniczo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616092.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Nie traćmy czasu! — zatrwożył się nagle jednoręki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774772.wav\",\n",
      "    \"duration\": 7.464,\n",
      "    \"text\": \"Zbyt drażniące, zbyt mocne było jego spoglądanie prosto w oczy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774773.wav\",\n",
      "    \"duration\": 8.376,\n",
      "    \"text\": \"— Więc przyznaje pan, że w praktyce musi się uczynić wybór? — Jest się zmuszonym.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774774.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Jakby dziecko mniej czuło, miało inną skórę niż oni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686222.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Dominującą religią w Polsce jest katolicyzm.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686223.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"— Skąd pan może wiedzieć o tym wszystkim? — szeptał na pół przytomny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686224.wav\",\n",
      "    \"duration\": 2.976,\n",
      "    \"text\": \"Ale to było dawno.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23372855.wav\",\n",
      "    \"duration\": 7.584,\n",
      "    \"text\": \"Bez ruchu podawało mi to stworzenie dłoń.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23372857.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Tak jest lepiej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23372858.wav\",\n",
      "    \"duration\": 7.224,\n",
      "    \"text\": \"Lecz głos, który te widzialne wypowiadał słowa, umarły był i bez echa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38543228.wav\",\n",
      "    \"duration\": 3.96,\n",
      "    \"text\": \"Bardzo pomocny był także pan minister\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38543231.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Podejmuje się zauważalne wysiłki w związku z innymi problemami, czego przejawami są\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38543232.wav\",\n",
      "    \"duration\": 3.888,\n",
      "    \"text\": \"Machinalnie spojrzał na środek kościoła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616094.wav\",\n",
      "    \"duration\": 6.096,\n",
      "    \"text\": \"Ktoś ma złość do naszej panienki i rzucił uroki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616096.wav\",\n",
      "    \"duration\": 8.064,\n",
      "    \"text\": \"Unikam wszelkich poprawek i przeróbek! — odpowiedział pośpiesznie i niespokojnie Podlasiak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616098.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"— On cię bardzo polubił z mojego opowiadania.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607419.wav\",\n",
      "    \"duration\": 2.976,\n",
      "    \"text\": \"Ulokowali panią w okropnej dziurze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607421.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Markowi, jako najstarszemu, dostało się największe wymyślanie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607424.wav\",\n",
      "    \"duration\": 4.68,\n",
      "    \"text\": \"Ustawodawstwo i inne środki stworzą mu wszelkie możliwości.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774948.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Los czyli nie przychodzi ku nam mimo naszej woli?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774956.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"W takiej chwili pasiecie się? — zawołał młody muł.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774958.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"I dorośli, i dzieci.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604509.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"— Dlaczego? — Bo ty nie leżysz na dnie morza.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604517.wav\",\n",
      "    \"duration\": 6.624,\n",
      "    \"text\": \"Zgromadzenie Ogólne apeluje do rodziców i indywidualnie do mężczyzn i kobiet.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604562.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"— Szkło się łatwo tłucze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603756.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"— Przyrzekam, że nie ruszę się z tego miejsca.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603775.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Mongołowie uczynili to samo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603792.wav\",\n",
      "    \"duration\": 6.384,\n",
      "    \"text\": \"Niechta! — dorzucił znowu kulawiec i znowu machnął ręką.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603809.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Ewa będzie z koleżankami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603825.wav\",\n",
      "    \"duration\": 2.76,\n",
      "    \"text\": \"Ona nie znosiła dotyku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603848.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"— tak Go zaklinał i prosił.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625164.wav\",\n",
      "    \"duration\": 7.992,\n",
      "    \"text\": \"Oczy te bezwiednie stroniły od przepychu zdziwienia, jak od niedostępnych bram zamkniętego pałacu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625166.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"To pewniejsze niż stary jeleń!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625169.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Jasnowłosy był jak ty!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27434096.wav\",\n",
      "    \"duration\": 4.788,\n",
      "    \"text\": \"Doceniamy osiągnięte ostatnio postępy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27434098.wav\",\n",
      "    \"duration\": 9.756,\n",
      "    \"text\": \"Czas na centralne umiejscowienie jednego autorytetu na szczeblu europejskim prawdopodobnie jeszcze nie nadszedł\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27434106.wav\",\n",
      "    \"duration\": 7.128,\n",
      "    \"text\": \"Jutro Parlament podejmie decyzję w sprawie różnych części pakietu klimatycznego\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618787.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Ale nie jest to zgodne z prawdą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618788.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Gdzie ma być: „rąk”, napisane: „rak”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618790.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Ten człowiek wciąż jeszcze stoi na korytarzu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622860.wav\",\n",
      "    \"duration\": 6.072,\n",
      "    \"text\": \"— Mogę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622865.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Lecz nie żałuję trudu; wyniki przeszły moje oczekiwania.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622869.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Cześć! Jak mogę Ci pomóc?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604498.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Radek sam wyglądał jak obrazek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604501.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Muzyka i śpiew nieustanny, uczty i igrzyska zapełniały jego życie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604538.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Tak dokładnie opisywałeś, jak lubisz kiszkę kaszaną.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41568745.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Jestem wdzięczna obu panom posłom i rozumiem pasję i siłę emocji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41568746.wav\",\n",
      "    \"duration\": 7.92,\n",
      "    \"text\": \"Nawiasem mówiąc, moja partia postuluje wstrzymanie procesu rozszerzenia po przyjęciu Chorwacji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41568748.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"Ufam, że w ciągu trzech lat dołączy do nich program kulturalny\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616268.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Lecz nie żałuję trudu; wyniki przeszły moje oczekiwania.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616270.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"Powróciwszy, poddał się okolicznościom i zapłacił karę oraz zaległy podatek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616272.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Kładzie się na łóżko i pyta półserio, ostrożnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622369.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Kobiety o zbyt grubych nogach w kostce wyglądają na plaży całkiem dobrze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622374.wav\",\n",
      "    \"duration\": 8.016,\n",
      "    \"text\": \"Wśród funkcjonariuszy stacyjnych podobno nastrój dla władz nader nieprzychylny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622376.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Trzeba szukać nowej gospody, póki jeszcze brzuszek pełen.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620259.wav\",\n",
      "    \"duration\": 6.36,\n",
      "    \"text\": \"Siłą się wziąć nie dam.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620260.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Wór milczał uparcie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620261.wav\",\n",
      "    \"duration\": 7.488,\n",
      "    \"text\": \"Po wybuchu śmiechu zaci nało się coś w niej: zegar, który przestał nagle chodzić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38273003.wav\",\n",
      "    \"duration\": 8.208,\n",
      "    \"text\": \"Przyjmując tę dyrektywę Unia Europejska umożliwia odcięcie usług internetowych bez potrzeby uzyskania zgody sądu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38273004.wav\",\n",
      "    \"duration\": 3.348,\n",
      "    \"text\": \"Oświadczenia pisemne\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38273005.wav\",\n",
      "    \"duration\": 2.916,\n",
      "    \"text\": \"Cóż - zgadzam się\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37568379.wav\",\n",
      "    \"duration\": 3.24,\n",
      "    \"text\": \"Inne wciąż jeszcze muszą to zrobić\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37568380.wav\",\n",
      "    \"duration\": 8.1,\n",
      "    \"text\": \"Sytuacja polityczna na Bałkanach od lat jest przedmiotem szczególnego zainteresowania naszego Parlamentu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37568381.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Nie znam się na iPhonach więc trzeba ich zakazać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_36639501.wav\",\n",
      "    \"duration\": 7.668,\n",
      "    \"text\": \"Obydwa kraje zajmują też wysokie pozycje, jeżeli chodzi o problem handlu ludźmi\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_36639506.wav\",\n",
      "    \"duration\": 7.272,\n",
      "    \"text\": \"Ogromnym wyzwaniem pozostaje zapewnienie właściwej realizacji polityk strukturalnych\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_36639520.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Wezwaliśmy do tego podczas ostatniej wizyty naszej delegacji w Pakistanie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603763.wav\",\n",
      "    \"duration\": 9.456,\n",
      "    \"text\": \"Przebył pan szczęśliwie nader poważną chorobę; wszelkie wzruszenia mogłyby panu zaszkodzić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603794.wav\",\n",
      "    \"duration\": 7.224,\n",
      "    \"text\": \"W ostatnich szczególniej czasach przyjaciele wzajem na siebie uskarżać się nie mogli.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603808.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"I podał Maciusiowi papier, wciąż stojąc na baczność.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40291251.wav\",\n",
      "    \"duration\": 10.656,\n",
      "    \"text\": \"Po tych wszystkich dyskusjach, teraz będziemy mieć świadomość, jak duże ma to znaczenie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40291254.wav\",\n",
      "    \"duration\": 10.44,\n",
      "    \"text\": \"Ubolewam nad nieobecnością prezydencji Rady\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40291255.wav\",\n",
      "    \"duration\": 5.4,\n",
      "    \"text\": \"Kto czyta książki żyje podwójnie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23372890.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"„Nie jestem Rabbi, chociaż mam prawo używać tego tytułu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23372891.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Tylko jedno skierowane jest na ulicę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23372895.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"W Talmudzie stoi: „Zanim Bóg stworzył świat, postawił zwierciadło przed istotami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630641.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Inaczej się żyje w chałupie gajowego, a inaczej w młynie…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630643.wav\",\n",
      "    \"duration\": 2.664,\n",
      "    \"text\": \"Zresztą kto wie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630644.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"Zrobiło na mnie wrażenie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20651351.wav\",\n",
      "    \"duration\": 2.424,\n",
      "    \"text\": \"Dokładnie wiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20651352.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"Czy chciałabyś usłyszeć resztę?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20651353.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Ona jest córką ekonoma i kocha naczelnika stacji.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616586.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"W oczach naszych sosna skonała…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616591.wav\",\n",
      "    \"duration\": 6.072,\n",
      "    \"text\": \"Dni rozłąki jakże gorzkie, jakie złe są!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616598.wav\",\n",
      "    \"duration\": 6.096,\n",
      "    \"text\": \"Niewątpliwie jest to zbiorowy kompleks mniejszej war tości.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643819.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Nie zbędę… — odparła, rumieniąc się, dziwożona.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643820.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"Są narody czyste i są brudne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643822.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Żyć to jest prawie zawsze „żyć”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37497402.wav\",\n",
      "    \"duration\": 5.76,\n",
      "    \"text\": \"Stanowi to również dużą przewagę w przyszłym życiu zawodowym\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37497403.wav\",\n",
      "    \"duration\": 7.56,\n",
      "    \"text\": \"Dziś jednak zajmujemy się sprawozdaniem Trybunału Obrachunkowego, a więc musimy przyjrzeć się liczbom\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37497406.wav\",\n",
      "    \"duration\": 7.128,\n",
      "    \"text\": \"Nie został więc dotąd ustalony wspólny model gwarancji depozytów\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622631.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"A chleba nie wyżarła? — spytał znowu kulawiec.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622632.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Należy być praktycznym; jestem pozytywistą, mój panie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622633.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Zapytuje mnie, co robi w tej chwili dr Tadeusz Sokołowski.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613727.wav\",\n",
      "    \"duration\": 6.864,\n",
      "    \"text\": \"— Co pani zamówi? — zapytał, gdy przyszedł kelner.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613728.wav\",\n",
      "    \"duration\": 6.624,\n",
      "    \"text\": \"Była to godzina przedwieczorna, milcząca, nieruchoma.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613730.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Ot, zwyczajny żart i tyle.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774871.wav\",\n",
      "    \"duration\": 6.504,\n",
      "    \"text\": \"Toccata C-dur poszła niespodzie wanie łatwo; całuję codziennie adagio na dobranoc.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774877.wav\",\n",
      "    \"duration\": 2.736,\n",
      "    \"text\": \"Ubrał się i wybiegł.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774879.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"To jest nienormalne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20814299.wav\",\n",
      "    \"duration\": 2.616,\n",
      "    \"text\": \"Znasz przecie kobiety!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20814376.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Dzieci idą na boisko i bawią się piłką.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20814430.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Już powinna się wyrzec wszelkich strojów!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20640477.wav\",\n",
      "    \"duration\": 3.912,\n",
      "    \"text\": \"— On trzyma, a ty zrzuciłeś.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20640482.wav\",\n",
      "    \"duration\": 6.096,\n",
      "    \"text\": \"I nagle z jego włosów zaczęły się sypać iskry aż na podłogę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20640485.wav\",\n",
      "    \"duration\": 3.672,\n",
      "    \"text\": \"— Jestem na twoje rozkazy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689110.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"Jak chcę i muszę, to nie mogę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689111.wav\",\n",
      "    \"duration\": 2.52,\n",
      "    \"text\": \"Cicho… on śpi!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689112.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Niestety musiałem wyjechać nie zobaczywszy się z nim.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26618572.wav\",\n",
      "    \"duration\": 6.516,\n",
      "    \"text\": \"Nie zapominajmy jednak, że z tymi inwestycjami wiąże się pewien obowiązek\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26618573.wav\",\n",
      "    \"duration\": 6.66,\n",
      "    \"text\": \"Po drugie uważam, że ważne jest, by zapobiegać za pomocą tych funduszy zniekształceniom rynku\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26618575.wav\",\n",
      "    \"duration\": 5.58,\n",
      "    \"text\": \"Państwem, które wdrożyło zalecenia - należy mu oddać należne uznanie - była Holandia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603619.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Tak, od jutra, od jutra — trudno.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603625.wav\",\n",
      "    \"duration\": 3.456,\n",
      "    \"text\": \"Dla mnie zmieniła świat cały.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603641.wav\",\n",
      "    \"duration\": 7.464,\n",
      "    \"text\": \"Kulawiec był posiadaczem torby kusej i płytkiej, ale upchanej dostatnio i pękatej jak kobza.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22723300.wav\",\n",
      "    \"duration\": 5.568,\n",
      "    \"text\": \"Niby uboga, a trzyma w ręku iPhone'a.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22723301.wav\",\n",
      "    \"duration\": 9.528,\n",
      "    \"text\": \"Mogło być około drugiej, gdy na wolniejszem miejscu w lesie przystanęliśmy na chwilę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22723303.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Włosy mi stanęły dębem na głowie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603946.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Ale to na nic, bo on ucieknie drugim wylotem wąwozu!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603948.wav\",\n",
      "    \"duration\": 4.44,\n",
      "    \"text\": \"Brzuszek ma pękaty jak to ziarnko grochu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603965.wav\",\n",
      "    \"duration\": 4.56,\n",
      "    \"text\": \"— A dlaczego się wykręcałaś od tego? — Nie wiem sama.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40823085.wav\",\n",
      "    \"duration\": 8.532,\n",
      "    \"text\": \"Unia Europejska ma moralny obowiązek niezwłocznego wdrożenia tych nowych narzędzi międzynarodowej solidarności\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40823087.wav\",\n",
      "    \"duration\": 7.272,\n",
      "    \"text\": \"Przy domaganiu się jej radykalnej zmiany, powinniśmy zatem zachować ostrożność\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40823089.wav\",\n",
      "    \"duration\": 7.38,\n",
      "    \"text\": \"Proces porównywania w Japonii wykazał, że takie projekty przynoszą nadzwyczajne osiągnięcia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20676576.wav\",\n",
      "    \"duration\": 8.064,\n",
      "    \"text\": \"Obiecał, że będzie przysyłał pieniądze co miesiąc.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20676579.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Więc nie nalegał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20676580.wav\",\n",
      "    \"duration\": 9.024,\n",
      "    \"text\": \"Słońce zaszło, zmierzch padł na rzekę i światła zaczęły się ukazywać wzdłuż brzegu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38691273.wav\",\n",
      "    \"duration\": 8.208,\n",
      "    \"text\": \"Należy zrobić wszystko, aby zapewnić ochronę ludności cywilnej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38691274.wav\",\n",
      "    \"duration\": 6.84,\n",
      "    \"text\": \"Wygłosiłem dłuższe przemówienie na początku obrad\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38691275.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Nasza tajna narada jest przestępstwem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20631222.wav\",\n",
      "    \"duration\": 9.264,\n",
      "    \"text\": \"— Drugie danie tu ci przyniosą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20631225.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Męczące uczucie niedokończenia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20631226.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Zawahali się chwilę i potem poszli dalej, zostawiając głębokie ślady.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20641174.wav\",\n",
      "    \"duration\": 7.584,\n",
      "    \"text\": \"Stosunek z nim nie sprawia mi ani połowy takiej przy jemności, jak z P.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20641175.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Wprawdzie nie tak intensywnie, jak ty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20641176.wav\",\n",
      "    \"duration\": 6.624,\n",
      "    \"text\": \"Do jaru, ludzie dobrzy, do jaru! — zawołał z zapałem Podlasiak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603774.wav\",\n",
      "    \"duration\": 4.248,\n",
      "    \"text\": \"A Podlasiak gdzie? — zapytał z niepokojem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603837.wav\",\n",
      "    \"duration\": 4.368,\n",
      "    \"text\": \"Na ślepo! — upewnił Podlasiak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604015.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Nie mogę zdać sobie sprawy z odległości, z jakiej je oglądam.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38182399.wav\",\n",
      "    \"duration\": 5.472,\n",
      "    \"text\": \"Jednakże więcej na ten temat będzie w niedalekiej przyszłości\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38182400.wav\",\n",
      "    \"duration\": 7.812,\n",
      "    \"text\": \"Mimo godnej uznania pracy Komisji przy opracowaniu strategii, zdumiewa mnie ona swoją naiwnością\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38182402.wav\",\n",
      "    \"duration\": 3.888,\n",
      "    \"text\": \"Ujawniono nielegalną kopię\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618877.wav\",\n",
      "    \"duration\": 6.168,\n",
      "    \"text\": \"Po prostu przestał dlatego, że Emil przestał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618879.wav\",\n",
      "    \"duration\": 3.672,\n",
      "    \"text\": \"Prawdą jest wszystko!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618880.wav\",\n",
      "    \"duration\": 6.96,\n",
      "    \"text\": \"I Bartek coraz gwałtowniej, coraz silniej tęsknił za głosem ludzkim.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619132.wav\",\n",
      "    \"duration\": 9.984,\n",
      "    \"text\": \"Czytałem, pisałem, robiłem różne rzeczy, ale ciężaru z serca zrzucić nie mogłem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619133.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"— Co za skromność!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619134.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Kocham ciebie, jak nigdy nie kochałam nikogo…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25169664.wav\",\n",
      "    \"duration\": 4.068,\n",
      "    \"text\": \"Szukasz garnca złota czy coś?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25169665.wav\",\n",
      "    \"duration\": 4.428,\n",
      "    \"text\": \"Chciałem panu umożliwić wyjście z tej sprawy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25169666.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Odgadywałem to po złych, posępnych błyskach oczu i po kurczowem zaciskaniu palców.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637351.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Dzieci powitały go radośnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637354.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Ludzie nauczyli się zabijać swój czas, to znaczy zabijać życie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637355.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Chcę wiedzieć, co postanowili moi wrogowie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_34942931.wav\",\n",
      "    \"duration\": 5.58,\n",
      "    \"text\": \"Sprawa wiz jest bardzo ważna dla wszystkich Białorusinów\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_34942932.wav\",\n",
      "    \"duration\": 5.328,\n",
      "    \"text\": \"Chciałbym również zwrócić się w tej sprawie do moich koleżanek i kolegów\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_34942933.wav\",\n",
      "    \"duration\": 10.26,\n",
      "    \"text\": \"transport zwierząt, niedostateczny system wczesnego ostrzegania przed zagrożeniami, niewystarczająca profilaktyka, w tym szczepienia ochronne\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20934727.wav\",\n",
      "    \"duration\": 3.912,\n",
      "    \"text\": \"Ale za to zobaczył siebie w lustrze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20934728.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"— Żebyś wiedział, że święto! — zawołała.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20934729.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Lecz on uśmiechnął się tylko i rzekł.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26981567.wav\",\n",
      "    \"duration\": 7.632,\n",
      "    \"text\": \"Dyrektywa o usługach ma na celu pełną realizację jednolitego, wewnętrznego rynku usług\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26981573.wav\",\n",
      "    \"duration\": 3.78,\n",
      "    \"text\": \"Dlatego nie znam szczegółów, o które pani pyta\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26981598.wav\",\n",
      "    \"duration\": 2.664,\n",
      "    \"text\": \"To nasz bezwzględny obowiązek\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603632.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Tak, jakby ich w ogóle nie słyszała.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603688.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"— Jak gdyby nigdy nic.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603718.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Nie słyszę cię.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26224732.wav\",\n",
      "    \"duration\": 7.488,\n",
      "    \"text\": \"Podczas obecnej debaty udzielano różnych wyjaśnień w tym zakresie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26224733.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Właśnie o tym chcę dziś powiedzieć\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26224734.wav\",\n",
      "    \"duration\": 8.028,\n",
      "    \"text\": \"Proponuje się często pewne wyjątkowe warunki tej dwustronnej współpracy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20672561.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"W istocie kroki czyjeś zbliżyły się do drzwi biblioteki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20672562.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"— Leżymy jeszcze na dnie morza? — Ja tak, a ty nie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20672563.wav\",\n",
      "    \"duration\": 2.976,\n",
      "    \"text\": \"Szybko, wezwij karetkę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614859.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Na ich twarzach malowały się głęboki szacunek i przestrach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614861.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Matematyka to mój ulubiony przedmiot.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614863.wav\",\n",
      "    \"duration\": 2.616,\n",
      "    \"text\": \"Kocie łby.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20662535.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Nie wiem, więc nie będę się wypowiadać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20662536.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Wąż istotnie ani się nie ruszył.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20662538.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"Z naszych nikt nie był zabity.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606638.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Byłem pewny, że kłamie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606643.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Co się odwlecze to nie uciecze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606659.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"— Przykra misja — objaśnił po chwili.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40924537.wav\",\n",
      "    \"duration\": 6.192,\n",
      "    \"text\": \"Możliwości takie istnieją i podzielamy ten punkt widzenia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40924538.wav\",\n",
      "    \"duration\": 5.76,\n",
      "    \"text\": \"Ponadto istnieją ścisłe ograniczenia czasowe przydatności organów\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40924539.wav\",\n",
      "    \"duration\": 8.46,\n",
      "    \"text\": \"W dwóch wystąpieniach otwierających debatę słusznie podkreślono, że najważniejszą zmianą demograficzną jest długowieczność\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40116439.wav\",\n",
      "    \"duration\": 4.608,\n",
      "    \"text\": \"Judym był w położeniu rozpaczliwem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40116440.wav\",\n",
      "    \"duration\": 2.556,\n",
      "    \"text\": \"W wagonach powstała panika.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40116441.wav\",\n",
      "    \"duration\": 4.068,\n",
      "    \"text\": \"Reforma tego rodzaju jest zdecydowanie opóźniona\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23374867.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Wszystko wydaje się u nich piegowate.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23374868.wav\",\n",
      "    \"duration\": 3.144,\n",
      "    \"text\": \"Dlaczego naraz trwoga?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23374870.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Nie tak łatwo jest pomagać, jak sądzisz, drogi przyjacielu!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40976792.wav\",\n",
      "    \"duration\": 6.66,\n",
      "    \"text\": \"faktyczne klasy, klasy zintegrowane we wszystkich szkołach europejskich\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40976793.wav\",\n",
      "    \"duration\": 6.876,\n",
      "    \"text\": \"Bez zaspokojenia tej potrzeby nie ma mowy o polepszeniu opieki zdrowotnej czy rozwoju edukacji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40976794.wav\",\n",
      "    \"duration\": 6.228,\n",
      "    \"text\": \"Zapewnimy natomiast większą harmonizację budżetu z zasadami budżetowej rzetelności i jasności\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605028.wav\",\n",
      "    \"duration\": 8.904,\n",
      "    \"text\": \"Lekarz rozmawiał najpierw z matką, a Emil siedział w poczekalni i miał tremę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605031.wav\",\n",
      "    \"duration\": 7.296,\n",
      "    \"text\": \"Bachory pisiały na jezdnię; były wyblakłe, złośliwe i mądre.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605032.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"— Pan naczelnik — podkreślił z przekąsem — żartuje.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656026.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Zawsze jednak słyszeli, jak nadchodziła bona.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656027.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Żelazne wrota blokowały im przejście.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656028.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"No i podnieśli.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20627709.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Więc pieniędzy nie przyjęła?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20627710.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Mają po kilkaset metrów długości.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20627712.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Moje czekanie jest napięte i wytężone.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20968702.wav\",\n",
      "    \"duration\": 8.4,\n",
      "    \"text\": \"Jeśli trafili na ludność sprzyjającą tajemnie Mahdiemu, wówczas cała karawana zjeżdżała do wsi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20968703.wav\",\n",
      "    \"duration\": 2.496,\n",
      "    \"text\": \"Obaj byli wdowcami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20968704.wav\",\n",
      "    \"duration\": 3.168,\n",
      "    \"text\": \"Mówiąc to, wyjął banknot.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643488.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"Nie, nie tutaj, — w tył od tamtego folwarku!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643489.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Jest to nawet rzecz przynosząca dochód.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643491.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"I ptaszek odpowiedział.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607067.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"A może pod wpływem skruchy?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607090.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"Sądząc, że nie zaśnie, wolał oczekiwać w łóżku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607139.wav\",\n",
      "    \"duration\": 2.856,\n",
      "    \"text\": \"— Nie wolno takich rzeczy pamiętać!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28568865.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Dlatego właśnie zagłosowałem za przyjęciem przedmiotowego sprawozdania\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28568869.wav\",\n",
      "    \"duration\": 4.86,\n",
      "    \"text\": \"Chociaż działania te są istotne, to jednak niewystarczające\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28568871.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Dlatego Hezbollah powinien być pilnie wpisany na europejską listę organizacji terrorystycznych\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608484.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Zosiu, przestań gryźć mamę!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608489.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Po tylu, tylu latach cieszę się, że śnieg, że biało.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608490.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Chcesz, pokażę ci teraz króliki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30724557.wav\",\n",
      "    \"duration\": 4.536,\n",
      "    \"text\": \"od zbyt dawna jest ono zaniedbane\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30724559.wav\",\n",
      "    \"duration\": 4.5,\n",
      "    \"text\": \"Myślę, że nie muszę już nic dodawać\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30724561.wav\",\n",
      "    \"duration\": 5.688,\n",
      "    \"text\": \"Potrzebujemy nowego traktatu na nową epokę\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609047.wav\",\n",
      "    \"duration\": 6.768,\n",
      "    \"text\": \"Skąd? Nie wiadomo! — odpowiedział Podlasiak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609049.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Jestem w nędzy…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609054.wav\",\n",
      "    \"duration\": 9.024,\n",
      "    \"text\": \"Ludzie dobrzy! — zawołał znowu, życzliwie kiwając głową i uśmiechem popierając każde kiwnięcie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609316.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"— To nie urągaj!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609318.wav\",\n",
      "    \"duration\": 7.104,\n",
      "    \"text\": \"Mając lat siedem czuł już, jak należy postępować z lekarzami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609320.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Cudna kobieta! — pomyślałem, przestępując próg sali.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20642269.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"I gimnazjum jest coraz bliżej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20642270.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Jest jej kuzynem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20642271.wav\",\n",
      "    \"duration\": 2.976,\n",
      "    \"text\": \"Słyszę tylko hałas.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775361.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Tymczasem Wierusz odprowadzał chorą materię już ku palcom.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775363.wav\",\n",
      "    \"duration\": 4.992,\n",
      "    \"text\": \"Jedziemy na toczącej się w przestrzeni kuli.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775366.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"Zresztą twarze obu po zajściu metamorfozy były zupełnie różne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20778965.wav\",\n",
      "    \"duration\": 4.8,\n",
      "    \"text\": \"— Nie wolno się ruszać! — mówił ktoś pochylony nade mną.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20778966.wav\",\n",
      "    \"duration\": 3.672,\n",
      "    \"text\": \"— Zdawało ci się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20778968.wav\",\n",
      "    \"duration\": 7.824,\n",
      "    \"text\": \"Pewnego razu powiedział do niej: — Istnieje jeszcze rzecz, którą zataiłem przed tobą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20649829.wav\",\n",
      "    \"duration\": 9.288,\n",
      "    \"text\": \"Budynek mieścił się w niejakiej odległości od miasta nad wielkim stawem otoczonym palmami kokosowymi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20649832.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"Dzień dobry, wszyscy umrzemy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20649833.wav\",\n",
      "    \"duration\": 6.192,\n",
      "    \"text\": \"Na ustach jego ukazał się lekki uśmiech i pozostał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20551620.wav\",\n",
      "    \"duration\": 6.936,\n",
      "    \"text\": \"Wczoraj byłem u znajomego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20551622.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Marysia skinęła rzęsami, tak jakby kto inny skinął głową.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20551625.wav\",\n",
      "    \"duration\": 4.392,\n",
      "    \"text\": \"— Byle tylko jechać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27423572.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Jakie będą skutki nowelizacji wspólnotowego kodeksu celnego?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27423573.wav\",\n",
      "    \"duration\": 6.948,\n",
      "    \"text\": \"Musimy podejść do tej konferencji w sposób optymistyczny, ale i realistyczny\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27423575.wav\",\n",
      "    \"duration\": 9.54,\n",
      "    \"text\": \"Co więcej, traktat z Lizbony nie przewiduje wsparcia dla wspólnej europejskiej polityki leśnej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620300.wav\",\n",
      "    \"duration\": 2.544,\n",
      "    \"text\": \"Przeszli szybko na „ty”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620301.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"Gondola odbijała od brzegu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620302.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Prawda, że jest przyjemny?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774817.wav\",\n",
      "    \"duration\": 2.472,\n",
      "    \"text\": \"— Pora wracać do domu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774821.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Pieczenie gorącej oliwy, ale nie bardzo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774822.wav\",\n",
      "    \"duration\": 2.112,\n",
      "    \"text\": \"Takie bywają nasze noce.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774922.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"— Nie wiem, nic nie wiem — powtórzył parę razy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774925.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"I źli są, że nie słuchamy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774933.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Tam ja jechać nie mogę, widzicie, bo był taki wypadek…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20662815.wav\",\n",
      "    \"duration\": 5.232,\n",
      "    \"text\": \"Nikt, jak ona, nie tańczył z takim wdziękiem walca, oberka, mazura.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20662820.wav\",\n",
      "    \"duration\": 2.928,\n",
      "    \"text\": \"Skończyła pierwszy rok chemii.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20662822.wav\",\n",
      "    \"duration\": 4.872,\n",
      "    \"text\": \"Usiedli przodem do wnętrza koła, na złość.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623068.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"— No, to chciej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623071.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Tylko niech mnie pan na tej stacji nie pozdrawia!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623084.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Po drodze mrużył oczy, które wydawały się jak wprawione.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32072424.wav\",\n",
      "    \"duration\": 5.4,\n",
      "    \"text\": \"Mamy obecnie do czynienia z paradoksem\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32072427.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Dlatego podejmujemy działania\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32129747.wav\",\n",
      "    \"duration\": 5.58,\n",
      "    \"text\": \"Nie powinniśmy dawać tym krajom wolnej ręki\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623281.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Posadził ją na kolanach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623284.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Nie zależało jej na tym, a jednak nie istniał już poza nią.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623287.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Spójrz w oczy moje lśniące!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603085.wav\",\n",
      "    \"duration\": 4.272,\n",
      "    \"text\": \"Po wrzaskach i płaczu mocno jej się spało.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603087.wav\",\n",
      "    \"duration\": 3.432,\n",
      "    \"text\": \"— Ani nie przypuszcza, z kim jedzie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603088.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Jasnowłosy był jak ty!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608468.wav\",\n",
      "    \"duration\": 8.496,\n",
      "    \"text\": \"Ogień natychmiast zaczął szybko posuwać się wzdłuż kanału pomiędzy klocami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608469.wav\",\n",
      "    \"duration\": 7.176,\n",
      "    \"text\": \"Gdyby było inaczej, nie okazałby pan tej chwalebnej przezorności.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608472.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Zapadło na chwilę milczenie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20773042.wav\",\n",
      "    \"duration\": 2.736,\n",
      "    \"text\": \"Podnieśli się na nogi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20773044.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Czas mi na Bródno, czas…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20773047.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Pierwszym elementem kształtującym człowieka jest genetyka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21085913.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Podeszła do szafy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21085915.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"” I nie ziewnął, jak na złość.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21085916.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Rewolwer nosił zawsze w kieszeni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605470.wav\",\n",
      "    \"duration\": 4.512,\n",
      "    \"text\": \"— Panie! — protestował inspektor.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605480.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Jakże się wtedy Sebastian pienił ze złości!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605502.wav\",\n",
      "    \"duration\": 3.792,\n",
      "    \"text\": \"Wyprostowała się dumnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639857.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Nie po wirtuozowsku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639858.wav\",\n",
      "    \"duration\": 8.304,\n",
      "    \"text\": \"Ta błyskawica w jednej chwili ukazała jej całą głębię jej upadku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639859.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Przecież wiesz, że nie będziesz jej czytał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614685.wav\",\n",
      "    \"duration\": 2.616,\n",
      "    \"text\": \"— Zdawało ci się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614687.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Do jaru, ludzie dobrzy, do jaru! — zawołał z zapałem Podlasiak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614688.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"— Powoli, stary, tylko aby nie za prędko…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605290.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Z pomocą swej busoli Filip kontrolował przez godzinę kierunek ich jazdy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605390.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Chce czegoś bardzo, tylko narazie nie wie czego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605925.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Nie jest gryzoniem, ale gryzie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21152627.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Jest godzina szósta czterdzieści.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21152629.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"— Opowiedz mi teraz wszystko!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21152630.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"— Widziałem, jak domy uderzały o most, zanim roznieciły się ognie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20649749.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Jeżeli to był sen, można było jej wybaczyć te kuchenne maniery.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20649750.wav\",\n",
      "    \"duration\": 2.664,\n",
      "    \"text\": \"Będę mówił o sobie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20649751.wav\",\n",
      "    \"duration\": 2.376,\n",
      "    \"text\": \"Podszedł do niej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20685409.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"— Daremny trud, drzwi są szczelnie zasłonięte.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20685411.wav\",\n",
      "    \"duration\": 3.144,\n",
      "    \"text\": \"Co za wykończenie!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20685412.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Panie Boże itd.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604254.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Do Marysi: — Profesora chyba nie ma w Sylwestra.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604280.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"— One wyglądają jak cygara — i Ela była znów niby dorosła, poważna.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604286.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"— A jeśli woli, niech się w torbie prześpi i sił dla nas nabierze!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20773966.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"- Bez kartki meldunkowej?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20773967.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Z wieloma uprawiałem seks\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20773968.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Król usiłował znaczącymi spojrzeniami zachęcić swego poetę do ostatniego wysiłku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40314778.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"Dlatego stanowczo proponuję wspólną politykę energetyczną\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40314779.wav\",\n",
      "    \"duration\": 5.76,\n",
      "    \"text\": \"Działać należy stopniowo, ale jednocześnie trzeba określić bardzo wyraźne ramy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40314780.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Kluczowym hasłem pozostaje \\\"podejście globalne\\\"\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621375.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"— Chcesz iść do kina na „Hotel du Nord”? — Nic nie chcę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621376.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"Przypuszczam, że Nowak przepędził popołudnie na gorzkich rozmyślaniach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621379.wav\",\n",
      "    \"duration\": 3.408,\n",
      "    \"text\": \"Tatarak wkrótce zjedzono do szczętu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616667.wav\",\n",
      "    \"duration\": 8.736,\n",
      "    \"text\": \"Tym razem na portalach poświęconych kinematografii film otrzymał dość słabe oceny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616668.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Jak Emil komicznie się zachowywał, gdy mu powiedziałam o łące.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616670.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"Takie poczułem do niego obrzydzenie, że tylko splunąć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775559.wav\",\n",
      "    \"duration\": 8.016,\n",
      "    \"text\": \"Całą noc ich tam chyba nie zostawisz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775560.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Ale żeby ośmielić się nocą wchodzić do mego domu!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775561.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Zabić go, czy co? Spytam małego k.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632267.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"— Seniora — odparłem, tonąc oczyma w jej oczach — jestem panią oczarowany.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632270.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"I uciekł twarzą, jakby przestraszony, i w ruchu tym była kokieteria.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632271.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Nadszedł czas potopu, pogasły gwiazdy na niebie i znikły światła na ziemi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607230.wav\",\n",
      "    \"duration\": 5.952,\n",
      "    \"text\": \"— Chcę tylko dostać tataraku! Lubię tatarak!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607232.wav\",\n",
      "    \"duration\": 6.096,\n",
      "    \"text\": \"Przepraszam, nie mogę tego teraz zrobić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607237.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Ale ona była uparta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26771851.wav\",\n",
      "    \"duration\": 5.508,\n",
      "    \"text\": \"Musi Pani być głęboko niepocieszona z tego powodu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26771856.wav\",\n",
      "    \"duration\": 9.36,\n",
      "    \"text\": \"Zajmiemy się również dalszym zmniejszaniem opóźnień w przekazywaniu dotacji i płatności\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26771857.wav\",\n",
      "    \"duration\": 2.916,\n",
      "    \"text\": \"W Anglii mawiamy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28197072.wav\",\n",
      "    \"duration\": 3.924,\n",
      "    \"text\": \"Inną ważną rzeczą jest Fundusz na Rzecz Przystosowania\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28197073.wav\",\n",
      "    \"duration\": 3.6,\n",
      "    \"text\": \"Pierwszym jest przywództwo partnerskich rządów\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28197077.wav\",\n",
      "    \"duration\": 8.172,\n",
      "    \"text\": \"Wyjście ze skomplikowanego kryzysu gospodarczego i finansowego nie było tak skuteczne, jak się spodziewaliśmy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28197083.wav\",\n",
      "    \"duration\": 6.516,\n",
      "    \"text\": \"Z tych względów głosowałem za odrzuceniem przedmiotowego sprawozdania\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21098294.wav\",\n",
      "    \"duration\": 9.24,\n",
      "    \"text\": \"Dla zbója córki nie mam! — krzyknął Konrad, tracąc cierpliwość.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21098296.wav\",\n",
      "    \"duration\": 3.6,\n",
      "    \"text\": \"Jest godzina czwarta dwadzieścia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21098299.wav\",\n",
      "    \"duration\": 3.552,\n",
      "    \"text\": \"Uniwersytet, politechnika to szkoły wyższe.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21098300.wav\",\n",
      "    \"duration\": 5.568,\n",
      "    \"text\": \"Wiesz zresztą, że tu niema żadnych osad ani misji.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613787.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Możesz być tym i tym, albo tam i tam.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613790.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Pomimo przygotowania do podpalenia gmach nie został zniszczony.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613793.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Czy nie zauważyłeś tego, papo?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613796.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Ja tu sama gospodyni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23423792.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"„Alboż pan biednym też nie daje?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23423793.wav\",\n",
      "    \"duration\": 4.032,\n",
      "    \"text\": \"Czy drzwi były zamknięte?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23423794.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"Ale może pani ma niekiedy troski, które mógł bym usunąć?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23423795.wav\",\n",
      "    \"duration\": 5.16,\n",
      "    \"text\": \"Otworzywszy drzwi spostrzegłem, że w pokoju był zmrok.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633849.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"— Jak myślicie, czy on mnie pamięta?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633852.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"— Nie, nie — upierała się — to on, na pewno on.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633855.wav\",\n",
      "    \"duration\": 7.776,\n",
      "    \"text\": \"Chwiejąc się, poszedł szerokim korytarzem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633856.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"A za oknem coraz wyższe słońce.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20779721.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"— A kiedy ją będę widział? — Za kilka dni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20779722.wav\",\n",
      "    \"duration\": 4.776,\n",
      "    \"text\": \"Nie chcę nawet dużo pieniędzy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20779723.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Poczuł strach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20779724.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Nie wiesz, co czytasz, i nie wiesz, co się dzieje w kinie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637481.wav\",\n",
      "    \"duration\": 8.664,\n",
      "    \"text\": \"Cała filozofia religijna katolicyzmu i cała cywilizacja łacińska oparte są na personalizmie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637482.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Jestem pewna, że się nie pomyliłam\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637483.wav\",\n",
      "    \"duration\": 4.536,\n",
      "    \"text\": \"Niby — sfora psów.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637484.wav\",\n",
      "    \"duration\": 2.616,\n",
      "    \"text\": \"On mi się trochę podoba.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620439.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"On mi zesłał tę nieznajomą kobietę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620440.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Emil przychodził zwykle o pięć minut wcześniej i czekał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620442.wav\",\n",
      "    \"duration\": 2.496,\n",
      "    \"text\": \"Poczuł strach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620443.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"— Tylko zdaje mi się, nosił pan do niedawna jeszcze inny mundur.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616212.wav\",\n",
      "    \"duration\": 8.424,\n",
      "    \"text\": \"Zaczęło mi się przewracać w głowie, patrzyłem poza nią, za okno, miałem półotwarte usta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616215.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Trudno, spróbuję jeszcze raz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616218.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Może instynktem kobiety wyczuła przy nim bliskość anioła śmierci?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616220.wav\",\n",
      "    \"duration\": 6.216,\n",
      "    \"text\": \"O ile się nie mylę, przeszedł pan dwukrotnie operację.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603481.wav\",\n",
      "    \"duration\": 6.672,\n",
      "    \"text\": \"Emil poprosił o dwa fartuchy i powiedział do Ewy: — Mogłabyś zostać siostrą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603482.wav\",\n",
      "    \"duration\": 5.28,\n",
      "    \"text\": \"Na pamiątkę — potwierdziła dziwożona, spuszczając oczy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603483.wav\",\n",
      "    \"duration\": 2.496,\n",
      "    \"text\": \"— Chcę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603484.wav\",\n",
      "    \"duration\": 4.272,\n",
      "    \"text\": \"Może on… może on właśnie…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28805598.wav\",\n",
      "    \"duration\": 8.136,\n",
      "    \"text\": \"Środki egzekwowania korekty nadmiernych zakłóceń równowagi makroekonomicznej w strefie euro\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28805602.wav\",\n",
      "    \"duration\": 3.96,\n",
      "    \"text\": \"W którym kierunku zmierza Turcja?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28805608.wav\",\n",
      "    \"duration\": 6.48,\n",
      "    \"text\": \"Nawet przedłużył pobyt o jeden dzień, co jest rzadkością w takich relacjach\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28805621.wav\",\n",
      "    \"duration\": 5.436,\n",
      "    \"text\": \"W komisji wniosek ten poparła zdecydowana większość\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25230326.wav\",\n",
      "    \"duration\": 4.356,\n",
      "    \"text\": \"Nie miała już siły prosić urwisa, żeby nie chodził.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25230327.wav\",\n",
      "    \"duration\": 3.168,\n",
      "    \"text\": \"Kiedyś byłem zapalonym podróżnikiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25230328.wav\",\n",
      "    \"duration\": 3.636,\n",
      "    \"text\": \"Banany na podłodze, pięknie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25230330.wav\",\n",
      "    \"duration\": 2.448,\n",
      "    \"text\": \"To musiała być jego głowa!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20990084.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Pan podążyłeś za nim po roku, nieprawdaż?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20990086.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Pani nauczycielka czytała w szkole dzieciom śliczną baśń o krasnoludkach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20990087.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Nie zaszkodzi wykonać podwójną minetę\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20990088.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"— Więc dotychczas nie gniewałaś się naprawdę?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605381.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Pójdziemy tam z samego rana.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605444.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Byl zgorszony.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605454.wav\",\n",
      "    \"duration\": 2.736,\n",
      "    \"text\": \"Z naszych nikt nie był zabity.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605472.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Nad nimi wiruje i unosi się „nigdy” i śnieg.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656885.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"Rzucała się w oczy od razu oryginalna kompozycja.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656886.wav\",\n",
      "    \"duration\": 7.824,\n",
      "    \"text\": \"Emil zaczął wydobywać pomału historię swoich wakacji, ale zauważył, że Janek jest zmęczony.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656887.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"I z dumą pokazał Pukowi ukończony rysunek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656889.wav\",\n",
      "    \"duration\": 6.504,\n",
      "    \"text\": \"Generał zaś był bez czapki, palił papierosy i patrzył w ogień.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774736.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Nie mógł.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774739.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Sen pełen majaków, zmagań i widm.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774741.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Kama leżała na łóżku i nie odrywała oczu od zakratowanego okna.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774744.wav\",\n",
      "    \"duration\": 1.824,\n",
      "    \"text\": \"Widział jej twarz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605110.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"A może u nich tylko taki już zwyczaj?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605113.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Zdawało mu się, że ma głowę zanurzoną we krwi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605116.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Kto skierował okręt ku niegościnnym wybrzeżom Alaski?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605120.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Szła, patrząc w ziemię, i wydawała się bardzo zasmucona.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605498.wav\",\n",
      "    \"duration\": 6.384,\n",
      "    \"text\": \"Wrócił do pensjonatu, który nazywał się „Złocień”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605567.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Mefisto idzie cudownie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605585.wav\",\n",
      "    \"duration\": 5.688,\n",
      "    \"text\": \"Wyprzedziłem go, by rozświetlać drogę latarką.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605648.wav\",\n",
      "    \"duration\": 6.48,\n",
      "    \"text\": \"Co innego jest fikcja w powieści, a co innego rzeczywistość.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_36947940.wav\",\n",
      "    \"duration\": 8.1,\n",
      "    \"text\": \"powinniśmy mieć to więc w przyszłości na uwadze\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_36947941.wav\",\n",
      "    \"duration\": 5.94,\n",
      "    \"text\": \"Co z radykalnym islamem i tymi wszystkimi trockistami i komunistami?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_36947943.wav\",\n",
      "    \"duration\": 4.32,\n",
      "    \"text\": \"Pragną inicjować korzystne przemiany w Europie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_36947944.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"Elektryczność ma pierwszorzędne znaczenie i powinna być dostępna dla wszystkich\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774970.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Palce jego wpiły się w moje ramię.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774978.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"— Michasiu, powiedz mi, co się ze mną dzieje?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774980.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"— Ten mały nowy więzień.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774984.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Zabrali tron, zabrali koronę, a teraz chcieli i mnie zrabować.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771398.wav\",\n",
      "    \"duration\": 7.464,\n",
      "    \"text\": \"Przyszłość jest przeszłością.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771400.wav\",\n",
      "    \"duration\": 7.224,\n",
      "    \"text\": \"Nie dziwią już liczne komentarze na temat jej najnowszego dzieła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771401.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"U nas w domu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771402.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"- A czy ktoś jeszcze wiem o tym?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616685.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Cezary musiał przyznać, że jest sens w tych wywodach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616687.wav\",\n",
      "    \"duration\": 4.776,\n",
      "    \"text\": \"Na szczęście wiatru nie było, mróz zatem nie dokuczał zbytnio.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616689.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Emil zaczął wydobywać pomału historię swoich wakacji, ale zauważył, że Janek jest zmęczony.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616691.wav\",\n",
      "    \"duration\": 2.304,\n",
      "    \"text\": \"— Zaraz nie możesz mieć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606924.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"Tak, tak… nie wiesz o tym nawet…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606926.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Potem zaczęła je bić po tyłku i biła je długo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606927.wav\",\n",
      "    \"duration\": 7.776,\n",
      "    \"text\": \"Dziecka nie wolno przyjmować do pracy zarobkowej przed osiągnięciem odpowiedniego, minimalnego wieku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606928.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Może wpadniemy do mojej siostry na spaghetti?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24561881.wav\",\n",
      "    \"duration\": 6.228,\n",
      "    \"text\": \"Dała go Ala, uśmiechała się do niego: i do kamyczka i do Maciusia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24561882.wav\",\n",
      "    \"duration\": 3.168,\n",
      "    \"text\": \"Lubisz malować, zostań malarzem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24561883.wav\",\n",
      "    \"duration\": 4.428,\n",
      "    \"text\": \"Ona proteguje, ja się temu opieram; to rzecz prosta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24561884.wav\",\n",
      "    \"duration\": 4.5,\n",
      "    \"text\": \"Pamiętam, kiedy wyjeżdżał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22354079.wav\",\n",
      "    \"duration\": 2.496,\n",
      "    \"text\": \"dwa\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22354081.wav\",\n",
      "    \"duration\": 2.664,\n",
      "    \"text\": \"Firefox\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22354082.wav\",\n",
      "    \"duration\": 1.704,\n",
      "    \"text\": \"siedem\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22354083.wav\",\n",
      "    \"duration\": 1.536,\n",
      "    \"text\": \"Hej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633899.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Mówię.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633901.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Gdym szedł po niej, woda sięgała mi do kolan.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633902.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Mówi, że go królowie oszukali, że port zabrali.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633903.wav\",\n",
      "    \"duration\": 6.936,\n",
      "    \"text\": \"W biały dzień na jawie zdarzały się wypadki niepodobne do wiary.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24552324.wav\",\n",
      "    \"duration\": 3.204,\n",
      "    \"text\": \"Wzruszył na to ramionami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24552326.wav\",\n",
      "    \"duration\": 5.148,\n",
      "    \"text\": \"Jak powiedział pewien milicjant – smutek jest jak pochód – przemija.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24552327.wav\",\n",
      "    \"duration\": 7.02,\n",
      "    \"text\": \"Wówczas zaintrygowani widzowie zebrali się wkoło hrabiego, prosząc o objaśnienie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24552328.wav\",\n",
      "    \"duration\": 3.348,\n",
      "    \"text\": \"Belu, podaj mi rękę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774298.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Teresa transportowała tirem do tartaku\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774300.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"Co roku tu jestem i zawsze mi mało!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774301.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Dzień dobry, wszyscy umrzemy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774304.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Potem przestał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32096400.wav\",\n",
      "    \"duration\": 5.076,\n",
      "    \"text\": \"Mówi, że chcemy unii gospodarczej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32096401.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"Nie postrzegam tej sprawy tak, jak mój przedmówca\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32096404.wav\",\n",
      "    \"duration\": 4.5,\n",
      "    \"text\": \"Ta agresja nie może się Moskwie opłacać\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32096406.wav\",\n",
      "    \"duration\": 5.472,\n",
      "    \"text\": \"To zaniechanie przynosi wstyd nam wszystkim w tej Izbie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647516.wav\",\n",
      "    \"duration\": 4.56,\n",
      "    \"text\": \"— Dokąd się pan teraz wybiera? — zagadnęła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647517.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Włazimy do pokoju przez okienko z łazienki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647518.wav\",\n",
      "    \"duration\": 5.112,\n",
      "    \"text\": \"Nie mają twarzy, wyżarła je ciemność.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647519.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"— Na moim koniu po pocztę!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20653435.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"— No, zbliża się czas, by pomyśleć o powrocie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20653436.wav\",\n",
      "    \"duration\": 7.776,\n",
      "    \"text\": \"— A tak, oczywiście — przyznałem — oba są zabudowane, zwłaszcza ten we Florencji.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20653437.wav\",\n",
      "    \"duration\": 7.296,\n",
      "    \"text\": \"Wróciła do grupy chłopców i dziewcząt, krzyknęła: — Twoja towarzyszka ma śliczną sukienkę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20653438.wav\",\n",
      "    \"duration\": 7.584,\n",
      "    \"text\": \"Ile — myślisz — mogłabym zarabiać jako prostytutka? Żeby zarobić na podróż dokądkolwiek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_33760558.wav\",\n",
      "    \"duration\": 5.58,\n",
      "    \"text\": \"Deklaracja niepodległości Kosowa stała się faktem\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_33760559.wav\",\n",
      "    \"duration\": 5.076,\n",
      "    \"text\": \"Walka ze szkodliwym efektami alkoholu jest stara jak świat\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_33760560.wav\",\n",
      "    \"duration\": 3.6,\n",
      "    \"text\": \"Przecież to nieprawda!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_33760563.wav\",\n",
      "    \"duration\": 6.588,\n",
      "    \"text\": \"Priorytety te należy jednak bardzo szybko przełożyć na konkretne działania krajowe\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40696472.wav\",\n",
      "    \"duration\": 3.78,\n",
      "    \"text\": \"Ta propozycja jest przestarzała\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40696473.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"od planowania po projekt i użytkowanie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40696474.wav\",\n",
      "    \"duration\": 7.308,\n",
      "    \"text\": \"W porównaniu do zeszłego roku stopa bezrobocia wzrosła w dwóch trzecich państw członkowskich\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40696476.wav\",\n",
      "    \"duration\": 4.392,\n",
      "    \"text\": \"Będziemy teraz głosować nad tą poprawką\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614232.wav\",\n",
      "    \"duration\": 6.984,\n",
      "    \"text\": \"Bo pod tym względem kokaina jest jeszcze większą złudą niż alkohol.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614234.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Zapach łajna jest zapachem życia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614239.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Dziwożona wstrząsnęła złocistą grzywą i schyliwszy głowę na bok, kolejno spojrzała na wszystkich.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614242.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Podszedł do drzwi i wyjrzał na pole.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619814.wav\",\n",
      "    \"duration\": 4.512,\n",
      "    \"text\": \"Poza tym jest skąpy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619822.wav\",\n",
      "    \"duration\": 4.512,\n",
      "    \"text\": \"Miała komiczne wargi, górną wysuniętą nad dolną.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619826.wav\",\n",
      "    \"duration\": 2.76,\n",
      "    \"text\": \"Wszystko mi się pomieszało!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619828.wav\",\n",
      "    \"duration\": 2.688,\n",
      "    \"text\": \"Zaprosił ją na lody.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618797.wav\",\n",
      "    \"duration\": 9.696,\n",
      "    \"text\": \"Podlasiak struchlał i zbladł, jak przyłapany na gorącym uczynku winowajca.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618799.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Pański bank raczej nie stoi frontem do klienta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618802.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"A potem przestaje się nawet za tym tęsknić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618805.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Co za myśli, co za koncepty!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614469.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Przyczyna owych ucieczek pozostała nigdy nie wyjaśnioną.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614472.wav\",\n",
      "    \"duration\": 6.504,\n",
      "    \"text\": \"Ale nie mógł prowadzić rozmowy, której przedtem nie obmyślił szczegółowo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614475.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"W takiej sytuacji są one kluczowe do zrozumienia całej sprawy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614476.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Spałem do dwunastej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20649683.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Zapomniałem nadmienić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20649685.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"— Zdawało mi się, że nad strumieniem wszystko się wyjaśni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20649686.wav\",\n",
      "    \"duration\": 7.464,\n",
      "    \"text\": \"Ale może wojna, która nadchodzi, przyniesie tu jakieś zmiany na lepsze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20649687.wav\",\n",
      "    \"duration\": 6.624,\n",
      "    \"text\": \"— Więc zło, zdaniem twoim, jest równie wiecznym jak dobro?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625546.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"Emil płynie powoli po własnych zdaniach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625547.wav\",\n",
      "    \"duration\": 7.224,\n",
      "    \"text\": \"Otóż jakie, zdaniem pańskim, mogą być zamiary takiego psychicznego rekonesansu?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625548.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Jano krzyknął: — Marysiu! Otwarła oczy, zanurzone w śnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625551.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"W czasie podwieczorku mówiliśmy mało.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604878.wav\",\n",
      "    \"duration\": 7.536,\n",
      "    \"text\": \"Przeglądam i segreguję wiersze pisane dla tych, których nie ma.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604879.wav\",\n",
      "    \"duration\": 6.984,\n",
      "    \"text\": \"Weź szczotkę i mydło i wyszoruj ręce jak należy — mówi mama.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604880.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Ludzie z gumowymi wężami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604882.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Na ulicy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20635310.wav\",\n",
      "    \"duration\": 3.144,\n",
      "    \"text\": \"Ktoś stał przy nim.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20635311.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"— Patrz pan! — przerwała mi, wskazując na prawo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20635312.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"— Oto pieczęć — dar mojego ducha.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20635313.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Pogadamy z nią na osobności — rzekł kulawiec.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620293.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"A jak nie, to on jeden.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620295.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Spojrzenie Ani.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620296.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Życie składa się z samych niedziel.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620297.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Śnieg padał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774777.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"— Szczotka jest na dole w izbie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774778.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Obawy jej zaczynają przybierać formy bardziej określone.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774780.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"— Czy w szkole jest ci przyjemnie? — Nie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774783.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Filip był dużym chłopcem, ale nieprzyjemnym.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32808042.wav\",\n",
      "    \"duration\": 5.328,\n",
      "    \"text\": \"Jest to jeden z najbardziej wrażliwych obszarów w konstytucji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32808043.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"Poznałem go w trakcie fascynującej kolacji w Brukseli i bardzo mi zaimponował\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32808044.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"po pierwsze, jak mają Państwo zamiar określić kryteria?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32808045.wav\",\n",
      "    \"duration\": 8.352,\n",
      "    \"text\": \"Potrzebujemy europejskiego regulatora, a w stosownym czasie przyda się europejski prokurator\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21088261.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"Zeznania piwniczego były proste, jasne i robiły wrażenie szczerych.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21088263.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Kto wie, czy nie przyjemniejsze niż pęcznienie brzuszka ze śmiechu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21088264.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"Ale nie było odpowiedzi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21088265.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"To przyniosłoby nieszczęście żywym!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20655888.wav\",\n",
      "    \"duration\": 4.08,\n",
      "    \"text\": \"Prawda? Biedny Bóg.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20655890.wav\",\n",
      "    \"duration\": 5.52,\n",
      "    \"text\": \"Ogół kobiet, jeśli chodzi o miłość, jest przerażająco niesentymentalny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20655891.wav\",\n",
      "    \"duration\": 4.728,\n",
      "    \"text\": \"Potem powiedział: — Pogadamy o tym dokładnie wieczorem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20655893.wav\",\n",
      "    \"duration\": 4.128,\n",
      "    \"text\": \"Zerka co chwilę na elegancki zegarek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21604051.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"Aż pewnego razu straszna burza rozszalała się na morzu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21604053.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Lecz to nic nie pomagało.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21604054.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"No, teraz, kochana żono, dowiedziałem się, co to jest strach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21604055.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Tymczasem wzburzenie wśród ludu rosło.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612387.wav\",\n",
      "    \"duration\": 7.584,\n",
      "    \"text\": \"— Powtarzam: Niech polityką zajmują się przynajmniej specjaliści.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612390.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Zresztą lepiej się myśli w drodze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612391.wav\",\n",
      "    \"duration\": 4.776,\n",
      "    \"text\": \"Ktoś goni po przedpokoju.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612393.wav\",\n",
      "    \"duration\": 8.136,\n",
      "    \"text\": \"On znał każdy labiryncik jej psychiki i rów nocześnie odkrywał coraz nowe.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20671824.wav\",\n",
      "    \"duration\": 4.848,\n",
      "    \"text\": \"Ona była wściekła i zmęczona poznawaniem tylu ludzi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20671826.wav\",\n",
      "    \"duration\": 4.632,\n",
      "    \"text\": \"Jak to, więc tak dużo tu czegoś?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20671828.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Tego spotkania, po którym nie mogła już od niego odejść.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20671829.wav\",\n",
      "    \"duration\": 5.232,\n",
      "    \"text\": \"Strzelano jak na manewrach, z zimną krwią i celnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615018.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Nie popsuła? — spytał kulawiec.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615020.wav\",\n",
      "    \"duration\": 9.096,\n",
      "    \"text\": \"Lecz istota przejawu pozostaje ta sama: zła, występna i tajemnicza.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615022.wav\",\n",
      "    \"duration\": 5.28,\n",
      "    \"text\": \"— Idę do domu, możesz mnie odprowadzić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615023.wav\",\n",
      "    \"duration\": 6.312,\n",
      "    \"text\": \"— Czy tylko możliwym jest, by letarg trwał tak długo?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608817.wav\",\n",
      "    \"duration\": 4.488,\n",
      "    \"text\": \"Można tu wyczuć pewne jakby stopniowanie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608818.wav\",\n",
      "    \"duration\": 4.368,\n",
      "    \"text\": \"Kobieta rozejrzała się nerwowo i zmrużyła oczy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608819.wav\",\n",
      "    \"duration\": 5.088,\n",
      "    \"text\": \"— No, a teraz, panienko, czas wstawać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608821.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Czy widziałeś kiedy prywatny wagon?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609720.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"A więc byłem aresztowany!…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609722.wav\",\n",
      "    \"duration\": 2.424,\n",
      "    \"text\": \"Milczenie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609723.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"W celu zdobycia dalszych wskazówek zachęcam do kontaktu telefonicznego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609724.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Dopiero na końcu tego rozdziału będzie mowa o szlachetności Michała.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26331632.wav\",\n",
      "    \"duration\": 8.28,\n",
      "    \"text\": \"Komisja mówi, że traktuje je bardzo poważnie, ale to za mało\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26331634.wav\",\n",
      "    \"duration\": 8.496,\n",
      "    \"text\": \"Takie rozwiązanie jest złe i dlatego nasza delegacja zagłosowała przeciwko przyjęciu przedmiotowego sprawozdania\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26331635.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Przede wszystkim, jeżeli mamy wprowadzić medyczne e-usługi, musimy wprowadzić uznawanie kwalifikacji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26331637.wav\",\n",
      "    \"duration\": 6.444,\n",
      "    \"text\": \"Jednak lepiej, że je opracowaliśmy, niż gdybyśmy niczego nie zmienili\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28100725.wav\",\n",
      "    \"duration\": 8.568,\n",
      "    \"text\": \"Jest to prawdopodobnie obszar, który można dalej rozwijać\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28100726.wav\",\n",
      "    \"duration\": 8.208,\n",
      "    \"text\": \"Ten tydzień poświęcono na kuluarowe rozgrywki\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28100729.wav\",\n",
      "    \"duration\": 6.48,\n",
      "    \"text\": \"Jakie są najlepsze warunki dla przeprowadzenia wyborów?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28100730.wav\",\n",
      "    \"duration\": 2.448,\n",
      "    \"text\": \"Na co?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614397.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Po chwili do pokoju weszła jakaś Chinka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614399.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Nie bardzo miłe sąsiedztwo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614400.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Pałac Branickich jest zabytkiem wartym obejrzenia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614403.wav\",\n",
      "    \"duration\": 2.136,\n",
      "    \"text\": \"Masz ładną skórę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633740.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Ach, co za rozkosz!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633741.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"— Służę panu — odpowiedział grzecznie, strzepując popiół z cygara.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633742.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Potem zrobił w ścianie dziurę gwoździem na znak tego zdarzenia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633743.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Na pożegnanie wręczyła mu swoją gabinetową fotografię, zdjętą przed paru dniami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25755429.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"Mówię wam, że z tego nic nie będzie!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25755431.wav\",\n",
      "    \"duration\": 5.76,\n",
      "    \"text\": \"Drobiu hodowało się mnóstwo i bardzo szczęśliwie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25755432.wav\",\n",
      "    \"duration\": 3.888,\n",
      "    \"text\": \"Spojrzałem do koła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25755433.wav\",\n",
      "    \"duration\": 6.156,\n",
      "    \"text\": \"Zaprzeczy pan temu... Hrabia milczał i dopiero po chwili odezwał się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32662136.wav\",\n",
      "    \"duration\": 6.768,\n",
      "    \"text\": \"I wreszcie Komisja powinna dążyć do rozluźnienia rozporządzenia finansowego\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32662137.wav\",\n",
      "    \"duration\": 4.932,\n",
      "    \"text\": \"Europa, w którą wierzę, jest również Europą różnorodności językowej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32662138.wav\",\n",
      "    \"duration\": 6.444,\n",
      "    \"text\": \"Celem wniosku jest zmniejszenie administracyjnego obciążenia w przedsiębiorstwach związanych z żywnością\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_32662141.wav\",\n",
      "    \"duration\": 5.688,\n",
      "    \"text\": \"Różne zagadnienia poruszone w tym sprawozdaniu wymagają dalszej szczegółowej debaty\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35727790.wav\",\n",
      "    \"duration\": 5.94,\n",
      "    \"text\": \"Pilnie potrzebne jest budowanie zaufania\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35727791.wav\",\n",
      "    \"duration\": 4.86,\n",
      "    \"text\": \"Wprowadziliśmy kary za oszustwa\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35727792.wav\",\n",
      "    \"duration\": 4.14,\n",
      "    \"text\": \"Takie jest moje życzenie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_35727793.wav\",\n",
      "    \"duration\": 3.348,\n",
      "    \"text\": \"Dziękuję wam za wszystko\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633503.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"Co wy jesteście za jedni?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633505.wav\",\n",
      "    \"duration\": 4.128,\n",
      "    \"text\": \"Kupiłem babci bukiet goździków.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633506.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Więc on się koło mnie położył i leżał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633507.wav\",\n",
      "    \"duration\": 6.48,\n",
      "    \"text\": \"Oni usiłowali prowadzić z nią rozmowy i udawało im się czasem objąć ją wpół.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20772874.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Zdumiewało go jej wyrafinowanie erotyczne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20772875.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"— Dokąd płyniemy? — rzuciłem odruchowo pytanie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20772877.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"Przede wszystkim — znikły wszelkie towary.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20772878.wav\",\n",
      "    \"duration\": 4.776,\n",
      "    \"text\": \"— Połączenie dokonane — rzekł opuszczając rękę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20651421.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Cztery dni na skrawku przestrzeni bez wyjścia wobec zalewającego żywiołu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20651422.wav\",\n",
      "    \"duration\": 3.456,\n",
      "    \"text\": \"Otwieram z łomotem tylne drzwi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20651423.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"Więc on się koło mnie położył i leżał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20651424.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"— Napatrzysz się jeszcze niejednego, zanim odbędziesz całą przeprawę!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612263.wav\",\n",
      "    \"duration\": 5.472,\n",
      "    \"text\": \"Z chęci pieszczenia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612264.wav\",\n",
      "    \"duration\": 8.064,\n",
      "    \"text\": \"Osobista współpraca zbyteczna — recytował ogłoszenie, którego się nauczył na pamięć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612265.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"Co dzień tu przychodzić będę — oświadczył Radek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612267.wav\",\n",
      "    \"duration\": 5.4,\n",
      "    \"text\": \"Czuję dookoła siebie złe, wrogie mi wiry.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609801.wav\",\n",
      "    \"duration\": 6.096,\n",
      "    \"text\": \"— Dokąd płyniemy? — zapytałem, ślizgając się spojrzeniem po rozlewisku wód.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609802.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Wszyscy żywili dlań jak największą cześć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609803.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Nagroda przyznawana jest jedynie za tytuły przetłumaczone na język polski.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609804.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Zerka co chwilę na elegancki zegarek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22245875.wav\",\n",
      "    \"duration\": 3.0,\n",
      "    \"text\": \"tak\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22245876.wav\",\n",
      "    \"duration\": 2.736,\n",
      "    \"text\": \"Firefox\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22245879.wav\",\n",
      "    \"duration\": 2.304,\n",
      "    \"text\": \"nie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22245881.wav\",\n",
      "    \"duration\": 2.376,\n",
      "    \"text\": \"zero\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20682669.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Dżonki chińskie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20682670.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Dlatego go lubię.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20682672.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"Ogień w klasztorze?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20682673.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"— One są jak Bernard.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41649323.wav\",\n",
      "    \"duration\": 8.82,\n",
      "    \"text\": \"Czy priorytety polityki współpracy Unii Europejskiej i instytucji międzynarodowych są właściwe?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41649325.wav\",\n",
      "    \"duration\": 8.208,\n",
      "    \"text\": \"Wszystko to zawarte jest w kwestii, którą przedłożyliśmy wraz z innymi rzymskimi parlamentarzystami\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41649326.wav\",\n",
      "    \"duration\": 6.768,\n",
      "    \"text\": \"Jak powinniśmy zarządzać naszymi zasobami w wymiarze długoterminowym?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41649327.wav\",\n",
      "    \"duration\": 8.748,\n",
      "    \"text\": \"Podczas Pańskiej prezydencji dołożono jednak wysiłków, by zadowolić rynki finansowe i wielkich akcjonariuszy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616692.wav\",\n",
      "    \"duration\": 9.192,\n",
      "    \"text\": \"To wystarczyło, aby się Emil nią zainteresował.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616693.wav\",\n",
      "    \"duration\": 7.992,\n",
      "    \"text\": \"I on to zrobił bez prezerwatywy, zresztą mam już miesiączkę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616695.wav\",\n",
      "    \"duration\": 4.368,\n",
      "    \"text\": \"A zakotłowało się w głowie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616696.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"Zaciągnąłem się wraz z innymi i wyprawiono mnie do hacjendy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26990474.wav\",\n",
      "    \"duration\": 5.436,\n",
      "    \"text\": \"Całe sprawozdanie jednak zaprzecza temu oświadczeniu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26990475.wav\",\n",
      "    \"duration\": 3.168,\n",
      "    \"text\": \"Liczę na wasze wsparcie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26990477.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"mów prawdę i dotrzymuj słowa\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26990478.wav\",\n",
      "    \"duration\": 10.08,\n",
      "    \"text\": \"Nadal popierać będę pracowników i związkowców w ich walce przeciw podniesieniu wieku emerytalnego\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775124.wav\",\n",
      "    \"duration\": 4.848,\n",
      "    \"text\": \"Ważne jest by często nawadniać organizm.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775125.wav\",\n",
      "    \"duration\": 7.632,\n",
      "    \"text\": \"Rozumiem! — rzekł z zachwytem, czując, że otucha wstępuje mu do duszy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775126.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Było to podczas obiadu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775127.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Nigdy więcej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605671.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Upiór! — poprawił go niewczesny kulawiec.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605686.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"Jej nozdrza drgały.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605714.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"Przecież tego nie wyrzucę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605741.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Ściany pochylają się nade mną i wyginają, jak widziane przez wodę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610325.wav\",\n",
      "    \"duration\": 6.864,\n",
      "    \"text\": \"— Nie wstydź się, ja też nie bardzo umiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610327.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Oczywiście nie w chwili samego gimnastykowania się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610328.wav\",\n",
      "    \"duration\": 7.296,\n",
      "    \"text\": \"— Opowiedz im całą historię, mości Ryszardzie — wtrącił się Puk.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610329.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"— Dziwny przypadek — powiedział poprzez wiatr Emil.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632015.wav\",\n",
      "    \"duration\": 6.096,\n",
      "    \"text\": \"Wie, ile dokładnie czasu potrzebuje na dotarcie swoim tempem na uczelnię.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632017.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"Przynieś no wiadro, Tomaszu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632018.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Nikt nie ma dość rozumu na to, by rzecz właściwą zrobić w odpowiednim czasie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632019.wav\",\n",
      "    \"duration\": 3.144,\n",
      "    \"text\": \"Emil zobaczył go, jak spał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775333.wav\",\n",
      "    \"duration\": 8.184,\n",
      "    \"text\": \"Czuł się jak wykolejeniec…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775335.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Na pamiątkę, dziewulinko? — spytał domyślnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775337.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"— Każecie odejść? — pyta się Maciuś.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775339.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Jest w tej nieszczęśliwej coś niepokojącego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637456.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Nie wierzę w nią ani trochę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637458.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"— Nie cierpię czarnych rzeczy — zawołała Maria.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637459.wav\",\n",
      "    \"duration\": 7.536,\n",
      "    \"text\": \"Siedzieli wczoraj wieczorem w parku i trzymali się jak zakochani za ręce.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20637460.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"— Jesteśmy na miejscu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20772371.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Ach, jakże mi brak tu zieleni!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20772372.wav\",\n",
      "    \"duration\": 5.52,\n",
      "    \"text\": \"Powiedziałem jej zaraz o tobie, ale wybuchnęła tylko śmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20772373.wav\",\n",
      "    \"duration\": 3.552,\n",
      "    \"text\": \"Nieważne, na ja kim.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20772376.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Dusza Fauna — to sen o śnie, sen posępny i niespokojny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28159871.wav\",\n",
      "    \"duration\": 7.956,\n",
      "    \"text\": \"Jak wyraźnie i precyzyjnie dziś podkreślił, są to oferty opcjonalne\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28159872.wav\",\n",
      "    \"duration\": 9.288,\n",
      "    \"text\": \"Bieżące wydarzenia są niepowodzeniem dla tych, którzy wierzą w niepohamowane siły wolnego rynku\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28159873.wav\",\n",
      "    \"duration\": 4.68,\n",
      "    \"text\": \"Być może nie wyjaśniłem tego wcześniej do końca\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28159874.wav\",\n",
      "    \"duration\": 3.42,\n",
      "    \"text\": \"O tym należy pamiętać\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28261785.wav\",\n",
      "    \"duration\": 4.86,\n",
      "    \"text\": \"Występują problemy i trudności życia codziennego\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28261786.wav\",\n",
      "    \"duration\": 3.6,\n",
      "    \"text\": \"Teraz jednak musimy spojrzeć w przyszłość\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28261787.wav\",\n",
      "    \"duration\": 6.372,\n",
      "    \"text\": \"Jestem pewien, że nowe przepisy pomogą w realizowaniu priorytetów polityki spójności\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28261790.wav\",\n",
      "    \"duration\": 6.912,\n",
      "    \"text\": \"W Polsce kobiety są bardziej dotknięte bezrobociem niż mężczyźni, zwłaszcza na wsi\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633735.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"— Pełnia winy może być tylko tam, gdzie istnieje premedytacja.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633736.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"A czy byś został, gdybym… gdybym zrobiła się lepsza?…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633737.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Cudowna celowość natury.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633738.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Patrzyłem na jego ruchy osłupiały.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20838539.wav\",\n",
      "    \"duration\": 7.584,\n",
      "    \"text\": \"— Ja… o, nie mów tak, i ja znosiłam to…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20838540.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Obfity kark Cherokee był jedynym miejscem, do którego sięgnąć mógł Biały Kieł.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20838541.wav\",\n",
      "    \"duration\": 8.064,\n",
      "    \"text\": \"Nie, nie, bez sądu nawet ludzie nie oddają zbrodniarza katom.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20838544.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Jak radośnie się zadziwi!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20776486.wav\",\n",
      "    \"duration\": 8.544,\n",
      "    \"text\": \"On przemawiał do siebie: — Emil, uspokój się, głaskam cię po włosach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20776489.wav\",\n",
      "    \"duration\": 7.584,\n",
      "    \"text\": \"Cała skala uczuć, od najsubtelniejszych do najpotworniejszych, ale jakże dziko spotęgowana.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20776490.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Podczas śniadania zobaczył, że narzeczony Krystyny jest dziobaty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20776491.wav\",\n",
      "    \"duration\": 9.456,\n",
      "    \"text\": \"Poprawił się na poduszkach, wyciągnął nogi przed siebie i zapalił cygaro.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648364.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Ale ja wiem, że ona nie lubi żadnego ruszania.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648366.wav\",\n",
      "    \"duration\": 6.096,\n",
      "    \"text\": \"Ale nie mógł prowadzić rozmowy, której przedtem nie obmyślił szczegółowo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648367.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"Jak się to pisze?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648368.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"— W co? — W klasy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25114414.wav\",\n",
      "    \"duration\": 4.608,\n",
      "    \"text\": \"Wszystkiego miałem tylko jednego melona i dwa arbuzy,“ rzekł Tomek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25114416.wav\",\n",
      "    \"duration\": 3.6,\n",
      "    \"text\": \"Niektórzy z was są tacy nudni, aż spać mi się chce...\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25114417.wav\",\n",
      "    \"duration\": 2.808,\n",
      "    \"text\": \"Wokulski zaczął się rozbierać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25114418.wav\",\n",
      "    \"duration\": 2.7,\n",
      "    \"text\": \"zbytnio sobie nie dufaj.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20688422.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Krys tyna powiedziała: Wejdź.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20688423.wav\",\n",
      "    \"duration\": 8.736,\n",
      "    \"text\": \"— Dokąd płyniemy? — zapytałem, ślizgając się spojrzeniem po rozlewisku wód.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20688424.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"Ryczę ze śmiechu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20688425.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"Gówno.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20652585.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Kiedy są kolejne wybory?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20652587.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"Różne rodzaje ciemności, poprze- rzynane błyskawicami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20652588.wav\",\n",
      "    \"duration\": 5.088,\n",
      "    \"text\": \"Nikt inny nie wpadłby na taki pomysł!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20652589.wav\",\n",
      "    \"duration\": 3.888,\n",
      "    \"text\": \"Obudził mnie śpiew ptaków.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24304505.wav\",\n",
      "    \"duration\": 4.68,\n",
      "    \"text\": \"Zamykam się w moim pokoju...\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24304506.wav\",\n",
      "    \"duration\": 3.888,\n",
      "    \"text\": \"Będziemy czytać to tylko, co się nam podoba.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24304507.wav\",\n",
      "    \"duration\": 3.96,\n",
      "    \"text\": \"O świcie zaczynał śpiewać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24304508.wav\",\n",
      "    \"duration\": 2.808,\n",
      "    \"text\": \"Chytra z ciebie dziewka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638541.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Jak rozwiązujemy kwestię zakwaterowania?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638542.wav\",\n",
      "    \"duration\": 3.072,\n",
      "    \"text\": \"— Czego mamy zazdrościć?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638543.wav\",\n",
      "    \"duration\": 5.76,\n",
      "    \"text\": \"Potrzeba wyrzeczenia się — tylko za tę cenę można pokonać to wszystko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638544.wav\",\n",
      "    \"duration\": 4.08,\n",
      "    \"text\": \"Gwarantuje to chyba dobroć tego opisu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617525.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Do wieczora obrazi się jeszcze dziesięć razy albo i więcej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617526.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Nie zastępowali tego gwarą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617529.wav\",\n",
      "    \"duration\": 3.456,\n",
      "    \"text\": \"To była własność cudza!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617534.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Już od lat kilku w lesie przebywa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775031.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Warszawa jest pięknym miastem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775034.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Mam się nachylić? — spytał pokornie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775035.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Wzruszył ramionami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775038.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Bardzo wysoko ubezpieczony!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608807.wav\",\n",
      "    \"duration\": 8.424,\n",
      "    \"text\": \"Ona popatrzyła na jego twarz i przestraszyła się: była tak zmieniona, upiorna.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608808.wav\",\n",
      "    \"duration\": 6.816,\n",
      "    \"text\": \"Próżno chłopak namawiał i za uzdę ciągnął, i wózek popychał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608809.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"— Tutaj wieją dziwne wiatry.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608811.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Potem obróciłam się do ściany i chciałam spać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774282.wav\",\n",
      "    \"duration\": 6.504,\n",
      "    \"text\": \"Są sytuacje w życiu, w których te towarzyskie dodatki winny odpaść.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774283.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Jedne duże, że dwóch może się wozić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774284.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Słuchasz mnie w ogóle?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774285.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Absolutnie nie chciała, aby „on sobie coś myślał”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20662829.wav\",\n",
      "    \"duration\": 6.504,\n",
      "    \"text\": \"W ołtarzyku, wśród polnych kwiatów, wisi fotografia Ewy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20662831.wav\",\n",
      "    \"duration\": 2.976,\n",
      "    \"text\": \"Zobaczymy, czy nagle nie runie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20662832.wav\",\n",
      "    \"duration\": 1.944,\n",
      "    \"text\": \"A jeśli nie?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20662833.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"Posłanie było nadspodziewanie wygodne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607478.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Ręce za szybą i grysik, którym go karmiła służąca Marysia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607479.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"Siedziałem i rozmyślałem długo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607480.wav\",\n",
      "    \"duration\": 7.536,\n",
      "    \"text\": \"Podlasiak skrzyżował dłonie na żołędnych wzorach zbryzganej słońcem kamizeli.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607482.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"Lubiłem wygarnąć po nocy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31828918.wav\",\n",
      "    \"duration\": 9.72,\n",
      "    \"text\": \"Jedna trzecia sprzedawców odmawia realizacji dostaw towarów za granicę, szczególnie do nowych państw członkowskich\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31828919.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Chiny muszą się pogodzić z istnieniem takiej dyskusji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31828921.wav\",\n",
      "    \"duration\": 5.868,\n",
      "    \"text\": \"Moim zdaniem całkowity zakaz to właściwe podejście\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31828925.wav\",\n",
      "    \"duration\": 10.476,\n",
      "    \"text\": \"Grupa Europejskiej Partii Ludowej wzywa wszystkie państwa członkowskie do pełnego uczestnictwa w przedmiotowej debacie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616308.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Do Włoch najlepiej dojechać przez Niemcy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616312.wav\",\n",
      "    \"duration\": 6.816,\n",
      "    \"text\": \"Przede wszystkim prosto, przy tym szczerze, no i co najważniejsza — przyjaźnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616314.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Czy widziałeś kiedy prywatny wagon?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616321.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"— Zróbmy lepiej tak: niech każdy rzuci pięć razy do celu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23089151.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Udzielone mi były uświadomienia najrzadszego rodzaju.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23089152.wav\",\n",
      "    \"duration\": 4.536,\n",
      "    \"text\": \"A ja tylko chcę spytać o której wracasz z roboty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23089154.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Przypuszczając, że matki nie umarłyby przed tem ze zgrozy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23089156.wav\",\n",
      "    \"duration\": 6.624,\n",
      "    \"text\": \"Nieprzytomny prawie utkwiłem wzrok na jakiejś malowanej postaci mnicha w sąsiedniej kaplicy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27439943.wav\",\n",
      "    \"duration\": 5.22,\n",
      "    \"text\": \"Wyzwania, które przed nami stoją, są całkiem nowe\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27439945.wav\",\n",
      "    \"duration\": 7.956,\n",
      "    \"text\": \"Wstrzymałem się od głosu, ponieważ w sprawozdaniu niedostatecznie szczegółowo podchodzi się do rzeczywistych problemów\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27439946.wav\",\n",
      "    \"duration\": 7.236,\n",
      "    \"text\": \"Uczestniczymy w tworzeniu prawodawstwa dla krajów europejskich i ich obywateli\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27439948.wav\",\n",
      "    \"duration\": 7.488,\n",
      "    \"text\": \"Sektor usług, jak sam przyznał, jest najważniejszym sektorem prawie wszędzie na świecie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616645.wav\",\n",
      "    \"duration\": 6.12,\n",
      "    \"text\": \"Powiedziałem to przy innych mężczyznach\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616650.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Wyglądają jak dołki i rowki, powstałe od nakłucia szpilką.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616655.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Zmianę ekspozycji mamy w czerwcu, więc na pół roku można obejrzeć dwie wystawy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616660.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Rozmawiają o tym, o owym.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617236.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"Był piękny w swej barwie, rozległości, ciszy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617238.wav\",\n",
      "    \"duration\": 6.36,\n",
      "    \"text\": \"Zrobiłaby teraz wszystko, czego by chciał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617239.wav\",\n",
      "    \"duration\": 3.288,\n",
      "    \"text\": \"Spałam do południa\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617240.wav\",\n",
      "    \"duration\": 4.08,\n",
      "    \"text\": \"Stracił całą ochotę na nią.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20730400.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Kogoś mi przypominała.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20730401.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"— Wszystko jedno — machnął obojętnie ręką.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20730402.wav\",\n",
      "    \"duration\": 3.768,\n",
      "    \"text\": \"Lubię spać przy otwartym oknie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20730403.wav\",\n",
      "    \"duration\": 6.864,\n",
      "    \"text\": \"Świat pełen jest larw i masek zrodzonych w ten sposób.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775250.wav\",\n",
      "    \"duration\": 8.184,\n",
      "    \"text\": \"W punktach kulminacyjnych robił diminuen- da, co było jego nowym odkryciem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775251.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Trudno skończyć, gdy się zaczyna.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775253.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Nie możecie nas tu zamknąć!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775254.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Trzy razy na dzień byłem świadkiem ceremoniału ablucji.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606493.wav\",\n",
      "    \"duration\": 3.456,\n",
      "    \"text\": \"Cha, cha, cha!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606527.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"Prawdą jest wszystko!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606537.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Musimy trochę zaczekać, aż któraś podpłynie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606550.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Podbiegał do tego, kogo się bał, aby już szybko był z tym koniec.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21643509.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"W pokoju rozległ się odgłos silnego uderzenia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21643510.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Miał czarne włosy i był wysmukły, z niewielką czarną brodą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21643511.wav\",\n",
      "    \"duration\": 7.464,\n",
      "    \"text\": \"Powoli, lecz zwinnie manewrował koło studenta i przyciągał go niepostrzeżenie do swego rogu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21643512.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Poczuł w sobie nagle jakąś ulgę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37414186.wav\",\n",
      "    \"duration\": 8.136,\n",
      "    \"text\": \"W którymś momencie będziemy musieli się ograniczyć do tych, które są niezbędne\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37414187.wav\",\n",
      "    \"duration\": 6.48,\n",
      "    \"text\": \"Do celów tego ostatniego czytania na posiedzeniu plenarnym zgłoszonych zostało osiem poprawek\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37414188.wav\",\n",
      "    \"duration\": 6.048,\n",
      "    \"text\": \"Obecnie prezydencja hiszpańska zbliża się ku końcowi, gdyż zostało jej jeszcze pięć tygodni\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37414189.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"Kolejna istotna idea zawarta w rezolucji to zdolność do integracji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647634.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Co mi tam!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647636.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Ktoś goni po przedpokoju.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647637.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Nikt, jak ona, nie tańczył z takim wdziękiem walca, oberka, mazura.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647639.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Czy można mieć pytania?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622761.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Pierś była jędrna i młoda.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622763.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Biały ogier arabski.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622766.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Bo pies też lubi towarzystwo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622768.wav\",\n",
      "    \"duration\": 8.736,\n",
      "    \"text\": \"Cztery dni temu budowałem schron z całym systemem sznurków zamykających prymitywne klapy i zasłony.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20770608.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"Pozorną lub prawdziwą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20770609.wav\",\n",
      "    \"duration\": 6.984,\n",
      "    \"text\": \"— Ja pozostanę tutaj; będę oczekiwał twego powrotu tu w tym fotelu!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20770610.wav\",\n",
      "    \"duration\": 2.376,\n",
      "    \"text\": \"Nie mam mowy!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20770611.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Na szczęście wiatru nie było, mróz zatem nie dokuczał zbytnio.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23651459.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Czy P. myśli, że mój mąż by mi je zostawił?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23651460.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"W końcu wybiła piąta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23651461.wav\",\n",
      "    \"duration\": 5.88,\n",
      "    \"text\": \"Zapomniałem, że takie zwierzęta są na ziemi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23651462.wav\",\n",
      "    \"duration\": 2.736,\n",
      "    \"text\": \"Z trwogą prawie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21092525.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Jest godzina dwudziesta pierwsza dwadzieścia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21092526.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"Bzik minął.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21092527.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Bluźnierstwo na bliskim wschodzie, obraza uczuć religijnych w Polsce.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21092528.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Toteż młodsze dziewczynki uwielbiały Sarę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_33672424.wav\",\n",
      "    \"duration\": 2.88,\n",
      "    \"text\": \"Wiemy, czego chcemy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_33672425.wav\",\n",
      "    \"duration\": 7.488,\n",
      "    \"text\": \"Wyniki tego, co Komisja chciała rozpocząć wraz z kodeksem postępowania, są bardzo ograniczone\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_33672426.wav\",\n",
      "    \"duration\": 6.12,\n",
      "    \"text\": \"Wciąż ukazują się nowe doniesienia opisujące traktowanie uchodźców birmańskich przybywających do Malezji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_33672427.wav\",\n",
      "    \"duration\": 5.4,\n",
      "    \"text\": \"Reformy umożliwią również podmiotom gospodarczym inwestycje w sieci nowej generacji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618353.wav\",\n",
      "    \"duration\": 8.304,\n",
      "    \"text\": \"Zwierzę, któremu utkwiła strzała w grzbiecie; tarza się, biega, ryczy, pluje, krew zalewa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618354.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Wystarczy zbudować drewniany barak dla Maciusia i straży.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618356.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Była też bardzo ciekawa, co z tego wyniknie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618359.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"Naturalnie, nie powiesz mi o tym.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620786.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"— No, na upór nie ma lekarstwa, może was inni przekonają.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620788.wav\",\n",
      "    \"duration\": 7.104,\n",
      "    \"text\": \"Do jutra wystarczy — oświadczył jednoręki i po namyśle dodał: — Do południa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620789.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Każdy z nich miał niezmierną ochotę pogadać szczerze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620790.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"Są to stany poprzedzające omdlenie spowodowane nadmiarem narkotyku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639207.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"Jedna tylko pozostała osoba: sześćdziesiąta i piąta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639208.wav\",\n",
      "    \"duration\": 6.216,\n",
      "    \"text\": \"Gdzieś przed nami powinno majaczyć takie światełko, do którego zmierzamy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639209.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Widzę wielki gmach z czerwonej cegły, zwrócony do mnie kantem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639210.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"Jak studnia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771673.wav\",\n",
      "    \"duration\": 5.088,\n",
      "    \"text\": \"Maciuś przemył i przewiązał ranę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771674.wav\",\n",
      "    \"duration\": 6.768,\n",
      "    \"text\": \"Jest to bóg nierównowagi, w której wirują nieskończone byty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771676.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Może jest pan moim rodakiem?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771677.wav\",\n",
      "    \"duration\": 6.36,\n",
      "    \"text\": \"Odetchnął z pewną ulgą: Darek nie zabrał ze sobą strzelby!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620031.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Jednoręki spoważniał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620032.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Dla dwu ludzi znalazło się jeszcze miejsce.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620033.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"I wyprowadziłem go przez ogród na ulicę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20620034.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"Nie poruszał się, gdy weszła matka, pokojówka Janka i stróż Antoni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23809138.wav\",\n",
      "    \"duration\": 6.432,\n",
      "    \"text\": \"Zirytowana hrabina kazała jechać do domu, nie czekając końca wyścigów.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23809139.wav\",\n",
      "    \"duration\": 4.008,\n",
      "    \"text\": \"Koniec końców: jestem tu i basta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23809140.wav\",\n",
      "    \"duration\": 3.456,\n",
      "    \"text\": \"„Jak ja to mam rozumieć?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23809141.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"W odpowiedzi Wokulski usiadł przy małym stoliku pod ścianą i zaczął oglądać album.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24776903.wav\",\n",
      "    \"duration\": 8.28,\n",
      "    \"text\": \"„Teraz weźmiemy się do nogi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24776904.wav\",\n",
      "    \"duration\": 4.284,\n",
      "    \"text\": \"Teraz będziecie zdrowi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24776905.wav\",\n",
      "    \"duration\": 9.216,\n",
      "    \"text\": \"Kartofle były niedogotowane, bo się z nimi spieszyła, żeby nie czekały szparagi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24776906.wav\",\n",
      "    \"duration\": 5.724,\n",
      "    \"text\": \"Nie mogę sobie przypomnieć, czym kogo widział tak odpowiedniego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40924540.wav\",\n",
      "    \"duration\": 6.948,\n",
      "    \"text\": \"W erze globalizacji powinniśmy starać się urzeczywistnić wspólną politykę imigracyjną\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40924542.wav\",\n",
      "    \"duration\": 6.444,\n",
      "    \"text\": \"Pojawiają się także kłopoty związane z przygotowaniami do zimowych igrzysk olimpijskich w Soczi\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40924543.wav\",\n",
      "    \"duration\": 7.344,\n",
      "    \"text\": \"Musimy zapewnić europejskim pracownikom możliwość dostosowania się do wymogów gospodarki\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40924544.wav\",\n",
      "    \"duration\": 6.66,\n",
      "    \"text\": \"Unia Europejska przekonuje swoich obywateli, że istnieje po to, by utrwalać pokój w Europie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20650579.wav\",\n",
      "    \"duration\": 6.84,\n",
      "    \"text\": \"Bawcie się dobrze, pantoflarze\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20650580.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Ojciec jęczy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20650581.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"— Tylko zdaje mi się, nosił pan do niedawna jeszcze inny mundur.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20650582.wav\",\n",
      "    \"duration\": 5.832,\n",
      "    \"text\": \"Z trwogą podawano sobie wiadomość o stopniu ich gwałtowności.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37327070.wav\",\n",
      "    \"duration\": 8.46,\n",
      "    \"text\": \"Pakiet telekomunikacyjny stanowi poważny wkład w europejski plan naprawy gospodarczej poprzez tworzenie sieci\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37327073.wav\",\n",
      "    \"duration\": 5.94,\n",
      "    \"text\": \"wszakże jest twoim kochankiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37327074.wav\",\n",
      "    \"duration\": 3.456,\n",
      "    \"text\": \"Przemysł kulturalny w Europie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37327076.wav\",\n",
      "    \"duration\": 5.4,\n",
      "    \"text\": \"Jednak pomimo tej filozoficznej uwagi, zaczął liczyć sekundy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619711.wav\",\n",
      "    \"duration\": 9.144,\n",
      "    \"text\": \"— Myślałem, że dzieci są dobre, tylko nieszczęśliwe.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619713.wav\",\n",
      "    \"duration\": 5.232,\n",
      "    \"text\": \"— Byłem w jego gabinecie, urągał mi…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619714.wav\",\n",
      "    \"duration\": 7.848,\n",
      "    \"text\": \"Przez szyby dojrzałem wkrótce białe czoło, brwi ciemne, wiśniowe usta…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20619716.wav\",\n",
      "    \"duration\": 4.008,\n",
      "    \"text\": \"Dalej, ruszaj się!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607343.wav\",\n",
      "    \"duration\": 10.176,\n",
      "    \"text\": \"Od zawsze jeździłem na nartach, ale może w tym roku spróbuję na snowboardzie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607344.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"— Mój mąż — dokończyła z dziwnym, nie znanym mi dotychczas uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607345.wav\",\n",
      "    \"duration\": 6.936,\n",
      "    \"text\": \"Podlasiak zamilkł i palcem potarł sęk nad prawym okiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607347.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Zero szacunku dla wykształconego człowieka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613866.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Czy być może?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613877.wav\",\n",
      "    \"duration\": 7.224,\n",
      "    \"text\": \"Nie bój się wora, dziewczyco! Już nie powrócisz do niego! — pocieszył ją jednoręki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613878.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Nie wątpiłem, że i ona poznała mnie także.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613879.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Mój współlokator i jego gość grają w karty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21318467.wav\",\n",
      "    \"duration\": 7.464,\n",
      "    \"text\": \"Opowiedziałem mu w krótkości swoje przygody i kończyłem właśnie, gdy stanęliśmy u celu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21318468.wav\",\n",
      "    \"duration\": 9.312,\n",
      "    \"text\": \"Kolejnictwo sowieckie, skutkiem braku należytej organizacji, przychodzi stopniowo do upadku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21318469.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Obcięto je znacznie i prawie cały ich ciężar przerzucono na robotników.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21318471.wav\",\n",
      "    \"duration\": 8.376,\n",
      "    \"text\": \"Pytanie padło tak nagle, że dobrze, iż odpowiedź była z góry przygotowaną.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23724340.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"W istocie, zabiłem Bourbona.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23724341.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"Muszę bezwarunkowo dziś jeszcze być w domu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23724343.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Widziałem, jak lżej odetchnął.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23724344.wav\",\n",
      "    \"duration\": 2.304,\n",
      "    \"text\": \"Pożar w domu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30660407.wav\",\n",
      "    \"duration\": 5.688,\n",
      "    \"text\": \"Nie ma żadnych głosów sprzeciwu, jedynie próba zamiecenia tej nowej informacji pod dywan\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30660409.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Chciałbym tylko podzielić się dwoma lub trzema krótkimi uwagami\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30660410.wav\",\n",
      "    \"duration\": 2.88,\n",
      "    \"text\": \"Boska to już sprawa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30660411.wav\",\n",
      "    \"duration\": 3.996,\n",
      "    \"text\": \"Nie ma sensu zaprzeczać, że Europa przechodzi trudny okres\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610330.wav\",\n",
      "    \"duration\": 4.776,\n",
      "    \"text\": \"Zwłaszcza że tak długo mówił Emilowi prawdę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610331.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"— A tak, oczywiście — przyznałem — oba są zabudowane, zwłaszcza ten we Florencji.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610332.wav\",\n",
      "    \"duration\": 7.656,\n",
      "    \"text\": \"Wśród funkcjonariuszy stacyjnych podobno nastrój dla władz nader nieprzychylny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610333.wav\",\n",
      "    \"duration\": 6.072,\n",
      "    \"text\": \"Cóż może mieć wspólnego z człowiekiem wolny naród wilków?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607113.wav\",\n",
      "    \"duration\": 4.8,\n",
      "    \"text\": \"— Jeszcze nie, mój synku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607124.wav\",\n",
      "    \"duration\": 4.488,\n",
      "    \"text\": \"Tak byłoby najciekawiej, najlepiej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607140.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"Łaskawie przyjął ich spojrzenia i wyprostował się uroczyście.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607152.wav\",\n",
      "    \"duration\": 4.872,\n",
      "    \"text\": \"To nie były nogi żywej dziewczyny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606372.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Trudno było sobie wyobrazić\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606374.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"— Przypominam, że prosiłem, aby Maciusia nie nazywać królem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606378.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"O piątej po południu zapaliłem bez wielkiej przyjemności pierwszego papierosa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606380.wav\",\n",
      "    \"duration\": 2.544,\n",
      "    \"text\": \"Dlaczego się śmiejesz?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614889.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Przepraszam, obawiam się, że nie mam pojęcia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614891.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"— Ja nie chcę — rozpłakała się dziewczynka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614892.wav\",\n",
      "    \"duration\": 2.856,\n",
      "    \"text\": \"I mało w tym było pozy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614893.wav\",\n",
      "    \"duration\": 2.736,\n",
      "    \"text\": \"— Nie domyślam się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606167.wav\",\n",
      "    \"duration\": 6.72,\n",
      "    \"text\": \"Byłem jeszcze dzieckiem, ale wiedziałem, co to znaczy, wiedziałem doskonale.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606175.wav\",\n",
      "    \"duration\": 6.744,\n",
      "    \"text\": \"Szukałem odpowiednich produktów oznaczonych etykietami, ale ich nie znalazłem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606183.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Jak długo trwało jej osłupienie?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606205.wav\",\n",
      "    \"duration\": 5.712,\n",
      "    \"text\": \"Nie dać się skusić tej „dobroci” i rżnąć dalej — oto zadanie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604831.wav\",\n",
      "    \"duration\": 5.712,\n",
      "    \"text\": \"Na torebce, którą przyciska do boku, widać kolorową nalepkę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604833.wav\",\n",
      "    \"duration\": 4.272,\n",
      "    \"text\": \"Ale to przecież śmieszny zabobon, Halko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604834.wav\",\n",
      "    \"duration\": 7.224,\n",
      "    \"text\": \"Jak to jest ze zdaniami, powstałymi na podstawie indukcji, pytasz? To nie ma znaczenia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604835.wav\",\n",
      "    \"duration\": 6.048,\n",
      "    \"text\": \"— Masz rację; w chwili gdy usłyszałam dźwięk jego głosu, złudzenie prysło.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608698.wav\",\n",
      "    \"duration\": 6.744,\n",
      "    \"text\": \"Rodzina Halszki z pietyzmem usiłowała podtrzymać jego pierwotny charakter.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608701.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Komary latały dookoła nich.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608703.wav\",\n",
      "    \"duration\": 4.776,\n",
      "    \"text\": \"Prawdopodobnie przez owe trzy dni nie spał wcale.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608705.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Byłyśmy dawniej tak osamotnione, zziębnięte i zgłodniałe, a teraz…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606342.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Policzyłem dni i zrobiło mi się nieswojo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606344.wav\",\n",
      "    \"duration\": 3.888,\n",
      "    \"text\": \"Kto wie, czy nie będziemy przyjaciółmi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606348.wav\",\n",
      "    \"duration\": 1.92,\n",
      "    \"text\": \"- Bez.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606349.wav\",\n",
      "    \"duration\": 4.032,\n",
      "    \"text\": \"Lecz Damian nie był ani nieśmiały, ani zawstydzony.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606448.wav\",\n",
      "    \"duration\": 6.84,\n",
      "    \"text\": \"— Oszczędź mi pan swych dowcipów!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606470.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"A może nie czekać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606490.wav\",\n",
      "    \"duration\": 3.672,\n",
      "    \"text\": \"— Co za zagadkowy splot wydarzeń!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606502.wav\",\n",
      "    \"duration\": 4.2,\n",
      "    \"text\": \"— Proszę — odparł po chwili, podając mu cygaro.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28856123.wav\",\n",
      "    \"duration\": 6.156,\n",
      "    \"text\": \"Spełnienie podjętych zobowiązań stanowiłoby doskonały początek\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28856124.wav\",\n",
      "    \"duration\": 8.676,\n",
      "    \"text\": \"Po drugie, europejska polityka spójności jest kluczowym instrumentem polityki finansowej pozwalającym osiągnąć ten cel\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28856125.wav\",\n",
      "    \"duration\": 5.004,\n",
      "    \"text\": \"Demokracja i wolność opierają się na stosowaniu zasad\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_28856126.wav\",\n",
      "    \"duration\": 5.508,\n",
      "    \"text\": \"Nie jestem w stanie uznać żadnych innych nowych kwestii porządkowych\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605206.wav\",\n",
      "    \"duration\": 6.864,\n",
      "    \"text\": \"Dla kogo dobry, dla tego dobry.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605213.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Jaka praca, taka płaca.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605223.wav\",\n",
      "    \"duration\": 2.784,\n",
      "    \"text\": \"W każdym razie…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605254.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"Dała mi koc, powiedziała, że się wszystkim zajmie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20684376.wav\",\n",
      "    \"duration\": 6.288,\n",
      "    \"text\": \"— Rano mycie, wieczorem mycie, przed jedzeniem mycie!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20684377.wav\",\n",
      "    \"duration\": 5.112,\n",
      "    \"text\": \"— Tak, tak — tym dziwniejsza.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20684378.wav\",\n",
      "    \"duration\": 4.728,\n",
      "    \"text\": \"Niby nic się nie zmieniło.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20684379.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Kto pierwszy ten lepszy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613846.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Szereg komnat, które zmieniają się w cyrk podziemny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613847.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"— Pójdziesz się bawić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613848.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Prawda to, że stary zjada co dzień młodego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613849.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"Ale ona nie weszła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20644576.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Pęka i drze się w strzępy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20644577.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Ten moment operacyjny zaszedł znacznie wcześniej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20644578.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Już chyba nigdy nie będę się z chłopakami ganiał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20644580.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Dziecko schowało głowę w ramionach osłupiałego ojca.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20687549.wav\",\n",
      "    \"duration\": 5.808,\n",
      "    \"text\": \"Miód jest słodki i zdrowy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20687550.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"Zegarka nie nakręcisz, to stanie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20687551.wav\",\n",
      "    \"duration\": 7.944,\n",
      "    \"text\": \"Zajrzałem przez wybitą szybę w głąb trzeciej izby.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20687552.wav\",\n",
      "    \"duration\": 7.392,\n",
      "    \"text\": \"Obawy jej zaczynają przybierać formy bardziej określone.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37439996.wav\",\n",
      "    \"duration\": 9.108,\n",
      "    \"text\": \"Nadmierny ruch transportowy na Morzu Bałtyckim\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37439997.wav\",\n",
      "    \"duration\": 7.956,\n",
      "    \"text\": \"Takie sugestie są nie tylko groteskowe, ale i potencjalnie niebezpieczne\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37439998.wav\",\n",
      "    \"duration\": 4.86,\n",
      "    \"text\": \"Cóż za wspaniali bojownicy o wolność!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37439999.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Temu zaś śpieszno było, albowiem trawiła go jakby gorączka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27759910.wav\",\n",
      "    \"duration\": 6.948,\n",
      "    \"text\": \"Po drugie, w dniu wczorajszym nasza grupa odbyła wideokonferencję z dr\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27759912.wav\",\n",
      "    \"duration\": 7.02,\n",
      "    \"text\": \"W efekcie przestrzeń prawdziwej demokracji uległa znacznemu ograniczeniu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27759913.wav\",\n",
      "    \"duration\": 4.716,\n",
      "    \"text\": \"Powinniśmy stale wyraźnie o tym mówić\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27759914.wav\",\n",
      "    \"duration\": 5.076,\n",
      "    \"text\": \"Dwa dni temu Parlament Europejski wywiesił flagi\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621575.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Wszystko bierze dosłownie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621576.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Zjawy stają się coraz bardziej nieprzyjemne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621580.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Temu człowiekowi została tylko Biblia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621581.wav\",\n",
      "    \"duration\": 6.576,\n",
      "    \"text\": \"Było już koło piątej po południu, gdy otworzyłem ociężałe powieki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605504.wav\",\n",
      "    \"duration\": 4.272,\n",
      "    \"text\": \"Przez pewien czas udawali, że nic nie czują.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605545.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Ogarnęło go uczucie dziwnego strachu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605553.wav\",\n",
      "    \"duration\": 5.448,\n",
      "    \"text\": \"Powinien był się cieszyć, jak gdyby się po raz drugi urodził.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605566.wav\",\n",
      "    \"duration\": 6.552,\n",
      "    \"text\": \"Siedzieli milcząc, zanurzeni w zapachu kobiety, która stąd odeszła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26918139.wav\",\n",
      "    \"duration\": 7.596,\n",
      "    \"text\": \"Myślę, że to był element kampanii wyborczej Partii Niepodległości Zjednoczonego Królestwa\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26918143.wav\",\n",
      "    \"duration\": 5.688,\n",
      "    \"text\": \"Głosowałem za przyjęciem rezolucji w sprawie sytuacji w Zachodniej Saharze\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26918145.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Zdecydowanie podzielam opinię, że należy wyznaczyć specjalną pozycję w budżecie na potrzeby synergii czarnomorskiej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26918147.wav\",\n",
      "    \"duration\": 5.508,\n",
      "    \"text\": \"Chętnie udostępnię te sprawozdania, ale teraz nie mogę podać szczegółów\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37823976.wav\",\n",
      "    \"duration\": 6.156,\n",
      "    \"text\": \"Przyzwyczailiśmy się do wielu rodzajów etykiet\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37823979.wav\",\n",
      "    \"duration\": 6.3,\n",
      "    \"text\": \"Chciałbym wyrazić moje całkowite poparcie dla niej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37823980.wav\",\n",
      "    \"duration\": 8.928,\n",
      "    \"text\": \"Istnieje przekonanie, że obawy żywią wyłącznie rolnicy europejscy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37823981.wav\",\n",
      "    \"duration\": 3.996,\n",
      "    \"text\": \"Ze Stanami Zjednoczonymi i Chinami\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618368.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"— A jednak nawet za królestwo niebieskie nie oddałbym jednej chwili pełnej świadomości.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618369.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"— Ach tak, teraz rozumiem — to też rodzaj wróżby.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618371.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"I wskazała mi miejsce w łodzi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618372.wav\",\n",
      "    \"duration\": 2.784,\n",
      "    \"text\": \"Lubię filmy dokumentalne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26128518.wav\",\n",
      "    \"duration\": 7.164,\n",
      "    \"text\": \"Uważam, że jest jeszcze kwestia wiarygodności Unii Europejskiej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26128519.wav\",\n",
      "    \"duration\": 3.96,\n",
      "    \"text\": \"Oczekiwania są ogromne\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26128521.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Dlatego równowaga utrzymywana przy pomocy strachu zniknęła\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26128523.wav\",\n",
      "    \"duration\": 5.112,\n",
      "    \"text\": \"Nasuwa się pytanie nie czy dotrze, tylko kiedy dotrze\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39838765.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Stanął i patrzył.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39838767.wav\",\n",
      "    \"duration\": 6.084,\n",
      "    \"text\": \"Była to guwernantka w naszym dworze, służyła u nas, czy mnie rozumiesz?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39838768.wav\",\n",
      "    \"duration\": 4.5,\n",
      "    \"text\": \"Dąży ona także do osiągnięcia celów konwergencji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39838769.wav\",\n",
      "    \"duration\": 5.4,\n",
      "    \"text\": \"Po kilku dniach tracił ochotę do jadła, do snu, do rozmowy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31061667.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"Wiem, że Rada uważa, że być może jest to krok idący za daleko\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31061670.wav\",\n",
      "    \"duration\": 6.3,\n",
      "    \"text\": \"Sprawozdanie zauważa, że potrzebne jest więcej pieniędzy na centrum odwiedzających\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31061672.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Uważam, że bardzo ważne było rozpoczęcie interwencji właśnie od tych punktów\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31061673.wav\",\n",
      "    \"duration\": 6.984,\n",
      "    \"text\": \"Za każdym razem unikamy tej kwestii, a opinia publiczna jest słusznie zaniepokojona\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40142883.wav\",\n",
      "    \"duration\": 5.58,\n",
      "    \"text\": \"Komisja będzie też podejmować decyzje w sprawie sankcji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40142884.wav\",\n",
      "    \"duration\": 4.788,\n",
      "    \"text\": \"przedsiębiorstw, konsumentów i pracowników\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40142885.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"Przedyskutowaliśmy je i udzieliliśmy im poparcia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40142886.wav\",\n",
      "    \"duration\": 8.568,\n",
      "    \"text\": \"Dodatkowo przewidziano coroczny przegląd zgodności wszystkich standardów ochrony danych z udziałem inspektora ochrony danych\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775454.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Jak chcę i muszę, to nie mogę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775456.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Albo w usta, albo tak cię przyciśnie, że żebra bolą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775457.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Wieczorem wrzód pękł sam bez przecinania.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775461.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Nie ucieknie! — pocieszał siebie samego jednoręki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622795.wav\",\n",
      "    \"duration\": 4.728,\n",
      "    \"text\": \"Masz pendrive'a, którego ci dałem?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622796.wav\",\n",
      "    \"duration\": 6.648,\n",
      "    \"text\": \"Tam, o jutrzni we mgłach, odpływają małe statki rybackie…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622797.wav\",\n",
      "    \"duration\": 3.84,\n",
      "    \"text\": \"Niech dusza powraca do ciała!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20622798.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Pokarm wchodzi w nas, gdy jemy, i sprawia to nam przyjemność.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638796.wav\",\n",
      "    \"duration\": 8.496,\n",
      "    \"text\": \"Mówi się, że prawdziwe rozumienie wiedzy jest wtedy, gdy umie się ją przekazywać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638798.wav\",\n",
      "    \"duration\": 4.872,\n",
      "    \"text\": \"Najlepiej jest przestać palić od samego rana.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638799.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Była to ciężka puszka z lanego żelaza.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638800.wav\",\n",
      "    \"duration\": 2.712,\n",
      "    \"text\": \"Lubię go.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31836820.wav\",\n",
      "    \"duration\": 6.156,\n",
      "    \"text\": \"Musimy również wykorzystać nasze atuty, którymi są zaawansowane technologie i kapitał ludzki\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31836821.wav\",\n",
      "    \"duration\": 4.968,\n",
      "    \"text\": \"Trzeba było dokonać wyboru w ramach tej procedury budżetowej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31836822.wav\",\n",
      "    \"duration\": 4.932,\n",
      "    \"text\": \"Zrządzenie losu uniemożliwiło jej obecność tutaj w dniu dzisiejszym\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31836823.wav\",\n",
      "    \"duration\": 8.424,\n",
      "    \"text\": \"Siódmy program ramowy Unii Europejskiej dotyczący działań w zakresie badań, rozwoju technologicznego i demonstracji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20837067.wav\",\n",
      "    \"duration\": 5.328,\n",
      "    \"text\": \"Międzynarodowy projekt przelewania z pustego w próżne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20837068.wav\",\n",
      "    \"duration\": 2.856,\n",
      "    \"text\": \"Ale nie zdążył.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20837070.wav\",\n",
      "    \"duration\": 3.24,\n",
      "    \"text\": \"— I późno wrócimy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20837071.wav\",\n",
      "    \"duration\": 5.4,\n",
      "    \"text\": \"Brytyjczycy zrobili schizmę a może rozwód z Unią Europejską.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618923.wav\",\n",
      "    \"duration\": 3.672,\n",
      "    \"text\": \"Nie wrócę do domu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618926.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Oblicza z dwóch stron mej głowy?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618928.wav\",\n",
      "    \"duration\": 6.888,\n",
      "    \"text\": \"Wiem, co mówię! — odparł jednoręki i spojrzał na dziwożonę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618932.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Chyba udajesz, moja kochana.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686296.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"— Lubię ten szum, Jerzy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686297.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"— Drugie danie tu ci przyniosą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686298.wav\",\n",
      "    \"duration\": 2.856,\n",
      "    \"text\": \"— Szczotka jest na dole w izbie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686299.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Dziecko powinno zawsze mieć pierwszeństwo do ochrony i pomocy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20777751.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Wytrzymać nie można.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20777752.wav\",\n",
      "    \"duration\": 4.632,\n",
      "    \"text\": \"Nadszedł wieczór.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20777753.wav\",\n",
      "    \"duration\": 6.984,\n",
      "    \"text\": \"Wydawało mu się, że dał się nabrać, że wygłupia się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20777754.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"— Doskonale! — powiedziałem, zwracając się do kozaków.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616184.wav\",\n",
      "    \"duration\": 4.68,\n",
      "    \"text\": \"— Pozwól, chcę go obejrzeć dokładniej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616195.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"I stało się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616198.wav\",\n",
      "    \"duration\": 5.04,\n",
      "    \"text\": \"Nic dziwnego; jest pan wychowankiem miasta…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616200.wav\",\n",
      "    \"duration\": 4.08,\n",
      "    \"text\": \"Nie chwal dnia przed zachodem słońca.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775057.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"— Czy to nie za słodkie, jak na wino?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775058.wav\",\n",
      "    \"duration\": 6.504,\n",
      "    \"text\": \"I śpiewać się nie wstydzi, i pierwsza powiedziała, że będzie tańczyła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775060.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Żałuję, że sam nie wpadłem na tę myśl.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775061.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Są stłoczone i nie mają tla.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20611045.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Niestety rzeczy nie do zacytowania.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20611046.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"— Przypuszczam, że sztuczne, zrobione z jakiejś masy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20611047.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Oni nie przestają mówić o tym, ile kosztuje marmolada.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20611049.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Słyszałem, że grasz na harmonijce?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24535396.wav\",\n",
      "    \"duration\": 2.988,\n",
      "    \"text\": \"Katarzyno ja ciebie kocham.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24535397.wav\",\n",
      "    \"duration\": 3.708,\n",
      "    \"text\": \"jeszcze jakie... Jutro przedstawienie...\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24535399.wav\",\n",
      "    \"duration\": 2.88,\n",
      "    \"text\": \"Jeno mi brak tchu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_24535400.wav\",\n",
      "    \"duration\": 2.88,\n",
      "    \"text\": \"Deszcz lał strumieniami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23537893.wav\",\n",
      "    \"duration\": 6.864,\n",
      "    \"text\": \"W końcu znalazł szukane miejsce i wskazał mi je.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23537894.wav\",\n",
      "    \"duration\": 4.848,\n",
      "    \"text\": \"Obłąkany z miłości zatopiłem usta w jej dłoni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23537895.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Nagle powstało ogólne zdumienie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23537896.wav\",\n",
      "    \"duration\": 5.088,\n",
      "    \"text\": \"Sprężyny moich czynów i myśli spoczywają w innym zapomnianym bycie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630422.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"— Więc zło, zdaniem twoim, jest równie wiecznym jak dobro?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630425.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"— Ot, co wymyślił.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630428.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Mówiłem! — przypomniał z wyrzutem w głosie kulawiec.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20630430.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"— Ty nie jesteś moją matką.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21151582.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Nie znaczy to również, że kochał mniej Ewę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21151586.wav\",\n",
      "    \"duration\": 6.576,\n",
      "    \"text\": \"Widziałem, jak stał na tem krześle i przybijał wielki obraz ponad nim.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21151589.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"Miał wszelako trochę nadziei, że zmyślny pies znajdzie bezpieczny przytułek wśród skał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21151590.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"Liście topoli poruszały się na gałęziach z szelestem jedwabiu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25830185.wav\",\n",
      "    \"duration\": 5.436,\n",
      "    \"text\": \"Nie mogłem jednak wytrzymać dłużej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25830186.wav\",\n",
      "    \"duration\": 5.508,\n",
      "    \"text\": \"A jednak miałam tremę przed powiedzeniem Emilowi z tym grubasem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25830187.wav\",\n",
      "    \"duration\": 3.96,\n",
      "    \"text\": \"Jak ten grubas był zdjęty nabożnym strachem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25830189.wav\",\n",
      "    \"duration\": 4.86,\n",
      "    \"text\": \"Ale o tem mogli się dowiedzieć tylko od niego samego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771888.wav\",\n",
      "    \"duration\": 8.016,\n",
      "    \"text\": \"— Z moją skłonnością do pisania jest tak, jak z tubą pasty do zębów.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771889.wav\",\n",
      "    \"duration\": 8.856,\n",
      "    \"text\": \"Podał ją z wyszukaną nonszalancją, oczywiście podnosząc ją momentalnie w dwójnasób.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771890.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Ze współczuciem spojrzał na zabrakowanego Podlasiaka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20771892.wav\",\n",
      "    \"duration\": 3.6,\n",
      "    \"text\": \"Przykro mi, nie mam nic na ten temat.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20764143.wav\",\n",
      "    \"duration\": 4.512,\n",
      "    \"text\": \"Prawdę mówiąc, nic nie myślałem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20764144.wav\",\n",
      "    \"duration\": 5.112,\n",
      "    \"text\": \"Na kogo idzie, to idzie, a trafi w sam carat.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20764145.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"— Ma pan rację.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20764146.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"Czy pokroić wędlinę?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612566.wav\",\n",
      "    \"duration\": 7.368,\n",
      "    \"text\": \"Kolejka, panie łaskawy, wielka rzecz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612568.wav\",\n",
      "    \"duration\": 6.6,\n",
      "    \"text\": \"Banki nie wydawały złożonych kapitałów i nie wypłacały procentów.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612570.wav\",\n",
      "    \"duration\": 5.832,\n",
      "    \"text\": \"Cisnąłeś — miękko uderzyła i rozpadła się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20612573.wav\",\n",
      "    \"duration\": 4.08,\n",
      "    \"text\": \"Po co tam pojedzie z takimi nowinami?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605884.wav\",\n",
      "    \"duration\": 3.288,\n",
      "    \"text\": \"— Cmentarz zamykają tu wcześnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605892.wav\",\n",
      "    \"duration\": 3.432,\n",
      "    \"text\": \"— Nie — powiedział prędko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605906.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Dorośli nie lubią się sami schylać, bo ich kości bolą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605974.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Ale skąd znów ta ranga i mundur naczelnika?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689834.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"W sklepach z ubraniami bywam rzadko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689835.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Bardzo panienkę przepraszam i proszę przestać płakać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689836.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"Bo kaptur i czepiec to prawie to samo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689838.wav\",\n",
      "    \"duration\": 3.144,\n",
      "    \"text\": \"Kwestia wprawy i nawyku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609764.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"— Chcę stąd iść — powiedziała Ewa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609767.wav\",\n",
      "    \"duration\": 7.176,\n",
      "    \"text\": \"Znów, Tereso, w dziewczynę się zmień!…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609768.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Sara spostrzegła, że było ich sześć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609769.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Nagle zauważył, że dochodzi siódma, godzina spotkania z Jankiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39563520.wav\",\n",
      "    \"duration\": 8.136,\n",
      "    \"text\": \"Jest to istotne zwłaszcza w okresie recesji gospodarczej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39563521.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Z zadowoleniem przyjmuję dzisiejsze głosowanie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39563522.wav\",\n",
      "    \"duration\": 6.084,\n",
      "    \"text\": \"Doznałem takiego uczucia, jakby ze mnie krew wyciekła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39563523.wav\",\n",
      "    \"duration\": 8.352,\n",
      "    \"text\": \"Godne ubolewania jest to, jak asekuracyjną postawę przyjmujemy, gdy chodzi o bezpieczeństwo naszych dzieci\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603913.wav\",\n",
      "    \"duration\": 6.216,\n",
      "    \"text\": \"Gdzież mieli szukać spotkania z bogami, z dobrymi i złymi duchami?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603924.wav\",\n",
      "    \"duration\": 5.16,\n",
      "    \"text\": \"— Nie stwierdzono ani śladu czegoś podobnego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603928.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Raz ją tylko widziałem, raz jeden jedyny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603934.wav\",\n",
      "    \"duration\": 4.248,\n",
      "    \"text\": \"Jak gdyby chciało mnie ostrzec.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609755.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Ale nie chodzi o to.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609756.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"To ja się zaraz sprowadzam.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609758.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Ale pomysł trzeba było odłożyć, bo zdawał maturę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609759.wav\",\n",
      "    \"duration\": 6.216,\n",
      "    \"text\": \"Rzecz rozciąga się na długie lata — odpowiedział z mocniejszym rumieńcem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27472087.wav\",\n",
      "    \"duration\": 5.436,\n",
      "    \"text\": \"Nie możemy dowolnie wybierać w sprawie atakowania i przeciwstawiania się terroryzmowi\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27472088.wav\",\n",
      "    \"duration\": 3.96,\n",
      "    \"text\": \"Również ta kwestia jest dość ważna w obecnej sytuacji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27472089.wav\",\n",
      "    \"duration\": 4.86,\n",
      "    \"text\": \"W ten sposób można osiągnąć o wiele mniej w walce z rozprzestrzenianiem broni jądrowej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27472090.wav\",\n",
      "    \"duration\": 3.42,\n",
      "    \"text\": \"To wszystko, co mam do powiedzenia, dziękuję\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606078.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"A zaraz na drugi dzień było nowe przedstawienie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606084.wav\",\n",
      "    \"duration\": 2.256,\n",
      "    \"text\": \"— Przestań.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606095.wav\",\n",
      "    \"duration\": 8.064,\n",
      "    \"text\": \"Wczoraj czytała po raz pierwszy Rimbauda „Statek pijany” i Verlai- ne’a „Pieśń jesienną”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606131.wav\",\n",
      "    \"duration\": 6.816,\n",
      "    \"text\": \"Była to tylko gra przed tym drugim i sobą zarazem, komedia nieunikniona i podniecająca.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20628842.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"I przy mojej pomocy wyszła na marmurowy cokół nabrzeża.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20628844.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"— Sama ci odradza.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20628845.wav\",\n",
      "    \"duration\": 4.272,\n",
      "    \"text\": \"Nie mógł jej niczym zastąpić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20628846.wav\",\n",
      "    \"duration\": 5.328,\n",
      "    \"text\": \"Dla dwojga przyjaciół wyglądał z bohaterska po zbójecku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20650338.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Nie sprawiało to jednak żadnego uszczerbku w moim zapale.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20650339.wav\",\n",
      "    \"duration\": 7.776,\n",
      "    \"text\": \"Emil próbował zmienić temat rozmowy i powiedział, że był na koncercie znanego pianisty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20650340.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"— Skąd pan może wiedzieć o tym wszystkim? — szeptał na pół przytomny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20650342.wav\",\n",
      "    \"duration\": 2.496,\n",
      "    \"text\": \"Potem wyjął watę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618383.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Emil dziwił się, że Janek tyle mówi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618385.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Emil ma stosunkowo małego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618390.wav\",\n",
      "    \"duration\": 8.664,\n",
      "    \"text\": \"Czarna burza krąży jak jastrząb nad miastem; uderza skrzydłami o domy, o niebo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618392.wav\",\n",
      "    \"duration\": 6.504,\n",
      "    \"text\": \"Lecz sen nie spływał na powieki od jego pieśni monotonnej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41649066.wav\",\n",
      "    \"duration\": 7.596,\n",
      "    \"text\": \"Włączanie praw człowieka do głównego nurtu samo w sobie nie przyniesie wymaganych rezultatów\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41649068.wav\",\n",
      "    \"duration\": 8.568,\n",
      "    \"text\": \"W ten sposób system handlu przydziałami emisji motywuje jego uczestników do zminimalizowania emisji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41649069.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Omawiamy ten projekt tak, jakby nikt wcześniej nie poprowadził gazociągu po dnie morskim\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41649070.wav\",\n",
      "    \"duration\": 4.788,\n",
      "    \"text\": \"Bardzo dziękuję panu za możliwość wystąpienia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608707.wav\",\n",
      "    \"duration\": 7.344,\n",
      "    \"text\": \"Gdy znalazł się u siebie, położył się natychmiast na tapczanie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608710.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Dzieci i ryby głosu nie mają.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608713.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"O tych podziemiach chodziły po mieście tylko głuche wieści.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608715.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"Brunatny księżyc pełzał po zboczu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25326283.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"nieszczęśliwa ja sierota!...\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25326284.wav\",\n",
      "    \"duration\": 8.316,\n",
      "    \"text\": \"Ale jednej rzeczy niech pan będzie pewny: my się spotkamy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25326285.wav\",\n",
      "    \"duration\": 8.316,\n",
      "    \"text\": \"Mężczyzną tym mamy się właśnie zająć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25326286.wav\",\n",
      "    \"duration\": 8.136,\n",
      "    \"text\": \"Zapanowała dłuższa przerwa, podczas której radca policyjny zdawał się coś z wysiłkiem kombinować.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603908.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"A czy istnieje świat?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603926.wav\",\n",
      "    \"duration\": 6.816,\n",
      "    \"text\": \"Neurolog zgasił papierosa — Nie chcesz chodzić do szkoły, prawda? — Nie chcę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603935.wav\",\n",
      "    \"duration\": 7.224,\n",
      "    \"text\": \"— Naturalnie, że zapłaci — odpowiedział tymczasem ojciec nie znoszącym wątpliwości tonem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603962.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Takie pomyłki zdarzają się nieraz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39461984.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Jak dotychczas jedyne poznane życie występuje na Ziemi\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39461986.wav\",\n",
      "    \"duration\": 2.736,\n",
      "    \"text\": \"Ale na tym nie koniec\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39461990.wav\",\n",
      "    \"duration\": 5.364,\n",
      "    \"text\": \"Pamiętajmy o inflacjogennym oddziaływaniu wzrostu cen żywności\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39461993.wav\",\n",
      "    \"duration\": 4.14,\n",
      "    \"text\": \"Siedziałem w gronie niepewnych swej doli.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21077162.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Że się błyszczał jak wielka, czerwona kiełbasa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21077163.wav\",\n",
      "    \"duration\": 6.096,\n",
      "    \"text\": \"Ortografia, kaligrafia, i inna dysgrafia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21077165.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"Nadajemy naszem sierotom nazwiska w porządku abecadłowym.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21077166.wav\",\n",
      "    \"duration\": 7.824,\n",
      "    \"text\": \"I to było jedyne zdanie, które należało powiedzieć; było niezamienne.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607634.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Co za wykończenie!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607638.wav\",\n",
      "    \"duration\": 3.456,\n",
      "    \"text\": \"Nie możecie nas tu zamknąć!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607641.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"I one pewnie pierwsze odpadną.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607643.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Wyrasta ze mnie powoli, jak roślina, żywię go, napycham go sobą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20635649.wav\",\n",
      "    \"duration\": 7.776,\n",
      "    \"text\": \"Rzucała się w oczy od razu oryginalna kompozycja.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20635650.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Milcząc, pobiegli we wskazanym kierunku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20635651.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Nie znalazłem nic do aktywacji.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20635652.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Nie ma to jak starzy przyjaciele, prawda?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20770501.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"— Nic wam, bracia i siostry, nie mogę powiedzieć, choć wiem wszystko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20770503.wav\",\n",
      "    \"duration\": 5.832,\n",
      "    \"text\": \"Kręgosłup moralny nie pozwoliłby ani pani, ani mnie robić wspólnie interesów.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20770504.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"Dlaczego nie mam koleżanek?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20770505.wav\",\n",
      "    \"duration\": 4.2,\n",
      "    \"text\": \"Rzucała się w oczy od razu oryginalna kompozycja.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607833.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Nic innego nie zdążył powiedzieć na odlotnem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607834.wav\",\n",
      "    \"duration\": 2.784,\n",
      "    \"text\": \"Ojciec jęczy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607835.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Zaprosił ją na lody.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607836.wav\",\n",
      "    \"duration\": 3.576,\n",
      "    \"text\": \"Lecz ostrożność nie zawadzi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20602940.wav\",\n",
      "    \"duration\": 6.936,\n",
      "    \"text\": \"Nie tylko to.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20602941.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Co dzień tu przychodzić będę — oświadczył Radek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20602942.wav\",\n",
      "    \"duration\": 7.584,\n",
      "    \"text\": \"— Nie ufaj też pięknej jasnowłosej osobie, która chwilowo zdołała cię opętać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20602943.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Nic, tylko lód i śnieg.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20636492.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Na stacji, jak zwykle, czekał już mąż.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20636494.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Nauka ta jest bezpłatna i obowiązkowa, przynajmniej w zakresie szkoły podstawowej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20636495.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Wprost nie mógł tego pojąć, ale czuł, że już wszystko skończone!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20636496.wav\",\n",
      "    \"duration\": 8.616,\n",
      "    \"text\": \"Zamiast „Harcerze podnieśli nosze”, napisane: „Harcerze podnieśli nos”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616472.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"Tym się różni genialność życia od genial- ności twórczości.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616474.wav\",\n",
      "    \"duration\": 2.856,\n",
      "    \"text\": \"Gdzieś w oddali dudniły tramwaje.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616477.wav\",\n",
      "    \"duration\": 2.616,\n",
      "    \"text\": \"I jak dadzą lody, to mi roztopi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616479.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Czyż mógł wysunąć się na łóżko i wpaść w ręce męża?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610166.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"Odczuwał niezrozumiały niepokój i wiedział, że jutro albo pojutrze zrozumie go.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610167.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Wstał i wyszedł z pokoju, omijając Elę szerokim lukiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610168.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Usiadłem i mechanicznie obracałem w palcach jakiś przedmiot leżący na stole.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610169.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"I ona jest tu zawsze, w dokładnie określonym miejscu, w dołku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643069.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"Ta sama, co u Emila na fortepianie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643070.wav\",\n",
      "    \"duration\": 9.744,\n",
      "    \"text\": \"Dąb? — zaśmiała się nagle dziwożona i napełniła wnętrze wora klaśnięciem drobnych dłoni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643071.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"To prawdopodobnie będzie najlepsze określenie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643072.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"I ruchem ręki wskazuję ruiny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614869.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Olbrzymia, „bezimienna paszcza”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614871.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Zaczepiła go pierwsza pod jakimś błahym pozorem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614873.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Nie ma żadnej ceremonii ani etykiety.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20614875.wav\",\n",
      "    \"duration\": 7.344,\n",
      "    \"text\": \"Z zapadniętej głęboko twarzy sterczały kości policzkowe ostro, niemiłosiernie, wyzywająco.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23402402.wav\",\n",
      "    \"duration\": 4.536,\n",
      "    \"text\": \"Ja tylko tak mówię.“ Przeszedłem się po pokoju, aby się uspokoić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23402403.wav\",\n",
      "    \"duration\": 5.784,\n",
      "    \"text\": \"„Czego pan tutaj szuka?“ chciałem krzyczeć, lecz człowiek ten uprzedził mnie: „Pernat!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23402404.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"Długo, bardzo długo musiałem szukać, zanim znalazłem drugi stopień, poczem wdrapywałem się dalej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_23402405.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"powtarzałem sobie nieprzytomnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31210427.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Leśny dworzec książęcy opustoszał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31210428.wav\",\n",
      "    \"duration\": 5.508,\n",
      "    \"text\": \"Przedstawione sprawozdanie zawiera niezbędną kontynuację i oczekiwane zmiany\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31210430.wav\",\n",
      "    \"duration\": 2.88,\n",
      "    \"text\": \"Grozi im teraz wyrok śmierci\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_31210431.wav\",\n",
      "    \"duration\": 3.06,\n",
      "    \"text\": \"Powinien tu być czytelny podział\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775433.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"W co chcesz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775434.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Bardzo mi przykro, że ludzie przeze mnie cierpią.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775435.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"- Coo? W jaki sposób wiedziałaś?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775436.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Kobiety o zbyt grubych nogach w kostce wyglądają na plaży całkiem dobrze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39565595.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Dlaczego Europa jest w Afganistanie?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39565596.wav\",\n",
      "    \"duration\": 7.128,\n",
      "    \"text\": \"Imigranci z Afryki Północnej zginęli, usiłując dotrzeć do Włoch i Europy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39565597.wav\",\n",
      "    \"duration\": 6.048,\n",
      "    \"text\": \"Wspólnie z państwami członkowskimi będziemy pracować nad osiągnięciem tego celu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39565598.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"O, to wcale inna rzecz!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603607.wav\",\n",
      "    \"duration\": 9.864,\n",
      "    \"text\": \"Na śniegu spostrzegliśmy duże plamy czerwonej, rdzawej wody.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20603645.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"Ale któż to wykona.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604596.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"A widzę wyraźnie, jakby wczoraj dopiero.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604609.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"— Proszę pana, tylko na parę godzin.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610534.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Mój pies notorycznie mi ucieka goniąc zwierzynę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610536.wav\",\n",
      "    \"duration\": 2.976,\n",
      "    \"text\": \"Nic nie mówi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610537.wav\",\n",
      "    \"duration\": 7.464,\n",
      "    \"text\": \"Niebo od samego rana już pokrywały chmury, a około dziesiątej zaczął padać silny deszcz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610538.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"Na trzeci dzień Noel zaczął kichać i kaszleć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607075.wav\",\n",
      "    \"duration\": 8.976,\n",
      "    \"text\": \"I oto jak się te nieprzytomne marzenia ziściły w nieprzytomnym losie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607119.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Usiedli i ławka była jeszcze ciepła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607141.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Janek przyszedł pewnego razu z miną, która oznaczała „coś się stało”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607149.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Gdy Teresa — ta prawdziwa — jest w Warszawie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609356.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Byliśmy w udawaniu naprawdę dobrzy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609358.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Jest to tzw. w magii „powrotne uderzenie”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609359.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Człowiek nawet się wyspać nie może.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609360.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"Wiedziałem też od lat dziecięcych, że ludzi tych zjednywać sobie trzeba podarkami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625613.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Obaj odetchnęli głęboko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625616.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Już drugi raz uderzyłem małym palcem o framugę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625619.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Cofając się, zostawiliśmy trzech zabitych przyjaciół.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625620.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Na stacji, jak zwykle, czekał już mąż.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605523.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"— Wszystko jedno — machnął obojętnie ręką.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605537.wav\",\n",
      "    \"duration\": 6.072,\n",
      "    \"text\": \"— Jestem tego samego zdania! — zgodził się muł — Widocznie mamy wspólne upodobania!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605549.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Pianista dlatego nie może grać, bo zdaje sobie sprawę, że może nie móc.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605579.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"Po prostu przestał dlatego, że Emil przestał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20837177.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Tylko co? - wybuchnął Scott.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20837178.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Potem wygłupialiśmy się razem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20837180.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Jest godzina pierwsza czterdzieści.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20837181.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Kto wie, czy jeszcze kiedyś wstąpi w te progi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39999097.wav\",\n",
      "    \"duration\": 5.364,\n",
      "    \"text\": \"Powinniśmy zadbać o dostępność odpowiednich źródeł informacji w regionach słabiej rozwiniętych\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39999098.wav\",\n",
      "    \"duration\": 5.076,\n",
      "    \"text\": \"Reformy powinny być skierowane ku przyszłości i ułatwiać życie zwykłym ludziom\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39999099.wav\",\n",
      "    \"duration\": 6.192,\n",
      "    \"text\": \"Mamy nieznaczny wzrost w ilości przewożonych niebezpiecznych towarów we wszystkich rodzajach transportu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39999101.wav\",\n",
      "    \"duration\": 4.644,\n",
      "    \"text\": \"Wreszcie znaleźli ślad, gdzie Maciusia przenieśli z samochodu na łódkę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648449.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Co jest?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648450.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Koty i psy to najpopularniejsze zwierzęta domowe.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648451.wav\",\n",
      "    \"duration\": 4.68,\n",
      "    \"text\": \"Przyczyna owych ucieczek pozostała nigdy nie wyjaśnioną.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648453.wav\",\n",
      "    \"duration\": 5.04,\n",
      "    \"text\": \"— Już nie mogę niczego zmyślać na jawie — rzekła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617862.wav\",\n",
      "    \"duration\": 7.176,\n",
      "    \"text\": \"Bo jej mama kazała w gnieździe posprzątać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617863.wav\",\n",
      "    \"duration\": 6.744,\n",
      "    \"text\": \"Posłuchała z ociąganiem się i ostrożnie wyjrzała.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617865.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"— Bierzcie czym prędzej siekiery i pędźcie na lewo na górę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20617866.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"A u żadnej z lalek nie spotkałam takiego spojrzenia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607744.wav\",\n",
      "    \"duration\": 6.552,\n",
      "    \"text\": \"Krzyczała, płakała, nie dawała się uczesać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607746.wav\",\n",
      "    \"duration\": 4.992,\n",
      "    \"text\": \"Ponowne wizje miniaturowych twarzyczek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607748.wav\",\n",
      "    \"duration\": 5.064,\n",
      "    \"text\": \"Jaki gatunek filmu lubisz najbardziej?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607751.wav\",\n",
      "    \"duration\": 5.568,\n",
      "    \"text\": \"Nie wolno mi powiedzieć: — Powieście się, ja chcę żyć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20680407.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Zdziwienie odmalowało się na twarzy starca.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20680408.wav\",\n",
      "    \"duration\": 3.24,\n",
      "    \"text\": \"Mongołowie uczynili to samo.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20680409.wav\",\n",
      "    \"duration\": 2.952,\n",
      "    \"text\": \"Niech się językiem broni.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20680411.wav\",\n",
      "    \"duration\": 3.672,\n",
      "    \"text\": \"Po czym szli zgodnie i umownie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606598.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Po co ten tłum?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606603.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"To było świństwo, że mu nie kupiono psa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606615.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Żyjący jest umarłym.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606633.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Zgromadzenie Ogólne proklamuje niniejszą Deklarację praw dziecka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656525.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"— No, a teraz, panienko, czas wstawać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656526.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Marysia skinęła rzęsami, tak jakby kto inny skinął głową.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656528.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Przecież one chyba nie robią tego tylko dla forsy? Jesteś bał wan.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20656529.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Może weź parę dni urlopu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20658977.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Słowem: pies, który dużo szczeka, nie gryzie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20658978.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Raz ją tylko widziałem, raz jeden jedyny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20658980.wav\",\n",
      "    \"duration\": 2.424,\n",
      "    \"text\": \"A wiesz, dlaczego?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20658981.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Musi spaść w nocy lub rano, żeby nie zdążyli uprzątnąć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618138.wav\",\n",
      "    \"duration\": 9.456,\n",
      "    \"text\": \"I przerzuciwszy ten ciężar na ojca — uciekł.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618139.wav\",\n",
      "    \"duration\": 3.72,\n",
      "    \"text\": \"— Kto pani powiedział? — szepnęła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618143.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Mam ochotę na zupę szczawiową.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618145.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Co innego jest fikcja w powieści, a co innego rzeczywistość.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25116703.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Nie trapiono się i tem, że przyszła na świat córka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25116704.wav\",\n",
      "    \"duration\": 4.788,\n",
      "    \"text\": \"Podobno Netflix wczoraj przestał działać\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25116705.wav\",\n",
      "    \"duration\": 4.248,\n",
      "    \"text\": \"No i coś ty zrobiła łazęgo zasmarkana?!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25116707.wav\",\n",
      "    \"duration\": 3.528,\n",
      "    \"text\": \"No to po kiego to robiliśmy?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20816381.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"— Opowiedz nam, Saro — wezwał ją ojciec z uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20816382.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"A gdyby… a gdyby…!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20816383.wav\",\n",
      "    \"duration\": 6.096,\n",
      "    \"text\": \"Nie, nic ją nie boli, odpowiedziała, smuci się tylko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20816384.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"A czy wiesz, o co mnie pyta?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686507.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Słyszę i nic nie rozu miem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686511.wav\",\n",
      "    \"duration\": 7.824,\n",
      "    \"text\": \"W jednym kącie siedziała grupa znajomych, rozprawiających głośno, z ożywieniem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686513.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Lecz cóż nas to wszystko obchodzi?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20686515.wav\",\n",
      "    \"duration\": 4.536,\n",
      "    \"text\": \"Chyba użył pan tego wyrażenia w znaczeniu przenośnym?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20680402.wav\",\n",
      "    \"duration\": 7.536,\n",
      "    \"text\": \"Gdy się człowiek spieszy, to się diabeł cieszy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20680403.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"— Czego mamy zazdrościć?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20680404.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Ale cierpliwie, żeby nie bić.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20680405.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"A jak urośniecie…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26980670.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"W sprawozdaniu brak jest analizy tego zagadnienia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26980671.wav\",\n",
      "    \"duration\": 6.66,\n",
      "    \"text\": \"Nie muszą to być porty państwowe, ale sektor publiczny musi za nie odpowiadać\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26980672.wav\",\n",
      "    \"duration\": 6.66,\n",
      "    \"text\": \"Naszym zadaniem jest obecnie odpowiedzialne wykorzystanie tych nowych uprawnień\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26980674.wav\",\n",
      "    \"duration\": 9.432,\n",
      "    \"text\": \"Niskie wymagania depozytowe na rynku oznaczają, iż rynek ten jest otwarty na manipulacje\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20676905.wav\",\n",
      "    \"duration\": 8.496,\n",
      "    \"text\": \"Powtórny i głośniejszy jęk, wiosennie zgłuszony bujnymi ścianami dębu, wydobył się na\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20676907.wav\",\n",
      "    \"duration\": 2.976,\n",
      "    \"text\": \"Dla mnie zmieniła świat cały.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20676908.wav\",\n",
      "    \"duration\": 2.544,\n",
      "    \"text\": \"— Ja jeszcze śnię!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20676910.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Bo tam przecie nie ma komfortu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613244.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Nie płakał od ósmego roku życia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613246.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"— Kim lubisz być, zbójem czy policjantem? — Lubię być policjantem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613247.wav\",\n",
      "    \"duration\": 8.256,\n",
      "    \"text\": \"Urządzała go cały rok: wszystkie pieniądze wydawała na maskotki — same koty, tylko jedna małpa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613248.wav\",\n",
      "    \"duration\": 3.456,\n",
      "    \"text\": \"Przyjść musisz po chleby!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25238964.wav\",\n",
      "    \"duration\": 4.536,\n",
      "    \"text\": \"Słowa te jeszcze dzwonią mi w uszach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25238970.wav\",\n",
      "    \"duration\": 3.528,\n",
      "    \"text\": \"Znam angielskie polowanie na lisa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25238971.wav\",\n",
      "    \"duration\": 2.376,\n",
      "    \"text\": \"Ogłuszył by ją.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25238972.wav\",\n",
      "    \"duration\": 7.128,\n",
      "    \"text\": \"Nie, ponieważ tyle już postąpiła, może nieco za lekkomyślnie, trzeba było dopiąć swego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638555.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Głębokie cienie kontrastują z jasnymi punktami kadrów.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638556.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Była naprawdę wielce zakłopotana.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638558.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Prawda to, że stary zjada co dzień młodego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20638560.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Poproszę pana dowód.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605552.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Wtedy mówiła: „nie bawię się” albo: „nie potrzebuję”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605574.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"— Wyjaśnię ci kiedyś później.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605596.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Fredek zwisał jak worek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605622.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Cieszę się, żem okaleczył tego łotra.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608622.wav\",\n",
      "    \"duration\": 8.376,\n",
      "    \"text\": \"Emil odczuwał strach i opór przed posuwaniem się dalej, Janek — ani strachu, ani oporu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608623.wav\",\n",
      "    \"duration\": 8.256,\n",
      "    \"text\": \"Ciekawym tylko, co wiadomo — spytał kulawiec i splunął w stronę jednorękiego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608624.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Trudno skończyć, gdy się zaczyna.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608626.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Przykro mi ale nie mogę ci w tym pomóc.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626207.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Podszedł do fortepianu dziwnie miękko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626216.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Przepadłem i ja i moja rodzina!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626218.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Ona, która go zrozumiała zbyt wąsko: — Ooo, tak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20626223.wav\",\n",
      "    \"duration\": 4.536,\n",
      "    \"text\": \"Nie dziwię się wcale, że wywołuje taki popłoch wśród dzieci.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20660149.wav\",\n",
      "    \"duration\": 5.856,\n",
      "    \"text\": \"To „wnętrzności” boga.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20660150.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Nie wierzę w nią ani trochę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20660152.wav\",\n",
      "    \"duration\": 5.376,\n",
      "    \"text\": \"Gdybym wiedziała, nie lękałabym się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20660153.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Zadarła ogonek i poleciała na płot.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608400.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Zacząłem mieć wątpliwości.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608409.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"— Opowiedz mi o swej rodzinie!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608412.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Autor: Jan Baptysta Porta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608413.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Nie przeczuwał, jakie huragany zawiera w sobie to wezwanie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37263065.wav\",\n",
      "    \"duration\": 6.012,\n",
      "    \"text\": \"środki te powinny być wykorzystywane na konkretne cele rozwojowe\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37263066.wav\",\n",
      "    \"duration\": 4.356,\n",
      "    \"text\": \"Ten sam, który dziś morduje Tybetańczyków\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37263068.wav\",\n",
      "    \"duration\": 8.568,\n",
      "    \"text\": \"Może jedynie koordynować, a istnieje zasadnicza różnica pomiędzy koordynowaniem, a wywieraniem wpływu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37263069.wav\",\n",
      "    \"duration\": 10.404,\n",
      "    \"text\": \"Chciałbym powtórzyć wniosek sprawozdawczyni, mający na celu umocnienie prawodawstwa unijnego dotyczącego równości pomiędzy płciami\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633789.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Chcesz mnie przekląć?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633791.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"— Jesteś ze mną na rybackim bacie…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633792.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"Tatarak wkrótce zjedzono do szczętu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633793.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Gdy przygotowuję się do wykładu to bardzo niewiele mogę wykorzystać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22234829.wav\",\n",
      "    \"duration\": 2.784,\n",
      "    \"text\": \"zero\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22234832.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Firefox\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22234835.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"cztery\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_22234839.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"pięć\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30492248.wav\",\n",
      "    \"duration\": 9.972,\n",
      "    \"text\": \"Sytuacja światowego systemu finansowego i jej wpływ na gospodarkę europejską\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30492249.wav\",\n",
      "    \"duration\": 5.148,\n",
      "    \"text\": \"Pragnęli pieniędzy i władzy\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30492250.wav\",\n",
      "    \"duration\": 7.668,\n",
      "    \"text\": \"Zabito go, bo chciano powstrzymać normalizację, demokratyzację i europeizację Serbii\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_30492252.wav\",\n",
      "    \"duration\": 7.092,\n",
      "    \"text\": \"Tylko wymiana poglądów, tylko różnica poglądów, dyskusja może nam dać odpowiedzi na najtrudniejsze pytania\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607359.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Czyj to nos?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607361.wav\",\n",
      "    \"duration\": 9.504,\n",
      "    \"text\": \"Mówił: — Takie to porządki, że wszystko leży ułożone i niczego nie można znaleźć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607364.wav\",\n",
      "    \"duration\": 6.384,\n",
      "    \"text\": \"— Skąd panu przyszło to na myśl właśnie w tej chwili?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607369.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"— Jeszcze nie, mój synku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27674820.wav\",\n",
      "    \"duration\": 6.048,\n",
      "    \"text\": \"W tych ważnych negocjacjach musimy się zmierzyć z dwiema ważnymi trudnościami\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27674821.wav\",\n",
      "    \"duration\": 4.32,\n",
      "    \"text\": \"Tak, Parlament potrafi działać bardzo szybko\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27674823.wav\",\n",
      "    \"duration\": 3.42,\n",
      "    \"text\": \"Chciałbym podkreślić jeden punkt\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_27674824.wav\",\n",
      "    \"duration\": 8.388,\n",
      "    \"text\": \"Chciałabym pogratulować sprawozdawcy i kontrsprawozdawcom ich udanych negocjacji z Radą\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20777730.wav\",\n",
      "    \"duration\": 8.376,\n",
      "    \"text\": \"Tylko oddech jej stał się szybszym i piersi zaczęły silnie falować.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20777731.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Mrówka myśli, że to wysoka góra.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20777732.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Ogarnął go nudny zawrót głowy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20777735.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"Zaprosiliśmy go na lunch w pobliskiej knajpie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618116.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Poeta wyraziłby się, że zachowała niezatarte ślady piękności.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618120.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Ja chcę czuć pewien opór, pewną walkę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618127.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"— Lecz co ci to właściwie szkodzi?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618131.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Szybko narzuciłam ubranie i poszłam do pokoju Wilhelma.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648933.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Wrócił do pokoju.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648934.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Ala zrobiła sarenkę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648936.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"— Nie — powiedział prędko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648937.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Emil był też nieprzytomny tego wieczoru.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607523.wav\",\n",
      "    \"duration\": 7.104,\n",
      "    \"text\": \"Miała katar pęcherza, zmarzła na ławce w parku i chciało jej się bardzo siusiu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607525.wav\",\n",
      "    \"duration\": 6.504,\n",
      "    \"text\": \"Coraz więcej gorąca napływało mu do twarzy i zasłaniało oczy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607526.wav\",\n",
      "    \"duration\": 7.104,\n",
      "    \"text\": \"To jest chodzenie po ostrzu brzytwy, fantastycznie wąska via media.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20607527.wav\",\n",
      "    \"duration\": 6.576,\n",
      "    \"text\": \"W jednej z nich było dwóch żołnierzy, w drugiej — trzech.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39567489.wav\",\n",
      "    \"duration\": 9.216,\n",
      "    \"text\": \"Jest zatem jasne, dlaczego Brazylia należy do kluczowych partnerów Unii Europejskiej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39567490.wav\",\n",
      "    \"duration\": 9.072,\n",
      "    \"text\": \"Narazilibyśmy się na oskarżenia o instrumentalizm polityczny i nadwyrężylibyśmy zaufanie obywateli do naszej instytucji\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39567491.wav\",\n",
      "    \"duration\": 5.868,\n",
      "    \"text\": \"Państwa członkowskie zobowiązują się do osiągnięcia celów, których nie wykonują\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39567492.wav\",\n",
      "    \"duration\": 3.996,\n",
      "    \"text\": \"Chciałbym o coś ponownie zapytać\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20611240.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"Raz zasnął na przyrodzie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20611241.wav\",\n",
      "    \"duration\": 5.76,\n",
      "    \"text\": \"Udawały mu się czasem cięte odpowiedzi, ponieważ dużo czytał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20611242.wav\",\n",
      "    \"duration\": 4.368,\n",
      "    \"text\": \"Oczy płonęły mu dziwnym blaskiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20611243.wav\",\n",
      "    \"duration\": 5.76,\n",
      "    \"text\": \"Przeszedł szybko przez Verne’a i Maya do powieści kryminalnych.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40438255.wav\",\n",
      "    \"duration\": 5.148,\n",
      "    \"text\": \"Nie pojadę do lasu ani na taras... będę czekał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40438256.wav\",\n",
      "    \"duration\": 6.552,\n",
      "    \"text\": \"Komisja nie może dyktować państwom członkowskim, które podatki mogą podnieść czy obniżyć\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40438257.wav\",\n",
      "    \"duration\": 6.732,\n",
      "    \"text\": \"Ataki przeciwko wspólnotom wyznaniowym zawsze są niewybaczalne, gdziekolwiek mają miejsce\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40438258.wav\",\n",
      "    \"duration\": 6.228,\n",
      "    \"text\": \"Stosunek, do chłopów, do służby, do ludzi zatrudnionych na folwarku!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610409.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"Pierś była jędrna i młoda.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610410.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Wydawało mu się, że dał się nabrać, że wygłupia się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610412.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Zrobiłaby teraz wszystko, czego by chciał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610413.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"Ach, co za rozkosz!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610785.wav\",\n",
      "    \"duration\": 6.744,\n",
      "    \"text\": \"— Co mi dasz? Tamten odpowiada na serio i poważnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610786.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Nie mogę! — jęczał przewodnik.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610787.wav\",\n",
      "    \"duration\": 4.584,\n",
      "    \"text\": \"Pierwsza sesja przed nim, wsparcie mu się przyda.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610789.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"Ludzie są bardzo sceptyczni na ten temat i poniekąd mają rację.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40178924.wav\",\n",
      "    \"duration\": 4.788,\n",
      "    \"text\": \"Zgadzam się z przedmówcami, którzy o tym mówili\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40178925.wav\",\n",
      "    \"duration\": 6.948,\n",
      "    \"text\": \"Głosowałem dziś za przyjęciem sprawozdania z kontroli stosowania prawa Unii Europejskiej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40178926.wav\",\n",
      "    \"duration\": 3.456,\n",
      "    \"text\": \"To jest nie do przyjęcia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40178928.wav\",\n",
      "    \"duration\": 10.836,\n",
      "    \"text\": \"List był od Kmicica, pisany w następujące słowa: „Sercem ukochana, najdroższa, nieodżałowana Oleńko!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26673976.wav\",\n",
      "    \"duration\": 7.308,\n",
      "    \"text\": \"Po drugie, chciałbym podkreślić wagę partnerstwa w obszarze polityki energetycznej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26673977.wav\",\n",
      "    \"duration\": 6.156,\n",
      "    \"text\": \"Audyt wiejski jest wciąż stojącym przed nami wyzwaniem\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26673979.wav\",\n",
      "    \"duration\": 8.28,\n",
      "    \"text\": \"Potem będziemy decydować, z których krajów mamy przyjmować obywateli z wizami czy bez nich\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_26673980.wav\",\n",
      "    \"duration\": 9.108,\n",
      "    \"text\": \"To nieomal oznacza likwidację postępu osiągniętego w związku z oceną funkcjonalności\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625509.wav\",\n",
      "    \"duration\": 6.504,\n",
      "    \"text\": \"Kto wie, czy zostawszy twoją żoną, nie przestałabym cię kochać?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625511.wav\",\n",
      "    \"duration\": 6.264,\n",
      "    \"text\": \"Na bok reszta! — krzyknął Podlasiak, podniecony otrzymanym uśmiechem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625512.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Toteż musi opustoszeć, a wówczas nikt nam nie będzie przeszkadzał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625515.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Pęd, panie kochany, pęd i ruch!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20629957.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"— Właściwie cóż by nam przyszło z tego, gdybyśmy wreszcie go odnaleźli?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20629958.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"— Przykra misja — objaśnił po chwili.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20629960.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"Przywarłem ustami do jej ręki na długą chwilę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20629961.wav\",\n",
      "    \"duration\": 4.824,\n",
      "    \"text\": \"— A teraz poślij no kogo, by mi kupił materiału na turban.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41650315.wav\",\n",
      "    \"duration\": 8.748,\n",
      "    \"text\": \"Aby zmniejszyć ogrom ludzkiego cierpienia, konieczne jest natychmiastowe obustronne zawieszenie broni\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41650316.wav\",\n",
      "    \"duration\": 4.608,\n",
      "    \"text\": \"Stali się oni pracownikami nielegalnymi\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41650318.wav\",\n",
      "    \"duration\": 3.852,\n",
      "    \"text\": \"To jest przepis na sukces\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_41650319.wav\",\n",
      "    \"duration\": 8.748,\n",
      "    \"text\": \"Jeśli spełniony zostanie ten warunek, ustalenie wieku emerytalnego leży w kompetencji państw członkowskich\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20624490.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Nie mam nic przeciwko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20624493.wav\",\n",
      "    \"duration\": 4.2,\n",
      "    \"text\": \"Cel uświęca środki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20624494.wav\",\n",
      "    \"duration\": 2.76,\n",
      "    \"text\": \"— Ja chcę zaraz!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20624498.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"I zaproponował, abyśmy spróbowali naśladować.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775525.wav\",\n",
      "    \"duration\": 6.24,\n",
      "    \"text\": \"Słyszał, jak szła po schodach, jak otwierała drzwi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775527.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Kogut myślał o niedzieli, a w sobotę łeb mu ucięli.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775530.wav\",\n",
      "    \"duration\": 4.92,\n",
      "    \"text\": \"Serce mu biło mocno, coraz mocniej, jeszcze mocniej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775531.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"— Jestem trochę znużona przechadzką.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689294.wav\",\n",
      "    \"duration\": 7.584,\n",
      "    \"text\": \"Cóż takiego zaszło między wami? — zapytałem, nie zdradzając swych myśli.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689296.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Rzec można, iż zanieistnieli w sobie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689297.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Nie był na pogrzebie i nie pokazał się trzy dni w domu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20689298.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"— Na razie nie widzę żadnej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40056906.wav\",\n",
      "    \"duration\": 7.164,\n",
      "    \"text\": \"dzieje się tak podczas każdej debaty, a dziś chodzi o zasadę jednomyślności\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40056907.wav\",\n",
      "    \"duration\": 9.108,\n",
      "    \"text\": \"System certyfikacji połowów jest instrumentem zapewniającym kontrolę identyfikowalności produktów rybołówstwa\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40056908.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"Mamy świadomość, że jest to bardzo problematyczna kwestia\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40056909.wav\",\n",
      "    \"duration\": 3.348,\n",
      "    \"text\": \"Doprawdy nie miałem zamiaru...\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40823055.wav\",\n",
      "    \"duration\": 5.328,\n",
      "    \"text\": \"No, dobrze, ale gdyby nie ona, czy miałbym dziś majątek?...\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40823056.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Naprawdę bardzo Państwu dziękuję\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40823057.wav\",\n",
      "    \"duration\": 3.24,\n",
      "    \"text\": \"Popieram likwidację tego monopolu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40823058.wav\",\n",
      "    \"duration\": 2.952,\n",
      "    \"text\": \"co za szkoda!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37048960.wav\",\n",
      "    \"duration\": 6.588,\n",
      "    \"text\": \"Była również obecna na naszym spotkaniu z Europejskim Obszarem Gospodarczym w minionym tygodniu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37048961.wav\",\n",
      "    \"duration\": 7.308,\n",
      "    \"text\": \"Obejmuje to ściśle określony zakres uprawnień i wsparcie finansowe dla nadawców publicznych\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37048962.wav\",\n",
      "    \"duration\": 6.768,\n",
      "    \"text\": \"Jeżeli chcecie wspierać innowacje, skoncentrujcie się na osobach studiujących na uniwersytetach\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_37048963.wav\",\n",
      "    \"duration\": 4.032,\n",
      "    \"text\": \"Oczekiwanie czegokolwiek więcej jest nierozsądne\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21189446.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Zdumiał się tedy młodzian i zwyczajnie zdębiał.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21189449.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"— Więc już nigdy nie zobaczysz swych koleżanek!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21189450.wav\",\n",
      "    \"duration\": 8.136,\n",
      "    \"text\": \"Zona: — Emilku, on musi iść przynajmniej o dwunastej spać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21189452.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"Antoś, jakże to się stało?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20788560.wav\",\n",
      "    \"duration\": 2.976,\n",
      "    \"text\": \"Za długo już siedzę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20788561.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"Oczy utkwione w powałę, twarz azjatycka, bez wyrazu, nieludzka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20788562.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"— Proszę nie przeszkadzać! — upomniał go któryś z gości.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20788563.wav\",\n",
      "    \"duration\": 3.984,\n",
      "    \"text\": \"— Ten drugi — to Stanisław Krzemiński.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20673621.wav\",\n",
      "    \"duration\": 5.472,\n",
      "    \"text\": \"Szepty zapełniły mały park.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20673624.wav\",\n",
      "    \"duration\": 4.512,\n",
      "    \"text\": \"Gdzieś w oddali dudniły tramwaje.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20673625.wav\",\n",
      "    \"duration\": 5.736,\n",
      "    \"text\": \"Sekretarz wyjął notatnik i ołówek z kieszeni surduta.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20673627.wav\",\n",
      "    \"duration\": 3.192,\n",
      "    \"text\": \"Wydaje mi się, że nie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613546.wav\",\n",
      "    \"duration\": 2.184,\n",
      "    \"text\": \"- Dwanaście.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613548.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Całkiem zapomniał o swojej biedzie i niebezpieczeństwie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613549.wav\",\n",
      "    \"duration\": 4.416,\n",
      "    \"text\": \"W ten sposób zmieniano swoje „ja”.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20613725.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"— Bo to nie moje — odparła Marta z godnością.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604222.wav\",\n",
      "    \"duration\": 7.968,\n",
      "    \"text\": \"Ona już spała, a on słuchał, czy oddycha, czy nie umarła.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604227.wav\",\n",
      "    \"duration\": 5.88,\n",
      "    \"text\": \"— W takim razie — odpowiedział cicho — poniósłbym porażkę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604231.wav\",\n",
      "    \"duration\": 2.904,\n",
      "    \"text\": \"To była robota!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604232.wav\",\n",
      "    \"duration\": 4.656,\n",
      "    \"text\": \"A jak wyglądasz? — spytała dziwożona.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633257.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Dziedziczka pokiwała znacząco głową.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633258.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Zaczął przełykać ślinę i zapatrzył się na chwilę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633259.wav\",\n",
      "    \"duration\": 6.696,\n",
      "    \"text\": \"— Pewno jej przyszedł do głowy jakiś pomysł — wyjaśnił Dan.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20633260.wav\",\n",
      "    \"duration\": 6.936,\n",
      "    \"text\": \"Jakże się teraz Filip cieszył, że puścił się tymi śladami!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774165.wav\",\n",
      "    \"duration\": 5.352,\n",
      "    \"text\": \"— O nie! — rzekł.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774166.wav\",\n",
      "    \"duration\": 8.688,\n",
      "    \"text\": \"Nie ma nic wspólnego pomiędzy wolnymi ludami puszczy, a tą bandą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774167.wav\",\n",
      "    \"duration\": 8.136,\n",
      "    \"text\": \"Pokazywał moc niezliczoną nowych kiełków, wychylających się przez czarną glebę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774169.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"Gondola odbijała od brzegu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647321.wav\",\n",
      "    \"duration\": 3.624,\n",
      "    \"text\": \"Lubię spać przy otwartym oknie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647322.wav\",\n",
      "    \"duration\": 4.44,\n",
      "    \"text\": \"Ewa zbladła, widział ją, siedziała w pierwszej ławce.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20647324.wav\",\n",
      "    \"duration\": 4.872,\n",
      "    \"text\": \"Zbyt ciężko względem niej zawiniłem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20717230.wav\",\n",
      "    \"duration\": 7.44,\n",
      "    \"text\": \"Nastrojem będzie rodzaj miłości, który nie daje żadnych objawów somatycznych.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38122230.wav\",\n",
      "    \"duration\": 5.724,\n",
      "    \"text\": \"Złośliwa dziewczyna poszła do okna i spojrzała na zegar w dziedzińcu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38122232.wav\",\n",
      "    \"duration\": 3.6,\n",
      "    \"text\": \"Tej długiej debaty słuchałem jako obywatel\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38122234.wav\",\n",
      "    \"duration\": 4.068,\n",
      "    \"text\": \"Będę głosował za skupieniem się na pacjentach\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38122236.wav\",\n",
      "    \"duration\": 5.4,\n",
      "    \"text\": \"Może jest szansa, by umożliwić tej matce zobaczenie jej syna jeszcze raz\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648643.wav\",\n",
      "    \"duration\": 9.144,\n",
      "    \"text\": \"W ostatnich czasach zdaje się ustawicznie czegoś nasłuchiwać, na coś czekać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648644.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"Jedzcie sami na zdrowie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648645.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Tu nie jest ważne, kto ma rację.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20648646.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Chcę marnie zdechnąć w mej ciemnej norze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632777.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Zdobyłam tu rzecz stokroć cenniejszą dla mnie od złota.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632778.wav\",\n",
      "    \"duration\": 7.224,\n",
      "    \"text\": \"Po tylu, tylu latach cieszę się, że śnieg, że biało.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632779.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Podróż była bardzo przyjemna.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20632781.wav\",\n",
      "    \"duration\": 6.456,\n",
      "    \"text\": \"Teraz dopiero przekonał się, że początkowo szli oboje w złym kierunku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625257.wav\",\n",
      "    \"duration\": 4.56,\n",
      "    \"text\": \"Jak chcę i muszę, to nie mogę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625260.wav\",\n",
      "    \"duration\": 5.04,\n",
      "    \"text\": \"— Jeszcze nie widzę związku z naszą rozmową.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625262.wav\",\n",
      "    \"duration\": 5.16,\n",
      "    \"text\": \"Środek był tuż, jak gdyby na wierzchu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20625264.wav\",\n",
      "    \"duration\": 4.368,\n",
      "    \"text\": \"Publicznie spotykamy się ponownie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623161.wav\",\n",
      "    \"duration\": 9.624,\n",
      "    \"text\": \"Jestem wielkim przeciwnikiem rozwydrzenia sportowego, które się w ostatnich latach rozwinęło.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623169.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Poleciał wiatr w górę gonić obłoki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623172.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Na pewno widzę się z uśmiechem na twarzy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623175.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"Ale mało kto dzisiaj to robi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775000.wav\",\n",
      "    \"duration\": 3.336,\n",
      "    \"text\": \"Nigdy więcej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775001.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Chcę poznać się, wiedzieć z góry jakie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775002.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"Wszędzie doskonałe, obfite pastwiska.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775003.wav\",\n",
      "    \"duration\": 6.576,\n",
      "    \"text\": \"Dałam się pomacać trochę fotografowi z przeciwka i zdjęcia już są.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774687.wav\",\n",
      "    \"duration\": 6.744,\n",
      "    \"text\": \"Tańczyli, wprawdzie na palcach, po cichutku, lecz do upadłego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774688.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"— To jest nie do zniesienia.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774693.wav\",\n",
      "    \"duration\": 4.344,\n",
      "    \"text\": \"W każdym razie dobrze będzie wypuścić go ze szkoły.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774695.wav\",\n",
      "    \"duration\": 6.384,\n",
      "    \"text\": \"Emil próbował zmienić temat rozmowy i powiedział, że był na koncercie znanego pianisty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21170682.wav\",\n",
      "    \"duration\": 5.904,\n",
      "    \"text\": \"Stasia porwała złość.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21170684.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"Gnębił i dręczył poddanych.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21170685.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Będzie się musiał w to wdać ktoś z Londynu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_21170686.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"— Dokąd idziesz? — zapytała go szwagierka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608992.wav\",\n",
      "    \"duration\": 8.568,\n",
      "    \"text\": \"Czasem obiecuję sobie, że go wyrzucę, że go w ogóle nie wpuszczę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608994.wav\",\n",
      "    \"duration\": 4.968,\n",
      "    \"text\": \"Milczenie pod ciśnieniem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608996.wav\",\n",
      "    \"duration\": 6.0,\n",
      "    \"text\": \"Zbliża się do szafy, gdzie wiszą suknie i płaszcz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608997.wav\",\n",
      "    \"duration\": 5.712,\n",
      "    \"text\": \"Po chwili furtka już była otwarta na oścież.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604990.wav\",\n",
      "    \"duration\": 3.504,\n",
      "    \"text\": \"— Ja jeszcze nie skończyłem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604993.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Tak się cieszą.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20604996.wav\",\n",
      "    \"duration\": 6.096,\n",
      "    \"text\": \"Zawahała się, zakołysała na miejscu, nie mogąc iść dalej.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605002.wav\",\n",
      "    \"duration\": 3.144,\n",
      "    \"text\": \"Na to zgoda…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775455.wav\",\n",
      "    \"duration\": 7.416,\n",
      "    \"text\": \"— I dlatego spóźniłeś się wtedy? Janek patrzył niebieskimi, niewinnymi oczami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775459.wav\",\n",
      "    \"duration\": 5.76,\n",
      "    \"text\": \"Nie nazywali tego przyjaźnią, nie nazywali tego wcale.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775462.wav\",\n",
      "    \"duration\": 3.84,\n",
      "    \"text\": \"Ale dla niego nie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20775464.wav\",\n",
      "    \"duration\": 6.864,\n",
      "    \"text\": \"Gra świąteczna muzyka, mamy świeczki, jedzenie i fajnych ludzi.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618616.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Ludzie z gumowymi wężami.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618618.wav\",\n",
      "    \"duration\": 3.936,\n",
      "    \"text\": \"Raz jeszcze zamroczyły się oczy kalifa.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618620.wav\",\n",
      "    \"duration\": 3.264,\n",
      "    \"text\": \"Ale przestał, bo po co?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20618621.wav\",\n",
      "    \"duration\": 3.864,\n",
      "    \"text\": \"— Z pociągu nie wolno strzelać!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40143844.wav\",\n",
      "    \"duration\": 7.596,\n",
      "    \"text\": \"Brak inwestycji w rolnictwie doprowadził do braku bezpieczeństwa żywnościowego\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40143845.wav\",\n",
      "    \"duration\": 5.436,\n",
      "    \"text\": \"Bliżej okien, za murem rosły dwie kolosalne topole.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40143846.wav\",\n",
      "    \"duration\": 5.796,\n",
      "    \"text\": \"Dziś uszło to, jak na pierwszy raz, ale trzeba się trzymać porządku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40143848.wav\",\n",
      "    \"duration\": 5.256,\n",
      "    \"text\": \"Wierzę, że jest to możliwe i będziemy o to walczyć\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609631.wav\",\n",
      "    \"duration\": 6.984,\n",
      "    \"text\": \"— Ależ to są wszystko dzieciństwa, najdroższa — uspokajałem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609632.wav\",\n",
      "    \"duration\": 3.384,\n",
      "    \"text\": \"Ty się mylisz.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609633.wav\",\n",
      "    \"duration\": 6.144,\n",
      "    \"text\": \"— A gdyby ci było przyjemnie? — To bym była zadowolona, że poszłam.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609634.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"— Znać od dawna już nikt nie używał tej ścieżki.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20788754.wav\",\n",
      "    \"duration\": 2.832,\n",
      "    \"text\": \"Usiadł.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20788756.wav\",\n",
      "    \"duration\": 5.112,\n",
      "    \"text\": \"Piękny i młodzieńczy, jak ten letni poranek.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20788757.wav\",\n",
      "    \"duration\": 3.0,\n",
      "    \"text\": \"Lepszy rydz niż nic.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20788758.wav\",\n",
      "    \"duration\": 7.272,\n",
      "    \"text\": \"Zaprawdę, za rok jeden takiego szczęścia warto było oddać resztę życia…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610474.wav\",\n",
      "    \"duration\": 6.384,\n",
      "    \"text\": \"Dan wciąż popłakiwał przy sterze.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610475.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"— Ten drugi — to Stanisław Krzemiński.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610476.wav\",\n",
      "    \"duration\": 3.216,\n",
      "    \"text\": \"— Klęknę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20610478.wav\",\n",
      "    \"duration\": 7.176,\n",
      "    \"text\": \"Wśród funkcjonariuszy stacyjnych podobno nastrój dla władz nader nieprzychylny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40429788.wav\",\n",
      "    \"duration\": 4.356,\n",
      "    \"text\": \"Ten cynizm oburzył mnie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40429790.wav\",\n",
      "    \"duration\": 5.58,\n",
      "    \"text\": \"Musimy chronić światowe oceany jako ekosystem\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40429791.wav\",\n",
      "    \"duration\": 6.3,\n",
      "    \"text\": \"Jeśli tego nie zrobią, gospodarstwa te na tej liście się nie znajdą\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40429792.wav\",\n",
      "    \"duration\": 9.0,\n",
      "    \"text\": \"Popieram również cele, które szanowni państwo posłowie zgłosili w sprawie kary śmierci\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20631162.wav\",\n",
      "    \"duration\": 3.792,\n",
      "    \"text\": \"— Jeszcze nie, mój synku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20631163.wav\",\n",
      "    \"duration\": 5.184,\n",
      "    \"text\": \"Mój Boże, jak wąska jest via media.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20631164.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Pójdź tam szybko!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20631165.wav\",\n",
      "    \"duration\": 5.544,\n",
      "    \"text\": \"Nagle obudził mnie szelest lekkich kroków poza mną.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643459.wav\",\n",
      "    \"duration\": 2.784,\n",
      "    \"text\": \"Cześć! Jak mogę Ci pomóc?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643461.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Zacząłem mieć wątpliwości.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643464.wav\",\n",
      "    \"duration\": 2.784,\n",
      "    \"text\": \"Nie spotykali się często.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20643467.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"I duch jego unosił się ponad śniegiem i miastem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616732.wav\",\n",
      "    \"duration\": 4.704,\n",
      "    \"text\": \"Pobaw się z nami!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616733.wav\",\n",
      "    \"duration\": 6.024,\n",
      "    \"text\": \"Żądał, żebym tym razem przyszła na całą noc.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616734.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"Stawię się w słowie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20616736.wav\",\n",
      "    \"duration\": 5.424,\n",
      "    \"text\": \"Wiedział, że przyjdzie za pół godziny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38520651.wav\",\n",
      "    \"duration\": 5.652,\n",
      "    \"text\": \"Komisja ma prawo rozważyć tę sprawę i zlecić jej przeanalizowanie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38520657.wav\",\n",
      "    \"duration\": 8.676,\n",
      "    \"text\": \"Równie pozytywny jest fakt, że przyjęte terminy i decyzje uwzględniają czynnik kontroli parlamentarnej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38520658.wav\",\n",
      "    \"duration\": 7.632,\n",
      "    \"text\": \"Panie i panowie, uważam, że zachodzą warunki do przyjęcia wniosku w pierwszym czytaniu\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38526666.wav\",\n",
      "    \"duration\": 7.488,\n",
      "    \"text\": \"Może pan raz jeszcze wystąpić do Stanów Zjednoczonych z wnioskiem o zawieszenie kary śmierci\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605796.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"Śmiech ten brzmiał w uszach Filipa niby krwawa obelga.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605803.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Przytuliłem ją do siebie i tak szliśmy czas jakiś…\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605810.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Żałuję, że sam nie wpadłem na tę myśl.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605819.wav\",\n",
      "    \"duration\": 4.536,\n",
      "    \"text\": \"— Tak, nie kocham go, lecz nie chcę z nim zrywać.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774662.wav\",\n",
      "    \"duration\": 3.744,\n",
      "    \"text\": \"Żegnajta — odpowiedział kulawiec.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774664.wav\",\n",
      "    \"duration\": 5.496,\n",
      "    \"text\": \"My, młodzi wieśniacy, nie umieliśmy jeszcze drwić sobie z wszystkiego.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774666.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"Jedno drugiemu pomaga znakomicie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20774669.wav\",\n",
      "    \"duration\": 6.216,\n",
      "    \"text\": \"— Ja twojego starego bardzo lubię, i to jest w swoim rodzaju morowy typ.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623638.wav\",\n",
      "    \"duration\": 7.056,\n",
      "    \"text\": \"Podczas śniadania zobaczył, że narzeczony Krystyny jest dziobaty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623640.wav\",\n",
      "    \"duration\": 3.144,\n",
      "    \"text\": \"— Kogo pan szuka?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623644.wav\",\n",
      "    \"duration\": 7.704,\n",
      "    \"text\": \"Jakaś wyższa moc splata coraz zwarciej dotychczas rozbieżne tory naszych losów.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20623650.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Najbliższy tydzień upłynął niemal cały na przygotowaniach.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615034.wav\",\n",
      "    \"duration\": 5.616,\n",
      "    \"text\": \"— A cóż mamy zrobić? — odezwał się.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615036.wav\",\n",
      "    \"duration\": 4.224,\n",
      "    \"text\": \"O matko, włącz klimę bo umrę!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615040.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Na krótką chwilę zapanowała między nami kłopotliwa cisza.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20615043.wav\",\n",
      "    \"duration\": 4.104,\n",
      "    \"text\": \"On załatwił na mnie szybko swoje sprawy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25179943.wav\",\n",
      "    \"duration\": 7.848,\n",
      "    \"text\": \"„Dzięki Bogu, że to nie doszło do skutku.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25179944.wav\",\n",
      "    \"duration\": 3.816,\n",
      "    \"text\": \"A idź ty.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25179945.wav\",\n",
      "    \"duration\": 4.932,\n",
      "    \"text\": \"O czem nie marzyliśmy w tych cielęcych latach młodości!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25179946.wav\",\n",
      "    \"duration\": 4.14,\n",
      "    \"text\": \"Chociażby wiedzieć jak był ubrany?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20602610.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"I czuję tak samo wszystko.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20602612.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"I przy mojej pomocy wyszła na marmurowy cokół nabrzeża.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20602613.wav\",\n",
      "    \"duration\": 4.296,\n",
      "    \"text\": \"Szli obok siebie, nie mówiąc wcale.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20602614.wav\",\n",
      "    \"duration\": 5.016,\n",
      "    \"text\": \"Albo może pan stać, jeśli tak jest wygodniej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621540.wav\",\n",
      "    \"duration\": 5.664,\n",
      "    \"text\": \"Starczyłoby sił na gonitwę, sanki, łyżwy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621541.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"— No, zbliża się czas, by pomyśleć o powrocie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621542.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"I nagle z jego włosów zaczęły się sypać iskry aż na podłogę.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20621543.wav\",\n",
      "    \"duration\": 8.256,\n",
      "    \"text\": \"Rozumiem — odpowiedział Podlasiak i z dumnym poczuciem rozbudzonej niejasno nadziei spojrzał na wyrwany kędzior.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39597726.wav\",\n",
      "    \"duration\": 3.96,\n",
      "    \"text\": \"O ile pamiętam, ja tylko byłem neutralny.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39597727.wav\",\n",
      "    \"duration\": 3.528,\n",
      "    \"text\": \"Zmiana wspólnej polityki rolnej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39597729.wav\",\n",
      "    \"duration\": 6.408,\n",
      "    \"text\": \"Wiecie co, zgadzamy się na demokrację, ale pod warunkiem, że zagłosujecie właściwie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_39597731.wav\",\n",
      "    \"duration\": 7.56,\n",
      "    \"text\": \"Popieram właściwie wszystkie proponowane przez sprawozdawcę rozwiązania, akcentując dwa\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605721.wav\",\n",
      "    \"duration\": 6.888,\n",
      "    \"text\": \"— Nie cierpię czarnych rzeczy — zawołała Maria.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605727.wav\",\n",
      "    \"duration\": 5.112,\n",
      "    \"text\": \"Chcę umrzeć, leżąc na tobie, tak, właśnie tak.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20605943.wav\",\n",
      "    \"duration\": 3.6,\n",
      "    \"text\": \"Puść to jeszcze raz!\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20606011.wav\",\n",
      "    \"duration\": 4.968,\n",
      "    \"text\": \"Usiedli przodem do wnętrza koła, na złość.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38131672.wav\",\n",
      "    \"duration\": 7.524,\n",
      "    \"text\": \"Unia, za pomocą swoich działań zewnętrznych, powinna się stanowczo włączyć w rozwiązanie tych kwestii\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38131674.wav\",\n",
      "    \"duration\": 5.868,\n",
      "    \"text\": \"Takie samo znaczenie ma przestrzeganie podstawowych zasad integracji europejskiej\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38131675.wav\",\n",
      "    \"duration\": 8.784,\n",
      "    \"text\": \"Po piąte, wiele funduszy hedgingowych jest szczególnie aktywnych na ustrukturalizowanych rynkach kapitałowych\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38131676.wav\",\n",
      "    \"duration\": 3.456,\n",
      "    \"text\": \"Pokażcie mi monetę podatkową\\\"\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40979349.wav\",\n",
      "    \"duration\": 8.496,\n",
      "    \"text\": \"Urząd Wsparcia będzie więc kamieniem węgielnym w gmachu wspólnego systemu azylowego\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40979350.wav\",\n",
      "    \"duration\": 3.168,\n",
      "    \"text\": \"Czyż to mgła?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40979351.wav\",\n",
      "    \"duration\": 8.1,\n",
      "    \"text\": \"Realizacja tego celu wymaga większej przejrzystości pod względem dostarczania informacji obywatelom i przedsiębiorstwom\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_40979353.wav\",\n",
      "    \"duration\": 4.248,\n",
      "    \"text\": \"Gołąb wychodzi na spotkanie węża.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20646663.wav\",\n",
      "    \"duration\": 5.976,\n",
      "    \"text\": \"Przypominał pilota, który dla marynarza jest wcieleniem tego, co zasługuje na najwyższe zaufanie\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20646664.wav\",\n",
      "    \"duration\": 3.096,\n",
      "    \"text\": \"Ale u wuja czekała na niego dobra nowina.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20646665.wav\",\n",
      "    \"duration\": 2.256,\n",
      "    \"text\": \"- Ja panu coś powiem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20646667.wav\",\n",
      "    \"duration\": 2.856,\n",
      "    \"text\": \"No, bo jakże?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639880.wav\",\n",
      "    \"duration\": 4.944,\n",
      "    \"text\": \"Za głośno targowali się z babcią o mycie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639881.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Nie nalegaj, Kazik, dłużej, bo się pogniewamy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639882.wav\",\n",
      "    \"duration\": 7.224,\n",
      "    \"text\": \"Drugi, syn krawca — dziewięcioro małych dzieci — bieda wielka.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20639884.wav\",\n",
      "    \"duration\": 3.024,\n",
      "    \"text\": \"Masz cudowny głos.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20608999.wav\",\n",
      "    \"duration\": 5.304,\n",
      "    \"text\": \"Nie był na pogrzebie i nie pokazał się trzy dni w domu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609001.wav\",\n",
      "    \"duration\": 4.056,\n",
      "    \"text\": \"Wasze królewskie mości, jeszcze nie koniec.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609009.wav\",\n",
      "    \"duration\": 4.176,\n",
      "    \"text\": \"Los czyli nie przychodzi ku nam mimo naszej woli?\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20609015.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"I wy daje się, że już nigdy nie można się będzie stamtąd wydobyć.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25259151.wav\",\n",
      "    \"duration\": 6.336,\n",
      "    \"text\": \"To gwałt ze strony kapitalistów i nie puszczę tego płazem.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25259153.wav\",\n",
      "    \"duration\": 4.464,\n",
      "    \"text\": \"W jednej chwili powziąłem postanowienie.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25259155.wav\",\n",
      "    \"duration\": 4.752,\n",
      "    \"text\": \"Nigdy przedtem nie widziałem w nich tego wyrazu.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_25259156.wav\",\n",
      "    \"duration\": 4.572,\n",
      "    \"text\": \"Dwudziesty pierwszy wiek przyniósł wielkie zmiany.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38372804.wav\",\n",
      "    \"duration\": 4.716,\n",
      "    \"text\": \"Również w tym ustawodawstwie są luki\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38372806.wav\",\n",
      "    \"duration\": 4.968,\n",
      "    \"text\": \"Jako jej obywatel pragnę skomentować kwestię rozszerzenia strefy Schengen\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38372807.wav\",\n",
      "    \"duration\": 5.94,\n",
      "    \"text\": \"Wokulski wyrywa się i znika w bramie kamienicy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_38372809.wav\",\n",
      "    \"duration\": 3.24,\n",
      "    \"text\": \"Jaki jest tego sens?\\t\\t2\\t0\\t\\t\\t\\t\\tpl\\t\\nc827dcb7152ae49481e755897da948931d700fd2d4fadee1e601dc2fe3e5c4e01c55c4b0696fc5ec11aa5259e2612cd95abb5f1059bc8f368e7d903ee476a8df\\tcommon_voice_pl_20643688.mp3\\tce0e5678482b3e0965ae33a23f2a680372a82715dd3a472a696f0b82ab753c11\\tWyglądali wspaniale w czerwonym mroku sypialni.\\t\\t2\\t0\\t\\t\\t\\t\\tpl\\t\\nc827dcb7152ae49481e755897da948931d700fd2d4fadee1e601dc2fe3e5c4e01c55c4b0696fc5ec11aa5259e2612cd95abb5f1059bc8f368e7d903ee476a8df\\tcommon_voice_pl_20643690.mp3\\tf2619b96fd5b6172f4ab25cc25ab619198430e1821e75975cfbdf355981bfa1d\\tSłyszałem, że grasz na harmonijce?\\t\\t2\\t1\\t\\t\\t\\t\\tpl\\t\\nc827dcb7152ae49481e755897da948931d700fd2d4fadee1e601dc2fe3e5c4e01c55c4b0696fc5ec11aa5259e2612cd95abb5f1059bc8f368e7d903ee476a8df\\tcommon_voice_pl_20643691.mp3\\tf8165da2bdbfc6559a8ba2a0b3a69fc5c1255cf9ea90329ad28d62edbe9ffbec\\tByłem jeszcze wówczas dębem, przykutym do miejsca i do własnego milczenia.\\t\\t2\\t0\\t\\t\\t\\t\\tpl\\t\\nc827dcb7152ae49481e755897da948931d700fd2d4fadee1e601dc2fe3e5c4e01c55c4b0696fc5ec11aa5259e2612cd95abb5f1059bc8f368e7d903ee476a8df\\tcommon_voice_pl_20643692.mp3\\tf152523f3bfbe775d6e9e5e72ae50b821f4e7363c3445d44c571392c97be9fcd\\t— Na Wyspę Cmentarną? — zapytałem, zajmując obok niej miejsce w gondoli.\\t\\t2\\t0\\t\\t\\t\\t\\tpl\\t\\nca7f0e621f70af63224a0fd31e6c0458cdfe2f51f6d0aad1e134281c1b3b9e86616ba047f77d4ef912d303496b79f5cb476e4c9129b7712c9af768958dfd69b2\\tcommon_voice_pl_20606176.mp3\\t617fa104a10e9c72c4fd7a68199c49f438147c5885dc7f30a212c46067a062c6\\tByła to ciężka puszka z lanego żelaza.\\t\\t5\\t4\\t\\t\\t\\t\\tpl\\t\\nca7f0e621f70af63224a0fd31e6c0458cdfe2f51f6d0aad1e134281c1b3b9e86616ba047f77d4ef912d303496b79f5cb476e4c9129b7712c9af768958dfd69b2\\tcommon_voice_pl_20606251.mp3\\t7ad55e4da15cecd2d44307501dde5b867e9514507ee63cd4e551fed23346b96e\\tPodskoczył na jednym korzeniu, na drugim.\\t\\t2\\t0\\t\\t\\t\\t\\tpl\\t\\nca7f0e621f70af63224a0fd31e6c0458cdfe2f51f6d0aad1e134281c1b3b9e86616ba047f77d4ef912d303496b79f5cb476e4c9129b7712c9af768958dfd69b2\\tcommon_voice_pl_20606257.mp3\\t80cb8d53ee5c5c097b06194ee2f08b1ffd0a8ba82040de7b5a6808f4bc7dfc25\\tJakże mu było na imię? — spytał ciekawie jednoręki.\\t\\t4\\t2\\t\\t\\t\\t\\tpl\\t\\nca7f0e621f70af63224a0fd31e6c0458cdfe2f51f6d0aad1e134281c1b3b9e86616ba047f77d4ef912d303496b79f5cb476e4c9129b7712c9af768958dfd69b2\\tcommon_voice_pl_20606261.mp3\\t654dac64e9f9af646f8d1f79481716050e8d274360b433f3f8cb9710a6c93b84\\tCzyż to nie charakterystyczne, że trupie głowy są zawsze uśmiechnięte?\\t\\t4\\t0\\t\\t\\t\\t\\tpl\\t\\ncb80f9636f0588a401791a36437bada981f9b5f677575e3f0848562ac87e5ee7520a53ceeda1958cc5d20407dedf1cf2aeaa5f7d654ded29367eeb8f18dbc75f\\tcommon_voice_pl_20608328.mp3\\tbaf256ca40ca486f1da7b0e82bb744fb0e74eaf38703ed4f357bec2a9a7182a1\\tDo widzenia, do jutra!\\t\\t3\\t0\\t\\t\\t\\t\\tpl\\t\\ncb80f9636f0588a401791a36437bada981f9b5f677575e3f0848562ac87e5ee7520a53ceeda1958cc5d20407dedf1cf2aeaa5f7d654ded29367eeb8f18dbc75f\\tcommon_voice_pl_20608332.mp3\\t9cfa7edc4ac0375b1485ac2d74e59e27b46b5cc69d4bdbb089bc95d09d4b3f20\\tTe trzy książki czytał na zmianę.\\t\\t3\\t0\\t\\t\\t\\t\\tpl\\t\\ncb80f9636f0588a401791a36437bada981f9b5f677575e3f0848562ac87e5ee7520a53ceeda1958cc5d20407dedf1cf2aeaa5f7d654ded29367eeb8f18dbc75f\\tcommon_voice_pl_20608333.mp3\\tb3681a9110014affe770c310a2744ebca890804c12da5ae0708dc89c401cd8e8\\t— Jeżeli będę mógł, to ja się też będę starał.\\t\\t3\\t0\\t\\t\\t\\t\\tpl\\t\\ncb80f9636f0588a401791a36437bada981f9b5f677575e3f0848562ac87e5ee7520a53ceeda1958cc5d20407dedf1cf2aeaa5f7d654ded29367eeb8f18dbc75f\\tcommon_voice_pl_20608336.mp3\\ta3021b56d1eb511bd73472cf45315a209d14205befbb76ef47384a949307c8b4\\t— Zapewne jedziecie zwiedzić skarbiec królewski? — zapytała nas.\\t\\t4\\t1\\t\\t\\t\\t\\tpl\\t\\ncc03af6b2b09db6786992a5ff9aabb94a80adbcb16f8260129f1403dc9ded99ec17c7c8aa19190afd37e85443ec17802c77f4ee5b3a9cdb08b5ed72417bc2c1d\\tcommon_voice_pl_20613219.mp3\\t4d60751ac65e7