      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20554762.wav\",\n",
      "    \"duration\": 4.896,\n",
      "    \"text\": \"Odpowiedział wolno: - Możesz.\"\n",
