      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20554750.wav\",\n",
      "    \"duration\": 3.696,\n",
      "    \"text\": \"Na pewno widzę się z uśmiechem na twarzy.\"\n",
      "  },\n",
      "  {\n",
      "    \"audio_path\": \"D:\\\\kod\\\\src\\\\asr_pytorch\\\\common_voice_wav\\\\common_voice_pl_20554751.wav\",\n",
      "    \"duration\": 5.136,\n",
      "    \"text\": \"Jak Emil komicznie się zachowywał, gdy mu powiedziałam o łące.\"\n",
